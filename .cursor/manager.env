# Development environment variables for the Kamailio-Intl Manager app.
# These target a local, throwaway PostgreSQL instance — not real secrets.
PLATFORM_PG_HOST=127.0.0.1
PLATFORM_PG_PORT=5432
PLATFORM_PG_DB=kamailio
PLATFORM_PG_USER=kamailio
PLATFORM_PG_PASS=kamailio
PLATFORM_HOMER_DB=homer_config
PLATFORM_SECRET=dev-secret-key
PLATFORM_APP_PORT=5001
