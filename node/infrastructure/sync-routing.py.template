PG_DB   = 'kamailio'
PG_USER = 'kamailio'
PG_PASS = '__KAMAILIO_DB_PASS__'
THIS_NODE_IP = '__NODE_IP__'
# Self-hash version fingerprint -- read and hash this script's own
# file contents at startup, so every sync log line can report exactly
# which version actually ran, with zero manual version-bumping
# discipline required (unlike a hardcoded version string, this can
# never drift out of sync with the code it's describing). Falls back
# to "unknown" rather than crashing if __file__ is unavailable or
# unreadable for any reason -- this is a diagnostic nicety, not
# something that should ever block a sync from running.
try:
    with open(__file__, 'rb') as _f:
        SCRIPT_VERSION = hashlib.sha256(_f.read()).hexdigest()[:12]
except Exception:
    SCRIPT_VERSION = 'unknown'

SQLITE_PATH = '/etc/kamailio/dbsqlite/kamailio.db'
