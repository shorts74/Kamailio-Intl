#!/usr/bin/env python3
"""
Sync routing tables: PostgreSQL (Kamailio Manager) -> local SQLite
cache (this Kamailio Node).

v3: Routing Profiles, Gateway Groups, and Trunks are ALL node-scoped
now -- there is no more "global" trunk/group/profile concept (v2 had
node_id IS NULL meaning "synced to every node"; that's gone). This
node only ever pulls the rows whose node_id matches its own. DIDs and
routing rules are scoped transitively via routing_profile_id, which
is itself node-scoped.

Also syncs Domains: only domains actually enabled on one of this
node's SIP Profiles get synced down (same "sync only what's
referenced" principle already used for rate tables), and only LOCAL
domains have real subscriber credentials -- PROXY domains have no
subscribers at all; their calls route via a primary/secondary trunk
pair instead (see platform_domains.domain_type), not a REGISTER-relay
mechanism.

Supports incremental application via --incremental (reads
platform_sync_log since this node's last watermark; falls back to a
full rebuild automatically if the watermark is missing or stale).

KNOWN GAP, being closed: the local sip_profile_domains, sip_listeners,
domain_reject_info, and node_fallback_reject tables are synced by this
script; the kamailio.cfg REGISTER route that uses them (checking
which SIP Profile received a REGISTER via $Ri:$Rp, rejecting with the
right code/reason if the target domain isn't enabled there) is being
added -- see route[REGISTER] in kamailio.cfg.template.
"""
import sys
import os
import re
import fcntl
import shutil
import subprocess
import hashlib
import ipaddress
import logging
import sqlite3
import base64
import time
import socket
try:
    import dns.resolver
    import dns.exception
    DNSPYTHON_AVAILABLE = True
except ImportError:
    # dnspython is only needed for SRV-record resolution, itself only
    # used by trunks with trust_dns_resolved_ip explicitly enabled -- a
    # relatively rare, opt-in case. A missing dnspython install must
    # never crash the entire sync script (every other sync function --
    # trunk identity, ACLs, routing profiles, subscriber_auth, etc --
    # has nothing to do with DNS at all). resolve_trunk_ips() below
    # degrades gracefully to plain A-record resolution via socket.
    # gethostbyname_ex() when this flag is False, the same fallback
    # path it already takes when a hostname simply has no SRV records.
    DNSPYTHON_AVAILABLE = False
    print("WARN: dnspython not installed -- SRV-record resolution for "
          "trust_dns_resolved_ip trunks will fall back to plain A-record "
          "resolution only. Run 'pip3 install dnspython --break-system-packages' "
          "on this node to restore full SRV support.", file=sys.stderr)
import psycopg2
import psycopg2.extras

PG_HOST = '__MANAGER_IP__'
