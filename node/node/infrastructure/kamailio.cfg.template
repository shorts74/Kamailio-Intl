modparam("siptrace", "duplicate_uri", HOMER_HEP)
modparam("siptrace", "hep_mode_on", 1)
modparam("siptrace", "trace_to_database", 0)
modparam("siptrace", "hep_version", 3)
modparam("siptrace", "hep_capture_id", 1)
# Explicit sip_trace() calls (below) capture incoming requests, but
# most reject paths in this config reply via sl_send_reply() --
# stateless, outside the transaction/onreply_route pipeline that
# sip_trace() calls introspect.
#
# Real gap found in production: an earlier comment here claimed
# trace_on=1 alone was sufficient for these stateless replies --
# confirmed FALSE via a live log trace of a real rejected INVITE (403
# Forbidden sent via sl_send_reply()): the log showed `siptrace:
# trace_sl_onreply_out(): trace off...` immediately after the reply
# was built, meaning it was never actually duplicated to Homer
# despite genuinely being sent on the wire. This exact scenario is
# independently documented by a Kamailio core maintainer on the
# sr-users mailing list: local/stateless replies need trace_mode=1
# specifically (trace_on alone does not cover them), AND separately,
# Kamailio can inconsistently pick a different interface than its
# normal SIP listener when sending the HEP duplicate for a locally-
# generated reply -- which silently never reaches heplify even with
# trace_mode=1 set. send_sock_addr pins the duplicate to the same
# socket Kamailio actually listens on, closing that gap too.
#
# ALL SIX of these siptrace modparams are deliberately kept together
# and hardcoded here, NOT split into the modparam catalog -- a second
# real bug found in production this session: putting some of them in
# the catalog-generated late fragment (#!include'd separately from
# duplicate_uri/send_sock_addr, which must stay here since they're
# node-specific addresses) broke Kamailio's own parsing outright --
# mod_init() misfired into attempting a MySQL db_bind_mod() even with
# trace_to_database correctly set to 0. Confirmed via direct
# reproduction: splitting ANY of this module's modparam() calls
# across an #!include boundary triggers it, keeping them all in one
# place (here) does not. Not worth the risk of finding out which
# subset is actually safe to split -- all six stay together.
modparam("siptrace", "trace_on", 1)
modparam("siptrace", "trace_mode", 1)
modparam("siptrace", "send_sock_addr", "sip:__NODE_IP__:5060")

modparam("sqlops", "sqlcon", "ca=>sqlite:///etc/kamailio/dbsqlite/kamailio.db")
# Confirmed default is 32 result containers -- this config's distinct
# sql_query() result names have grown well past that across the
# routing/forwarding/dialplan logic added this session. Raised with
# headroom rather than trimmed tight, since adding one more named
# query shouldn't require revisiting this again.
modparam("sqlops", "results_maxsize", 64)

modparam("auth_db", "db_url", DBURL_SQLITE)
modparam("auth_db", "calculate_ha1", 0)

modparam("uac", "auth_username_avp", "$avp(cred_user)")
modparam("uac", "auth_realm_avp", "$avp(cred_realm)")
modparam("uac", "auth_password_avp", "$avp(cred_passwd)")
modparam("uac", "reg_db_url", DBURL_SQLITE)
modparam("uac", "reg_db_table", "uacreg")
modparam("uac", "reg_contact_addr", "__EIP__:5060")
# reg_timer_interval, reg_retry_interval, and restore_mode all moved
# to the modparam catalog (same defaults as before) -- admin-tunable
