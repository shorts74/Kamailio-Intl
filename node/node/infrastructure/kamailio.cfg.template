#!KAMAILIO
# __FQDN__ -- Kamailio Node (v3: SIP Profiles + modparam catalog)
# Manager: __MANAGER_FQDN__ (__MANAGER_IP__)
# EIP: __EIP__
#
# Global parameters, listen sockets, and modparam values are NOT
# hardcoded here anymore -- they're generated from this node's SIP
# Profiles/listeners and modparam catalog overrides by
# generate_sip_config.py, and included below. This file only ever
# changes on an explicit Apply & Restart, never hot-reloaded --
# listen sockets and modparams are read once at Kamailio startup.
#!include_file "/etc/kamailio/generated-sip-config.cfg"

log_stderror=no
log_facility=LOG_LOCAL0
log_prefix="{$mt $hdr(CSeq) $ci}: "
# 2 (L_INFO) shows the ROUTE_SUMMARY one-line-per-call log by default
# -- Kamailio's own level numbering, not reversed: L_WARN=0, L_NOTICE=1,
# L_INFO=2, L_DBG=3, a message at level N shows once debug>=N. Raise to
# 3 for the detailed step-by-step [profile hop]/[prefix match]/
# [rule manipulation]/[dispatcher] trace lines on top of the summary,
# e.g. temporarily via `kamcmd cfg.set_now_int core debug 3` while
# actively troubleshooting a specific routing problem, then back to 2.
debug=2
fork=yes
sip_warning=no

#!define FLT_ACC 1
#!define FLT_ACCMISSED 2
#!define FLT_SST 3

#!define DBURL_SQLITE "sqlite:///etc/kamailio/dbsqlite/kamailio.db"
#!define DBURL_REDIS_ACC  "redis://:__REDIS_PASS__@127.0.0.1:6379/1"
#!define DBURL_REDIS_DLG  "redis://:__REDIS_PASS__@127.0.0.1:6379/2"
#!define DBURL_REDIS_LOC  "redis://:__REDIS_PASS__@127.0.0.1:6379/3"
# HOMER_HEP must live here, not in the #!include'd fragment below --
# confirmed against a real `kamailio -c`: #!define directives inside
# an included file are NOT recognized the same way as ones in the
# main file (a genuine preprocessor limitation, not a guess -- the
# identical define moved into the fragment produced a real parse
# error; the same line here does not). Since this still needs to
# change per-node without a full reinstall (hep_transport, toggled
# from the UI), generate_sip_config.py patches this exact line in
# place in the already-deployed main kamailio.cfg on every Apply,
# rather than only regenerating the fragment -- see
# patch_homer_hep_define() in that script.
#!define HOMER_HEP "sip:__MANAGER_IP__:9060"

dns_cache_init=yes
dns_cache_negative_ttl=60
dns_cache_min_ttl=30
dns_cache_max_ttl=3600

mpath="/usr/lib/x86_64-linux-gnu/kamailio/modules/"

loadmodule "xhttp.so"
loadmodule "jsonrpcs.so"
loadmodule "kex.so"
loadmodule "corex.so"
loadmodule "tm.so"
loadmodule "tmx.so"
loadmodule "sl.so"
loadmodule "rr.so"
loadmodule "topoh.so"
loadmodule "pv.so"
loadmodule "maxfwd.so"
loadmodule "textops.so"
loadmodule "textopsx.so"
loadmodule "siputils.so"
loadmodule "xlog.so"
loadmodule "sanity.so"
loadmodule "ctl.so"
loadmodule "cfg_rpc.so"
loadmodule "counters.so"
loadmodule "db_sqlite.so"
loadmodule "db_redis.so"
loadmodule "usrloc.so"
loadmodule "nathelper.so"
loadmodule "path.so"
loadmodule "registrar.so"
# outbound.so is optional (separate kamailio-outbound-modules package,
# non-fatal in node-install.sh). generate_sip_config.py emits
# HAVE_OUTBOUND_MODULE only when the .so is actually on disk, so a node
# where that package was unavailable still starts cleanly. RFC 5626
# Outbound is off by default anyway; path.so (add_path()) ships with
# the base package and stays unconditional above.
#!ifdef HAVE_OUTBOUND_MODULE
loadmodule "outbound.so"
#!endif
loadmodule "permissions.so"
loadmodule "dispatcher.so"
loadmodule "lcr.so"
loadmodule "acc.so"
loadmodule "dialog.so"
loadmodule "sst.so"
loadmodule "rtpengine.so"
loadmodule "sdpops.so"
loadmodule "siptrace.so"
loadmodule "sqlops.so"
loadmodule "htable.so"
loadmodule "auth.so"
loadmodule "auth_db.so"
loadmodule "uac.so"
loadmodule "uac_redirect.so"
loadmodule "ipops.so"
loadmodule "snmpstats.so"
loadmodule "pike.so"
loadmodule "pipelimit.so"

# Non-core modparams (dispatcher, siptrace, tm, rr, uac, etc, driven
# by the modparam catalog) MUST be included here -- after every
# loadmodule above -- not up at the top with the early fragment. Real
# bug found in production: combining early+late into one fragment
# included near the top of this file meant Kamailio processed e.g.
# modparam("siptrace", ...) before loadmodule "siptrace.so" had even
# run, and failed at actual startup (`unable to bind database
# module`) despite `kamailio -c` reporting the config as valid -- -c
# does not check this ordering constraint.
#!include_file "/etc/kamailio/generated-sip-config-late.cfg"

# jsonrpcs.pretty_format/transport, tm.failure_reply_mode/fr_timer/
# fr_inv_timer, rr.enable_full_lr/append_fromtag, and maxfwd.max_limit
# all moved to the modparam catalog (same defaults as before) --
# admin-tunable per node now instead of fixed here.

# CONFIRMED via a real test during the v3 build: missed_calls needs
# its OWN db_redis key mapping, as a SEPARATE modparam call -- a
# combined semicolon string across acc+missed_calls produced
# "Failed to create direct entry key, no matching key definition"
# and silently dropped every insert. Without this, missed-call
# records (486/timeout/etc, via db_missed_flag) all overwrote the
# SAME single Redis hash "missed_calls:entry" instead of getting a
# unique per-call key -- meaning every missed call except the most
# recent one was silently lost. This is exactly the data the v3
# stats push script reads, so this bug would have made temp/perm
# failure counts wrong from day one.
modparam("db_redis", "keys", "acc=entry:callid,time&cid:callid")
modparam("db_redis", "keys", "missed_calls=entry:callid,time&cid:callid")
modparam("db_redis", "keys", "acc_cdrs=entry:callid,start_time&cid:callid")
modparam("db_redis", "keys",
  "dialog=entry:hash_entry,hash_id&cid:callid;"
  "dialog_vars=entry:hash_entry,hash_id,dialog_key&dialog:hash_entry,hash_id;"
  "location=entry:ruid&aor:username,domain")

modparam("acc", "db_url", DBURL_REDIS_ACC)
modparam("acc", "log_flag", FLT_ACC)
modparam("acc", "db_flag", FLT_ACC)
modparam("acc", "db_missed_flag", FLT_ACCMISSED)
# Extra fields for db-backed accounting (both "acc" and "missed_calls"
# tables) -- without this, a missed-call record only carries the bare
# fixed set (method/tags/callid/sip_code/sip_reason/time), none of the
# source/number detail needed to make sense of it later. Uses the
# exact same pseudo-variables the existing ROUTE_SUMMARY xlog line
# (No Route Found rejection) already references successfully, so
# these are confirmed available at that point, not a new assumption.
modparam("acc", "db_extra", "node_id=$avp(cdr_node_id);src_descriptor=$var(src_descriptor);original_called=$ru;original_calling=$fu")
# acc.cdr_enable moved to the modparam catalog (same default: 1).
# cdrs_table is NOT optional -- its own default is "" (no DB storage
# for dialog-based CDRs at all), confirmed via direct testing that
# without it CDRs only ever reach syslog, never the acc_cdrs table,
# with no error to indicate why.
modparam("acc", "cdrs_table", "acc_cdrs")
# Dimensional tags (node/profile/trunk/domain/subscriber) use
# $dlg_var(), NOT $avp() -- confirmed via direct testing that $avp()
# values set during INVITE processing are gone by the time BYE is
# processed (separate transaction, separate avp scope), while
# $dlg_var() correctly persists across the whole dialog. Quality
# fields correctly use $avp() instead, since rtpengine_delete()
# populates them fresh within the SAME BYE transaction this CDR write
# reads from (confirmed via Kamailio's own source: the CDR write is
# triggered by cdr_on_end_confirmed, which fires on the *reply* to
# BYE -- i.e., after this script's own BYE-handling logic, including
# rtpengine_delete(), has already run).
modparam("acc", "cdr_extra",
  "callid=$ci;from_tag=$dlg_var(call_from_tag);to_tag=$dlg_var(call_to_tag);"
  "sip_code=$dlg_var(final_sip_code);reply_status=$rs;"
  "node_id=$avp(cdr_node_id);inbound_sip_profile_id=$dlg_var(inbound_sip_profile_id);"
  "outbound_sip_profile_id=$dlg_var(outbound_sip_profile_id);"
  "inbound_trunk_id=$dlg_var(inbound_trunk_id);inbound_domain_id=$dlg_var(inbound_domain_id);"
  "inbound_trunk_name=$dlg_var(inbound_trunk_name);"
  "inbound_subscriber=$dlg_var(inbound_subscriber);"
  "outbound_trunk_id=$dlg_var(outbound_trunk_id);outbound_domain_id=$dlg_var(outbound_domain_id);"
  "outbound_trunk_name=$dlg_var(outbound_trunk_name);"
  "outbound_subscriber=$dlg_var(outbound_subscriber);"
  "original_called=$dlg_var(original_called);original_calling=$dlg_var(original_calling);"
  "effective_called_number=$dlg_var(effective_called_number);"
  "effective_caller_id_number=$dlg_var(effective_caller_id_number);"
  "effective_caller_id_name=$dlg_var(effective_caller_id_name);"
  "negotiated_codec=$dlg_var(negotiated_codec);"
  "mos_min=$avp(mos_min);mos_min_packetloss=$avp(mos_min_packetloss);"
  "mos_min_jitter=$avp(mos_min_jitter);mos_min_roundtrip=$avp(mos_min_roundtrip);"
  "mos_max=$avp(mos_max);mos_max_packetloss=$avp(mos_max_packetloss);"
  "mos_max_jitter=$avp(mos_max_jitter);mos_max_roundtrip=$avp(mos_max_roundtrip);"
  "mos_avg=$avp(mos_avg);mos_avg_packetloss=$avp(mos_avg_packetloss);"
  "mos_avg_jitter=$avp(mos_avg_jitter);mos_avg_roundtrip=$avp(mos_avg_roundtrip);"
  "mos_avg_samples=$avp(mos_avg_samples)")
modparam("acc", "log_extra", "src_ip=$si;dst_uri=$rU;trunk_id=$avp(active_trunk_setid);call_type=$avp(call_type)")

modparam("dialog", "db_url", DBURL_REDIS_DLG)
modparam("dialog", "db_mode", 1)
# Required for sst (Session Timers) below -- its own docs are explicit
# that without this matching dialog's timeout_avp exactly, "the sst
# module will not do anything." Hardcoded together, not admin-tunable
# via the catalog -- an edit to just one side would silently break
# session-timer enforcement.
modparam("dialog", "timeout_avp", "$avp(i:100)")
# Named profile backing per-trunk concurrent-call caps (max_channels)
# -- see route[HANDLE_CALL]'s trunk-selection block and
# route[RELAY]'s cleanup for where this actually gets used.
modparam("dialog", "profiles_with_value", "concurrent_calls")
# sst_flag hardcoded (like FLT_ACC/FLT_ACCMISSED) -- must not collide
# with another flag in use, same reasoning as excluding it from the
# modparam catalog. timeout_avp must exactly match dialog's own,
# immediately above -- see that modparam's comment for why.
modparam("sst", "sst_flag", FLT_SST)
modparam("sst", "timeout_avp", "$avp(i:100)")

# Topology hiding -- confirmed live this session (real two-party
# INVITE/200/ACK/BYE cycle, both directions) that this module handles
# selective per-destination exclusion cleanly, unlike the newer topos
# module's documented BYE-fails-with-404 issue (topos needs a DB
# lookup to decode; this module encodes/decodes directly in the
# headers themselves, nothing to miss). mask_key is a genuine
# per-node secret (generated once, persisted across re-deploys --
# see step_deploy_kamailio_cfg in node-install.sh); mask_ip is never
# actually routed to, it just needs to not collide with a real client
# address in a masked Via/Contact. mask_callid left off (module's own
# documented default and caution: some SIP extensions embed Call-ID
# in the message body, which masking would break unless those
# extensions are explicitly accounted for).
modparam("topoh", "mask_key", "__TOPOH_MASK_KEY__")
modparam("topoh", "mask_ip", "127.0.0.8")
modparam("topoh", "mask_callid", 0)
modparam("topoh", "sanity_checks", 1)
modparam("usrloc", "db_url", DBURL_REDIS_LOC)
modparam("usrloc", "db_mode", 2)
# Cross-tenant safety -- confirmed real bug, not a hypothetical:
# use_domain defaults to 0 (disabled) in Kamailio itself. With it
# disabled, usrloc keys registrations by username ALONE, completely
# ignoring domain -- meaning two different tenants with a subscriber
# sharing the same username (e.g. "alice" registered under two
# different domains) would collide in the same AOR, risking a call
# intended for one tenant's user reaching a different tenant's phone
# instead. This platform is explicitly multi-tenant (multiple domains
# per node), so this has to be on. $rU is already constructed as
# "username@domain" everywhere lookup("location")/save() are called
# in this file (confirmed via a full grep), so no other routing logic
# needs to change for this to take effect correctly.
modparam("usrloc", "use_domain", 1)
# nat_bflag=1: tells usrloc which branch flag (set in route[REGISTER]
# via setbflag() when nat_uac_test() detects NAT) to persist alongside
# this contact's binding, so nathelper's own natping timer -- which
# reads this same flag back via its own sipping_bflag modparam,
# confirmed matching by design -- knows which registered contacts
# actually need keepalive pings, without re-running NAT detection
# itself. No other bflag is in use anywhere in this file (confirmed
# via a full grep), so 1 has no collision risk.
modparam("usrloc", "nat_bflag", 1)
# registrar.method_filtering moved to the modparam catalog (same
# default: 1). max_expires also already in the catalog (default 3600).

modparam("permissions", "db_url", DBURL_SQLITE)
modparam("permissions", "db_mode", 1)

modparam("dispatcher", "db_url", DBURL_SQLITE)
# Real bug found via live testing this session: $avp(ds_attrs) is
# never actually populated by ds_select_dst(), even after adding the
# attrs_pvname modparam here (confirmed accepted without a parse
# error, confirmed NOT to fix the underlying issue via a direct live
# trace showing the AVP stayed <null>). Root cause not fully resolved
# -- every place in this file that needs a trunk's attrs (strip/
# prepend/trace/record/sip_profile/outbound_proxy/max_channels/
# fax_mode) now queries dispatcher.attrs directly via SQL instead
# (see route[HANDLE_CALL]'s trunk branch), which is confirmed working
# live. Not setting attrs_pvname at all here, since it demonstrably
# doesn't do anything in this Kamailio build and would misleadingly
# suggest a working fix to a future reader.
# ds_ping_interval, ds_probing_mode, ds_probing_threshold,
# ds_ping_reply_codes, ds_ping_method, and ds_timer_mode all moved to
# the modparam catalog (same defaults as before) -- admin-tunable per
# node now instead of fixed here.

# Backs the lcr engine type -- column names in the local schema
# already match this module's own defaults, so no column-name
# overrides needed here, only connection + the AVPs the module
# requires. lcr_count set to 1000 -- confirmed via direct testing
# that this parameter drives real SHM allocation (not just a logical
# bound); an earlier, much higher value caused a real startup
# failure ("could not allocate shared memory... for rules hash
# table") until either SHM was increased or this was lowered. 1000
# is still far beyond any realistic routing_profile count.
modparam("lcr", "db_url", DBURL_SQLITE)
modparam("lcr", "lcr_count", 1000)
modparam("lcr", "gw_uri_avp", "$avp(lcr_gwuri)")
modparam("lcr", "ruri_user_avp", "$avp(lcr_ruriuser)")
modparam("lcr", "flags_avp", "$avp(lcr_flags)")
# Confirmed via direct testing against the real LCR module: tag_avp
# correctly reflects lcr_gw.tag after next_gw() succeeds. Populated
# with the trunk's real name in sync-routing.py -- gives
# ROUTE_SUMMARY an actual trunk name for the LCR routing path instead
# of a raw destination URI (a real gap found and fixed this session:
# the dispatcher-based routing paths already showed a real trunk
# name, but the LCR path never did, since next_gw() resolves gateways
# entirely differently -- no dispatcher involvement at all).
modparam("lcr", "tag_avp", "$avp(lcr_gwtag)")
# Required if ping_interval/defunct_capability are ever turned on via
# the modparam catalog -- structural AVP wiring, not a tunable value
# itself, same reasoning as gw_uri_avp/ruri_user_avp above.
modparam("lcr", "lcr_id_avp", "$avp(lcr_id)")
modparam("lcr", "defunct_gw_avp", "$avp(lcr_defunct_gw)")

# Backs the subscriber_lookup routing engine -- number-to-user@domain
# resolution at scale, confirmed via research this session as O(1)
# regardless of row count (unlike SQL LIKE/prefix matching), the
# actual reason this engine exists rather than reusing route_prefixes'
# dest_subscriber_id path. dbtable loaded at startup only -- new/
# changed rows require kamcmd htable.reload, called by sync-routing.py
# after every sync, same pattern already proven for uac.reg_reload/
# dispatcher.reload this session.
modparam("htable", "db_url", DBURL_SQLITE)
modparam("htable", "htable", "subscriber_numbers=>size=10;dbtable=subscriber_numbers")
modparam("htable", "htable", "trunk_numbers=>size=10;dbtable=trunk_numbers")
# Backs route[REGISTER]'s fast path -- see subscriber_auth table
# comment in node-install.sh for full design + live-measured
# performance numbers. size=10 (1024 buckets) keeps average chain
# length short well into the thousands of subscribers -- measured
# this session at ~153.6 bytes/entry in shared memory, so even
# 50,000 subscribers costs under 8MB regardless of bucket count.
modparam("htable", "htable", "subscriber_auth=>size=10;dbtable=subscriber_auth")
# Trust/identity redesign: Call 2, the IP-only trunk identification
# table -- reached only when Call 1 (subscriber_auth) finds no match
# at all. Primarily a sync-time config mirror like every other htable
# here, but ALSO receives one additional, live, event-driven write:
# the OPTIONS-ping handler below (onreply_route[LOCAL_REQUEST_REPLY])
# refreshes a DNS-hostname-based trunk's entry here whenever its
# resolved IP changes, keeping this table correct between sync cycles
# for trunks that opted into DNS-based trust.
modparam("htable", "htable", "trunk_ip_identity=>size=10;dbtable=trunk_ip_identity")
modparam("htable", "htable", "routing_profile_data=>size=8;dbtable=routing_profile_data")
# Consolidated routing_profiles metadata -- item 15 of the SQL-to-
# htable optimization pass. Replaces 5 separate id-keyed SQL queries
# (engine_type, name, fallback_profile_id, reject_code/reject_reason,
# blocklist-attachment config) with one lookup per profile-id
# resolution. Named distinctly from routing_profile_data above (that
# one holds bridge/arithmetic engine rule data -- a genuinely
# different thing that happens to share a similar name).
modparam("htable", "htable", "routing_profile_meta=>size=8;dbtable=routing_profile_meta")
modparam("htable", "htable", "blocklist_entries=>size=10;dbtable=blocklist_entries")
# Backs the REGISTER miss-path -- ip:port -> that listener's own
# unbound_domain reject settings. One row per listener, so size=4
# (16 buckets) is plenty regardless of subscriber count.
modparam("htable", "htable", "listener_settings=>size=4;dbtable=listener_settings")
# ip:port -> sip_profile_id -- item 15 of the SQL-to-htable
# optimization pass. Replaces the per-message SQL lookup used to
# determine which SIP Profile a message arrived on (route[INVITE]'s
# own inbound_sip_profile_id resolution). Same small, one-row-per-
# listener scale as listener_settings above.
modparam("htable", "htable", "sip_listeners=>size=4;dbtable=sip_listeners_ht")
# sip_profile_id:domain_name -> routing_profile_id|media_profile_id --
# item 15 of the SQL-to-htable optimization pass. New, separate table
# (not a repurpose of the existing sip_profile_domains) per this
# platform's own add-only migration pattern.
modparam("htable", "htable", "sip_profile_domains=>size=8;dbtable=sip_profile_domains_ht")
# setid -> dispatch algorithm -- item 15 of the SQL-to-htable
# optimization pass. New, separate table (not a repurpose of the
# existing dispatcher_setid_alg, which the dispatcher module's own
# ds_reload_dst() reload path also touches -- see reload_summary
# in sync-routing.py).
modparam("htable", "htable", "dispatcher_setid_alg=>size=6;dbtable=dispatcher_setid_alg_ht")
# setid -> attrs (any representative row for that setid, matching the
# original SQL queries' own LIMIT 1 semantics) -- item 15 of the
# SQL-to-htable optimization pass.
modparam("htable", "htable", "dispatcher_attrs=>size=6;dbtable=dispatcher_attrs_ht")
# setid:destination -> attrs|description -- the composite-key case,
# where a specific dispatcher group member (not just "any" member of
# that setid) needs to be distinguished.
modparam("htable", "htable", "dispatcher_dest_attrs=>size=8;dbtable=dispatcher_dest_attrs_ht")
# id -> media_mode|codec_order|combination_policy|nat_mode|
# late_negotiation|dtmf_mode -- item 15 of the SQL-to-htable
# optimization pass. One unified value shape serves both the inbound
# (all 6 fields) and outbound (3-field subset) media-profile lookups.
modparam("htable", "htable", "media_profiles=>size=8;dbtable=media_profiles_ht")
# trunk-uuid -> username|password|realm|trust_provider_realm -- item
# 15 of the SQL-to-htable optimization pass. Rarest of the simple
# conversions -- only reached when trust_provider_realm=0 (strict
# validation, non-default). New, separate table -- the uac module's
# own native credentials table is untouched, still consumed
# internally by uac_auth() the same way it always has been.
modparam("htable", "htable", "trunk_credentials=>size=6;dbtable=trunk_credentials_ht")
# duid (trunk_id) -> setid|attrs|description -- item 15 of the
# SQL-to-htable optimization pass. Correction to this design's
# original "fold into Entry B" plan, caught during implementation:
# the attrs data here carries 8 separate fields (topoh/caller-ID
# settings) in a differently-shaped, semicolon-delimited format,
# genuinely distinct from Entry B's own pipe-delimited value --
# merging them would be a much larger, riskier change than intended.
# A new, separate, duid-keyed htable achieves the same SQL
# elimination without that risk.
modparam("htable", "htable", "trunk_dispatcher_attrs=>size=8;dbtable=trunk_dispatcher_attrs_ht")
# username@domain -> forwarding cluster data (26 fields) -- item 15 of
# the SQL-to-htable optimization pass, the largest remaining piece.
# Consolidates 12 of the original SQL queries: 3 forward-type gates
# (unconditional/unavailable/busy) + 4 forward-type rows (the three
# gated types plus no_answer, which has no separate domain-level gate
# of its own) + diversion_header_enabled (pre-resolved) + user_
# unreachable_code/text. Deliberately scoped to exclude the separate,
# much larger "rp" query (ring_policy/trace/record/outbound-
# presentation settings, 16 columns, different purpose) -- left as
# its own, distinct future piece rather than bundled in here.
modparam("htable", "htable", "subscriber_forwarding_meta=>size=10;dbtable=subscriber_forwarding_meta_ht")
# username@domain -> ring_policy/trace/record/outbound-presentation
# settings (16 fields) -- item 15's last significant remaining piece,
# previously deferred given its size. Semicolon-separated at the outer
# level (not pipe) since 2 of the 16 fields (custom_hdrs/strip_hdrs)
# are themselves variable-length pipe-delimited lists -- nesting the
# same separator inside itself would be ambiguous to parse back apart.
modparam("htable", "htable", "subscriber_outbound_meta=>size=10;dbtable=subscriber_outbound_meta_ht")
modparam("htable", "htable", "response_reasons=>size=4;dbtable=response_reasons")
# Startup build-ID log line -- CONFIG_BUILD_ID is generated fresh by
# generate_sip_config.py on every Apply & Restart (UTC timestamp +
# node_id). Confirmed against the real binary: event_route[htable:
# mod-init] fires exactly once, at startup. Directly addresses a real,
# repeated problem this session -- confirming whether a given fix
# actually made it into the config running on a live node required
# manually grepping the whole file for specific code patterns; this
# makes it a single grep for "CONFIG-BUILD-ID" in the startup log
# instead.
#!ifdef CONFIG_BUILD_ID
event_route[htable:mod-init] {
    xlog("L_INFO", "CONFIG-BUILD-ID: " + CONFIG_BUILD_ID + "\n");
}
#!endif
# Disabled in favor of the manual, per-node-overridable equivalent
# sent early in request_route below (see the 100_trying response
# reason) -- hardcoded rather than exposed as a regular modparam
# catalog entry, since toggling this back on would conflict with that
# manual send rather than being an independent, safely-tunable knob.
modparam("tm", "auto_inv_100", 0)

modparam("rtpengine", "rtpengine_sock", "udp:127.0.0.1:22222")
# Quality pseudo-variables -- auto-populated by rtpengine_delete()
# (already called at BYE handling below) once the call/branch is
# deleted. Confirmed via the module's own complete parameter list
# that this min/max/average set (each with packetloss/jitter/
# roundtrip) is the full ceiling of what's exposed to script -- no
# RTCP-XR-specific fields (R-factor, burst/gap loss) are available
# here; those exist only in rtpengine's native Homer feed.
