# snmpstats -- confirmed present in kamailio-snmpstats-modules (5.7.4+
# packaging). snmpgetPath is the confirmed-correct modparam (verified
# via real module load in this build's testing -- an earlier guess of
# "PidFile" was wrong and has been corrected). Loading the module is
# harmless even if SNMP is disabled in node.conf; it only becomes
# active once snmpd itself is configured (see step_snmp).
modparam("snmpstats", "snmpgetPath", "/usr/bin/snmpget")
# NOTE: even with a correct snmpgetPath and snmpget installed, this
# module may still log a non-fatal warning about
# spawn_sysUpTime_child() in some environments, causing only the
# kamailioSIPServiceStartTime stat to default to zero -- confirmed
# during this build's testing to NOT affect Kamailio startup, core
# call routing, or any other functionality. If you need that
# specific stat working, investigate snmpd's own permissions/config
# on your target system; everything else works normally.

# pike -- per-source-IP flood protection. Tuned generously for
# legitimate multi-channel trunk traffic (a busy carrier trunk can
# legitimately send many requests/sec) while still catching genuine
# floods/scanning bursts. Confirmed functionally working during this
# build's testing (a burst of 25 rapid requests from one source was
# correctly rate-limited partway through, normal traffic under the
# threshold passed through untouched). Moved to the modparam catalog
# (same tested defaults: sampling_time_unit=2, reqs_density_per_unit=
# 50, remove_latency=4) -- admin-tunable per node now instead of
# fixed here; tune reqs_density_per_unit upward if you have a single
# very-high-volume trunk hitting false positives.

####### Routing Logic ###############################################

request_route {
    $var(to_header_applied) = 0;
    if (!sanity_check("1511", "7")) {
        $var(reject_reason) = "failed sanity_check() -- malformed or invalid SIP message";
        route(LOG_REJECTED);
        exit;
    }
    if (!pike_check_req()) {
        xlog("L_WARN", "PIKE flood protection blocked $si -- request rate exceeded threshold\n");
        exit;
    }
    if (!mf_process_maxfwd_header("10")) {
        $var(reject_reason) = "Max-Forwards exceeded";
        route(LOG_REJECTED);
        $var(rr_key) = "483_max_forwards_exceeded"; $var(rr_default) = "Too Many Hops"; route(RESP_REASON);
        sl_send_reply("483", "$var(rr_effective)");
        exit;
    }

    # Manual 100 Trying: NOT sent here anymore. It used to fire for
    # every INVITE at this point -- before ANY trust or per-source
    # rate check -- which let a spoofed-INVITE flood force
    # transaction-state allocation (t_newtran) throttled only by PIKE,
    # on builds without the #!ifdef-gated global rate limit. Moved to
    # route[INVITE], immediately before route(HANDLE_CALL), i.e. only
    # once the source is confirmed legitimate (Call 1 identity, Call 2
    # ACL/FQDN, or local-domain subscriber -- an untrusted source
    # 403s or hits the unproven-source rate gate and exits well before
    # reaching that point, never allocating a transaction). A
    # legitimately challenged call (trunk_realm / subscriber digest)
    # also correctly gets its 401 without a preceding 100, which is
    # the right behavior. See the placement before route(HANDLE_CALL).

    # Route Plan Test tool -- a synthetic request carrying this header
    # never actually dispatches anywhere (see route[ROUTE_TEST] and
    # the test-mode checks inside route[HANDLE_CALL]); it exists
    # purely to run the real routing decision logic and report back
    # what would have happened. Deliberately checked before rate
    # limiting/sip_trace() below -- this is internal diagnostic
    # traffic, not real call volume.
    #
    # Loopback-only, confirmed against route-test.py's actual
    # implementation: legitimate test traffic is always generated
    # locally on this node (bound to and sent from 127.0.0.1,
    # --listen-ip defaults to 127.0.0.1) via SSH from the Manager,
    # never over the public network at all. Without this check, any
    # unauthenticated external message carrying this header could
    # trigger the full routing-decision logic -- multiple SQL
    # queries -- completely bypassing every trust/rate-limiting
    # mechanism elsewhere in this file, since this check runs before
    # any of them. This isn't a new restriction, it's a correctness
    # fix matching how the tool was always actually meant to be used.
    if ($hdr(X-Route-Test) == "1" && $si == "127.0.0.1") {
        route(ROUTE_TEST);
        exit;
    }

    # Node identity -- static per node, always known, feeds the CDR
    # (cdr_extra references $avp(cdr_node_id)). Confirmed this session:
    # no X-Node-Id header needed on the wire at all -- HEP's own
    # hep_capture_id modparam already tags every traced packet at the
    # protocol level, independent of anything in the SIP message
    # itself. The header used to be sent on every single call for no
    # actual reason.
    $avp(cdr_node_id) = "__NODE_ID__";

    #!ifdef GLOBAL_RATE_LIMIT_NAME
    if (!pl_check(GLOBAL_RATE_LIMIT_NAME, GLOBAL_RATE_LIMIT_ALGO, GLOBAL_RATE_LIMIT_VALUE)) {
        xlog("L_INFO", "$ci: rate limit exceeded (pipe " + GLOBAL_RATE_LIMIT_NAME + ", scope global)\n");
        $var(rr_key) = "503_rate_limit_exceeded"; $var(rr_default) = "Rate Limit Exceeded"; route(RESP_REASON);
        sl_send_reply("503", "$var(rr_effective)");
        exit;
    }
    #!endif

    sip_trace();
    setflag(FLT_ACC);

    if (is_method("CANCEL")) {
        if (t_check_trans()) { t_relay(); }
        exit;
    }
    if (is_method("ACK")) {
        if (t_check_trans()) {
            # Hop-by-hop ACK for a non-2xx final response (401/407/etc)
            # -- still matches the original INVITE's own client
            # transaction in tm, handled here directly.
            t_relay();
            exit;
        }
        # No matching transaction -- the RFC 3261-correct case for a
        # 2xx ACK (end-to-end, never part of the original transaction,
        # which already terminated on sending/receiving the 2xx). Do
        # NOT exit here -- fall through to the in-dialog/loose-routing
        # logic below, which is what actually relays it onward. Real
        # bug found and fixed this session: an unconditional exit here
        # previously discarded every 2xx ACK outright, so the far end
        # never got ACKed and kept retransmitting its 200 OK.
    }
    if (has_totag()) {
        if (loose_route()) {
            # Real PII leak found and fixed this session: the original
            # caller's display name (e.g. "Gurbir") was leaking through
            # on in-dialog requests relayed toward the trunk, even
            # though the original INVITE correctly stripped it via
            # uac_replace_from() -- confirmed live via a real trace: the
            # ACK to a 2xx showed the correctly-substituted From URI but
            # the caller's own, un-stripped display name. uac module's
            # automatic from-restore mechanism reapplies the substituted
            # URI correctly for subsequent same-direction requests, but
            # doesn't reliably carry the display name along with it.
            # Fixed by explicitly re-setting $fn to match what the
            # original INVITE used, but ONLY when this message is
            # actually showing the substituted identity (i.e. going the
            # same direction as the original INVITE, toward the trunk).
            # Checked via comparing $fU against the persisted dlg_var,
            # not $rdir()/is_direction() -- this platform doesn't
            # currently set rr's append_fromtag (required for $rdir()
            # to return correct values), and that mechanism has a
            # documented history of misbehaving in some configurations
            # (kamailio/kamailio#1729) -- so this uses data already
            # established for this exact purpose instead. A message
            # going the OTHER direction (e.g. a BYE from the trunk back
            # to the caller) shows the trunk's own identity in $fU,
            # which won't match, so it's correctly left untouched.
            # Applies uniformly to every in-dialog method here, not
            # just ACK -- the same leak class could affect a caller-
            # side re-INVITE/UPDATE too.
            if ($fU == $dlg_var(effective_caller_id_number)) {
                $fn = $dlg_var(effective_caller_id_name);
            }
            if (is_method("BYE")) {
                setflag(FLT_ACC); setflag(FLT_ACCMISSED);
                # Only release if this dialog actually anchored media in
                # the first place -- a Bypass-mode call never called
                # rtpengine_offer() at all, so there's nothing to
                # release, and calling delete() on a call rtpengine has
                # no record of is just noise. $dlg_var persists across
                # every message in this dialog, set once in
                # APPLY_MEDIA_PROFILE during the original INVITE.
                if ($dlg_var(media_anchored) == "1") {
                    rtpengine_delete();
                }
            } else if (is_method("INVITE|UPDATE") && $dlg_var(media_anchored) == "1" && has_body("application/sdp")) {
                # Real gap fixed here: re-INVITE/UPDATE used to relay
                # straight through route(RELAY) below with ZERO
                # rtpengine involvement -- meaning a mid-call hold/
                # resume, codec renegotiation, or ICE restart relayed
                # the caller's own, real media IP/port through
                # unchanged instead of rtpengine's substituted one,
                # since rtpengine's original SDP rewrite from the
                # initial offer never got reapplied to the new SDP.
                # Reuses $dlg_var(re_flags), persisted verbatim from
                # the initial offer (APPLY_MEDIA_PROFILE/the offer call
                # site above) -- deliberately NOT re-running the mode-
                # combination/codec-compatibility/T.38 decision logic,
                # since that's specifically about the initial
                # negotiation and re-running it mid-call could produce
                # a different result than what this dialog actually
                # established (e.g. if a media profile changed in the
                # DB after the call was already set up).
                #
                # Codec policy DOES hold mid-call though: the same
                # allowlist established at setup (media_scrub_list,
                # persisted by APPLY_MEDIA_PROFILE per-mode) is
                # re-applied to the new offer's SDP -- without this, a
                # mid-call renegotiation could reintroduce codecs the
                # dialog's proxy-mode policy already excluded. Guarded
                # for T.38: a fax re-INVITE (m=image/udptl) replaces
                # the audio line entirely -- scrubbing it by audio
                # codec names could mangle or empty it; rtpengine's
                # own udptl/T.38 handling via the established re_flags
                # is the correct path for that body, untouched.
                if ($dlg_var(media_scrub_list) != $null && $dlg_var(media_scrub_list) != "" && !($rb =~ "m=image")) {
                    sdp_keep_codecs_by_name("$dlg_var(media_scrub_list)");
                }
                if (!rtpengine_offer("$dlg_var(re_flags)")) {
                    xlog("L_ERR", "$ci: mid-call rtpengine_offer failed ($rm)\n");
                }
            } else if (is_method("INVITE|UPDATE") && $dlg_var(media_anchored) == "1" && !has_body("application/sdp")) {
                # Offerless re-INVITE/UPDATE -- the peer is being asked
                # to make the offer, which arrives in its 2xx, with the
                # answer in the subsequent ACK. Tracked so the reply
                # handler knows that 2xx body is an OFFER (rtpengine_
                # offer), not an answer -- previously this fell through
                # silently and the reply handler ran rtpengine_answer()
                # on it, a genuine offer/answer direction mismatch.
                $dlg_var(pending_peer_offer) = "1";
            } else if (is_method("ACK") && has_body("application/sdp") && $dlg_var(pending_peer_offer) == "1" && $dlg_var(media_anchored) == "1") {
                # The answer leg of late negotiation / an offerless
                # re-INVITE: the peer's offer was processed from the
                # 2xx (see the reply handler); this ACK's SDP is the
                # caller's answer, and completes the pair. Previously
                # relayed with no rtpengine involvement at all.
                rtpengine_answer("$dlg_var(re_flags)");
                $dlg_var(pending_peer_offer) = "0";
            }
            route(RELAY);
            exit;
        } else {
            if (is_method("ACK")) { route(RELAY); exit; }
            $var(reject_reason) = "in-dialog request, no matching dialog found (loose_route failed)";
            route(LOG_REJECTED);
            # silent_drop_unmatched_dialog cascade (Tiers 1-3: catalog
            # default -> node override -> SIP-Profile override,
            # resolved once at sync time into listener_settings'
            # 4th field, same htable/key the REGISTER miss-path
            # already uses). Confirmed fingerprinting leak this
            # session: an unmatched in-dialog probe used to
            # unconditionally get a 404 back, confirming a live SIP
            # server is present -- CANCEL/ACK already correctly
            # silent-drop in this same situation, this closes the gap
            # for everything else (BYE, or any request carrying a
            # To-tag). A missing listener_settings entry (sync gap)
            # fails toward the safer default (silent), not the
            # leakier one.
            $var(sd_silent) = 1;
            if ($sht(listener_settings=>$Ri:$Rp) != $null) {
                $var(sd_ls) = $sht(listener_settings=>$Ri:$Rp);
                $var(sd_bit) = $(var(sd_ls){s.select,3,|});
                if ($var(sd_bit) == "0") { $var(sd_silent) = 0; }
            }
            if ($var(sd_silent) == 1) {
                exit;
            }
            $var(rr_key) = "404_subscriber_not_found"; $var(rr_default) = "Not here"; route(RESP_REASON);
            sl_send_reply("404", "$var(rr_effective)");
            exit;
        }
    }
    if (!is_method("REGISTER|MESSAGE")) { record_route(); }

    if      (is_method("INVITE"))   { route(INVITE); }
    else if (is_method("REGISTER")) { route(REGISTER); }
    else if (is_method("OPTIONS"))  { sl_send_reply("200", "OK"); exit; }
    else { $var(rr_key) = "405_method_not_allowed"; $var(rr_default) = "Method Not Allowed"; route(RESP_REASON); sl_send_reply("405", "$var(rr_effective)"); exit; }
}

# route[CHECK_INBOUND_POLICY] removed -- see the comment at its
# former call site in route[INVITE] for why (retired by Call 1's
# trunk_realm mechanism, not just relocated).

# Single, reusable INFO-level log point for every place an incoming
# REGISTER/INVITE/OPTIONS gets dropped or rejected, per explicit
# request. Caller sets $var(reject_reason) before calling this.
# Deliberately INFO, not WARN/ERROR -- these are routine, expected
# rejections (unauthenticated source, no route found, rate limit,
# etc), not operational faults; PIKE flood-protection already has its
# own WARN-level log further up, left as-is since a flood event is a
# different severity than "this one call didn't match any route."
route[LOG_REJECTED] {
    xlog("L_INFO", "REJECTED $rm from $si:$sp -- $var(reject_reason)\n");
}

# Validates that an inbound call claiming to be from $fU@$fd is
# actually arriving from where that subscriber is currently
# registered -- the real security gate for INVITE-from-subscriber,
# confirmed live this session (see the git history for the
# discussion): a domain's own outbound_auth_required setting alone is
# insufficient, since it only proves knowledge of credentials, not
# that the caller is at a registration this platform actually has on
# file, and a domain with outbound_auth_required=0 had no source
# validation at all -- trusted purely because the From header claimed
# a known local domain, which is trivially spoofable.
#
# NAT-aware by design, not just IP:port exact match: IP is always
# required, but port is only strictly enforced for contacts NOT
# flagged as behind NAT at registration time -- a NAT'd contact's
# port commonly changes over time as the NAT device's own mapping
# rebinds, and rejecting that would break legitimate calls from any
# NAT'd subscriber whose mapping shifted since their last REGISTER
# refresh. isbflagset(1) after lookup() correctly reflects the
# MATCHED contact's own NAT status specifically (registrar's own
# documented behavior: branch flags are restored from usrloc as a
# side effect of lookup()), not some stale/global flag state.
#
# Sets $var(subscriber_source_trusted) to 1 or 0. Temporarily
# overwrites and restores $ru -- lookup() is destination-oriented
# (operates on R-URI), so the claimed AOR has to be loaded there
# for the duration of this check; the real R-URI (this call's actual
# destination) is completely unaffected once this route returns.
route[VALIDATE_SUBSCRIBER_SOURCE] {
    if ($var(vss_check_user) == $null || $var(vss_check_user) == "") {
        $var(vss_check_user) = $fU;
    }
    $var(subscriber_source_trusted) = 0;
    $var(vss_orig_ru) = $ru;
    $ru = "sip:" + $var(vss_check_user) + "@" + $fd;
    if (lookup("location")) {
        $var(vss_host) = $(ru{uri.host});
        $var(vss_port) = $(ru{uri.port});
        if ($var(vss_host) == $si) {
            if (isbflagset(1)) {
                # NAT'd at registration time -- IP match alone is
                # sufficient; port is expected to shift.
                $var(subscriber_source_trusted) = 1;
            } else if ($var(vss_port) == $sp) {
                # Not NAT'd -- no excuse for a port mismatch.
                $var(subscriber_source_trusted) = 1;
            }
        }
    }
    $ru = $var(vss_orig_ru);

    # Call 1 is the one source for this whole decision -- location,
    # ACL, and Trust CIDR all considered together, not three separate
    # mechanisms. Only reached if location didn't already prove it;
    # the common, already-registered case never touches either check
    # below.
    if ($var(subscriber_source_trusted) == 0 && $var(from_subscriber_id) != "") {
        # This subscriber's own ACL allow entries, consolidated into
        # the permissions module's address table (same native-CIDR
        # mechanism already proven for trunk/domain ACLs) at
        # grp=30000+subscriber_id -- no separate htable, no per-IP
        # expansion, no runtime CIDR looping. Guarded on
        # from_subscriber_id being set, since the SQL-fallback path
        # never has a specific subscriber to check against.
        $var(vss_acl_grp) = 30000 + $var(from_subscriber_id);
        if (allow_address("$var(vss_acl_grp)", "$si", "0")) {
            $var(subscriber_source_trusted) = 1;
        }
    }

    if ($var(subscriber_source_trusted) == 0 && $var(from_trust_cidr_1) != "") {
        if (is_in_subnet("$si", "$var(from_trust_cidr_1)")) {
            $var(subscriber_source_trusted) = 1;
        }
    }
    if ($var(subscriber_source_trusted) == 0 && $var(from_trust_cidr_2) != "") {
        if (is_in_subnet("$si", "$var(from_trust_cidr_2)")) {
            $var(subscriber_source_trusted) = 1;
        }
    }
}

# ── Shared subscriber-match handling, extracted so both the existing
#    SQL fallback path AND Call 1's htable-hit path (below, in
#    route[INVITE]) can reach it without duplicating this logic.
#    Inputs (already set by the caller): $var(from_domain_id),
#    $var(from_outbound_auth), $var(eff_topoh_in). Runs the real,
#    NAT-aware registration proof (VALIDATE_SUBSCRIBER_SOURCE),
#    optional digest challenge, and sets up from_username/
#    from_domain_name/safe caller-ID defaults for downstream use. ──
route[HANDLE_SUBSCRIBER_SOURCE_MATCH] {
    $var(vss_check_user) = $fU;
    route(VALIDATE_SUBSCRIBER_SOURCE);
    if ($var(subscriber_source_trusted) == 0) {
        $var(reject_reason) = "REGISTER required -- source does not match a current registration for " + $fU + "@" + $fd;
        route(LOG_REJECTED);
        $var(rr_key) = "403_unknown_source"; $var(rr_default) = "Forbidden"; route(RESP_REASON);
        sl_send_reply("403", "$var(rr_effective)");
        exit;
    }
    if ($var(from_outbound_auth) == 1) {
        if (!pv_proxy_authenticate("$fd", "$var(from_ha1)", "1")) {
            proxy_challenge("$fd", "0");
            exit;
        }
        # Historical note, kept for defense-in-depth rather than
        # removed: this block originally closed a real gap when the
        # digest check was proxy_authenticate("$fd","subscriber"),
        # which validated whatever username was actually in Proxy-
        # Authorization ($au) -- independent of what From claimed
        # ($fU) -- meaning a mismatch could reach here with a
        # genuinely successful auth for the WRONG account. Since the
        # switch to pv_proxy_authenticate() above (explicit HA1, tied
        # to the CLAIMED $fU from Call 1's own htable hit), that
        # mismatch can no longer succeed at the credential check
        # itself -- the digest response simply won't match a
        # different account's HA1, so authentication fails first, one
        # branch up. This re-verification is now effectively
        # unreachable under normal conditions, not the primary gap-
        # closer it was -- left in place as a harmless second layer
        # rather than removed, in case some future auth-mechanism
        # change (a different backend, SIP extension, etc) reopens the
        # same class of gap this was originally built to catch.
        if ($(au{s.escape.common}) != "" && $(au{s.escape.common}) != "0" && $(au{s.escape.common}) != $fU) {
            $var(vss_reauth_key) = $Ri + ":" + $Rp + ":" + $(au{s.escape.common}) + "@" + $fd;
            $var(vss_reauth_val) = $sht(subscriber_auth=>$var(vss_reauth_key));
            if ($var(vss_reauth_val) == $null || $var(vss_reauth_val) == "") {
                # Authenticated against a real password, but that
                # username isn't a known subscriber_auth entry on this
                # domain/listener at all -- shouldn't normally happen
                # (proxy_authenticate already validated the password
                # against this same subscriber table), but reject
                # rather than proceed on an identity we can't actually
                # resolve.
                $var(reject_reason) = "authenticated as " + $(au{s.escape.common}) + "@" + $fd + " but no matching subscriber_auth entry -- rejecting rather than proceeding on an unresolved identity";
                route(LOG_REJECTED);
                sl_send_reply("403", "Forbidden");
                exit;
            }
            $var(from_subscriber_id) = $(var(vss_reauth_val){s.select,7,|});
            $var(from_trust_cidr_1) = $(var(vss_reauth_val){s.select,8,|});
            $var(from_trust_cidr_2) = $(var(vss_reauth_val){s.select,9,|});
            $var(eff_topoh_in) = $(var(vss_reauth_val){s.select,6,|});
            $var(vss_check_user) = $(au{s.escape.common});
            route(VALIDATE_SUBSCRIBER_SOURCE);
            if ($var(subscriber_source_trusted) == 0) {
                $var(reject_reason) = "authenticated as " + $(au{s.escape.common}) + "@" + $fd + " (claimed " + $fU + ") but that account is not trusted from this source";
                route(LOG_REJECTED);
                sl_send_reply("403", "Forbidden");
                exit;
            }
        }
    }
    # Authenticated (or auth not required for this domain) -- treat
    # as a call FROM one of our own users. $au only carries a real,
    # trustworthy value when proxy_authenticate() actually ran and
    # succeeded above -- confirmed live that $au defaults to the
    # literal string "0" (not "" and not $null) when auth was never
    # attempted, which a naive "== ''" check wouldn't catch, silently
    # leaving from_username as "0" for any domain with
    # outbound_auth_required=0.
    $var(from_user_call) = 1;
    if ($var(from_outbound_auth) == 1) {
        $var(from_username) = $(au{s.escape.common});
    } else {
        $var(from_username) = $(fU{s.escape.common});
    }
    if ($var(from_username) == "" || $var(from_username) == "0") { $var(from_username) = $(fU{s.escape.common}); }
    $var(from_domain_name) = $(fd{s.escape.common});
    # Caller-ID/called-number resolution deliberately NOT done here --
    # see route[LOOKUP_PROFILE], which already resolves routing_
    # profile_id and caller-ID fields for this same (username,
    # domain_name) key, either from the same Call 1 htable entry (free)
    # or the SQL fallback. Safe "allow any / no override" defaults set
    # here only so the unconditional route(ENFORCE_CALLERID) call
    # further down in route[INVITE] doesn't operate on completely
    # undefined $var()s for a subscriber-source call -- a real bug
    # found live earlier this session: comparing an undefined $var()
    # against a string literal throws Kamailio's own "automatic string
    # to int conversion" error rather than simply evaluating false.
    # Corrected once the real per-subscriber values are known, via a
    # second extraction+enforcement pass in route[LOOKUP_PROFILE] itself.
    $var(eff_in_cid_name) = "";
    $var(eff_in_cid_mode) = "allow_any";
    $var(eff_in_cid_custom) = "";
    $var(eff_in_cid_forced) = "";
    $var(eff_in_pai_rpid) = "0";
    $var(eff_in_called_source) = "request_uri";
}

route[INVITE] {
    # Truly original called/calling numbers -- captured here, at the
    # very first line of the very first route this INVITE reaches,
    # specifically BEFORE any extraction or manipulation logic can
    # touch $rU/$fU (including the called-number source extraction
    # below, which rewrites $rU for to_header/rpid sources). A real
    # bug, found and fixed live this session: the original capture
    # point for these was deep inside route[HANDLE_CALL], which only
    # runs AFTER both the trunk- and subscriber-source called-number
    # extraction call sites -- meaning "original_called" was actually
    # capturing a post-extraction value already rewritten from
    # to_header/rpid, not the true, as-received R-URI.
    $var(orig_ru) = $rU;
    $var(orig_fu) = $fU;

    # Caller-requested privacy -- what this call's own original Privacy
    # header (if any) requests, checked here before any trunk/domain
    # outbound_privacy_mode is even resolved, so it reflects only the
    # caller's own stated wish, independent of downstream config.
    # Combined with the destination's own outbound_privacy_mode at
    # presentation time as a floor (never let downstream config
    # silently downgrade a privacy level the caller explicitly asked
    # for) -- see route[APPLY_CALLERID_PRESENTATION]. "session" and/or
    # "header" alongside "id" indicates the full RFC 3323 combination
    # (Privacy: id;header;session); plain "id" alone maps to the "id"
    # level; anything else (no header, or "none") maps to "none".
    $var(caller_requested_privacy) = "none";
    if (is_privacy("id")) {
        $var(caller_requested_privacy) = "id";
        if (is_privacy("session") || is_privacy("header")) {
            $var(caller_requested_privacy) = "full";
        }
    }

    $var(from_user_call) = 0;
    $var(reg_id_matched) = 0;

    # Call 1 -- unified identity htable lookup (subscriber_auth),
    # per the finalized design. Genuinely free, in-memory -- tried
    # BEFORE Call 2 (allow_source_address) below. Two candidate keys,
    # since a given INVITE can only plausibly match one:
    #   $Ri:$Rp:$fU@$fd  -> claimed subscriber identity
    #   $Ri:$Rp:$rd      -> trunk realm-auth OR identity-allowlist
    #                        entry, keyed by the R-URI's own domain
    #                        (something WE control, not the caller)
    $var(call1_key_subscriber) = $Ri + ":" + $Rp + ":" + $fU + "@" + $fd;
    $var(call1_val) = $sht(subscriber_auth=>$var(call1_key_subscriber));
    $var(call1_type) = "";
    if ($var(call1_val) != $null && $var(call1_val) != "") {
        $var(call1_type_field) = $(var(call1_val){s.select,0,|});
        $var(call1_type) = $(var(call1_type_field){s.select,1,=});
    }

    if ($var(call1_type) == "subscriber") {
        # Confirmed subscriber identity claim -- everything Call 1
        # needs for the FULL trust decision (not just identity) is
        # already sitting in this same htable entry, per the
        # consolidated value format: type=subscriber|ha1|domain_id|
        # has_deny|has_allow|outbound_auth_required|topoh_mask_inbound|
        # subscriber_id|trust_cidr_1|trust_cidr_2 -- no SQL needed to
        # get any of them. VALIDATE_SUBSCRIBER_SOURCE (the real trust
        # proof: location OR the subscriber's own ACL address-table
        # group OR either Trust CIDR) still runs via the shared route
        # -- this htable hit only confirms the claimed identity
        # corresponds to a real, known account, not that the source
        # is actually trusted yet.
        $var(from_ha1) = $(var(call1_val){s.select,1,|});
        $var(from_domain_id) = $(var(call1_val){s.select,2,|});
        $var(from_outbound_auth) = $(var(call1_val){s.select,5,|});
        $var(eff_topoh_in) = $(var(call1_val){s.select,6,|});
        $var(from_subscriber_id) = $(var(call1_val){s.select,7,|});
        $var(from_trust_cidr_1) = $(var(call1_val){s.select,8,|});
        $var(from_trust_cidr_2) = $(var(call1_val){s.select,9,|});
        route(HANDLE_SUBSCRIBER_SOURCE_MATCH);
    } else {
        $var(call1_key_trunk) = $Ri + ":" + $Rp + ":" + $rd;
        $var(call1_trunk_val) = $sht(subscriber_auth=>$var(call1_key_trunk));
        $var(call1_trunk_type) = "";
        if ($var(call1_trunk_val) != $null && $var(call1_trunk_val) != "") {
            $var(call1_trunk_type_field) = $(var(call1_trunk_val){s.select,0,|});
            $var(call1_trunk_type) = $(var(call1_trunk_type_field){s.select,1,=});
        }

        if ($var(call1_trunk_type) == "trunk_challenge") {
            # Entry A -- shared-realm design (finalized this session):
            # this destination has at least one digest-mode trunk
            # expected on it. The realm pushed in the challenge is $rd
            # itself, NOT a per-trunk stored value -- confirmed
            # necessary via Kamailio's own docs: www_challenge() sends
            # its reply immediately and terminates script processing,
            # so it cannot be called in a loop to build multiple
            # per-trunk WWW-Authenticate headers in one response, which
            # would have been the only way to give each trunk a
            # genuinely distinct protocol-level realm. Multiple digest
            # trunks can share this exact same Entry A trigger; each
            # still keeps its own distinct Entry B row below,
            # disambiguated by username alone.
            if ($au == "" || $au == $null) {
                www_challenge("$rd", "0");
                exit;
            }
            # Challenged retry -- $au is a raw parse of the
            # Authorization/Proxy-Authorization header's username,
            # available before any validation call runs (confirmed via
            # Kamailio's own pseudo-variable docs), so it can be used
            # to build the Entry B lookup key directly.
            $var(call1_key_trunkauth) = $rd + ":" + $au;
            $var(call1_trunkauth_val) = $sht(subscriber_auth=>$var(call1_key_trunkauth));
            if ($var(call1_trunkauth_val) == $null || $var(call1_trunkauth_val) == "") {
                $var(reject_reason) = "digest auth: no credential record for $au@$rd";
                route(LOG_REJECTED);
                sl_send_reply("403", "Forbidden");
                exit;
            }
            # type=trunk|ha1|trunk_id|trunk_name|sip_profile_id|
            # profile_id|media_profile_id -- same "one lookup, full
            # identity inline" shape as every other entry in this
            # design. Validated via the explicit HA1 supplied here,
            # not a database table -- zero DB queries during digest
            # validation itself.
            $var(ca_ha1_field) = $(var(call1_trunkauth_val){s.select,1,|});
            $var(ca_ha1) = $(var(ca_ha1_field){s.select,1,=});
            if (!pv_www_authenticate("$rd", "$var(ca_ha1)", "1")) {
                $var(reject_reason) = "digest auth: invalid response for $au@$rd";
                route(LOG_REJECTED);
                www_challenge("$rd", "0");
                exit;
            }
            $var(ca_trunk_id_field) = $(var(call1_trunkauth_val){s.select,2,|});
            $var(ca_trunk_id) = $(var(ca_trunk_id_field){s.select,1,=});
            $var(ca_trunk_name_field) = $(var(call1_trunkauth_val){s.select,3,|});
            $var(ca_trunk_name) = $(var(ca_trunk_name_field){s.select,1,=});
            $var(ca_profile_id_field) = $(var(call1_trunkauth_val){s.select,5,|});
            $var(ca_profile_id) = $(var(ca_profile_id_field){s.select,1,=});
            $var(ca_media_profile_id_field) = $(var(call1_trunkauth_val){s.select,6,|});
            $var(ca_media_profile_id) = $(var(ca_media_profile_id_field){s.select,1,=});
            $var(ca_trust_cidr_1_field) = $(var(call1_trunkauth_val){s.select,7,|});
            $var(ca_trust_cidr_1) = $(var(ca_trust_cidr_1_field){s.select,1,=});
            $var(ca_trust_cidr_2_field) = $(var(call1_trunkauth_val){s.select,8,|});
            $var(ca_trust_cidr_2) = $(var(ca_trust_cidr_2_field){s.select,1,=});
            $var(ca_rl_name_field) = $(var(call1_trunkauth_val){s.select,9,|});
            $var(ca_rl_name) = $(var(ca_rl_name_field){s.select,1,=});
            if ($var(ca_rl_name) != $null && $var(ca_rl_name) != "") {
                $var(ca_rl_algo_field) = $(var(call1_trunkauth_val){s.select,10,|});
                $var(ca_rl_algo) = $(var(ca_rl_algo_field){s.select,1,=});
                $var(ca_rl_limit_field) = $(var(call1_trunkauth_val){s.select,11,|});
                $var(ca_rl_limit) = $(var(ca_rl_limit_field){s.select,1,=});
                if (!pl_check("$var(ca_rl_name)", "$var(ca_rl_algo)", "$(var(ca_rl_limit){s.int})")) {
                    xlog("L_INFO", "$ci: rate limit exceeded (pipe $var(ca_rl_name), scope trunk)\n");
                    $var(rr_key) = "503_rate_limit_exceeded"; $var(rr_default) = "Rate Limit Exceeded"; route(RESP_REASON);
                    sl_send_reply("503", "$var(rr_effective)");
                    exit;
                }
            }
            # ip_and_digest-equivalent cross-check, automatic when this
            # trunk has an ACL attached (no separate mode value needed
            # -- see the inbound_auth_mode collapse): the source IP
            # must belong to the SAME trunk_id Digest just resolved,
            # not merely appear in trunk_ip_identity at all. Fails
            # closed even with a fully correct digest response if the
            # source IP belongs to a different trunk, or matches
            # nothing -- correct credentials from the wrong network do
            # not get through. A trunk with no ACL attached has no
            # trunk_ip_identity entry for its own IP at all in that
            # case (Call 2 is ACL/DNS-resolved-IP only), so this check
            # is skipped entirely -- not a gap, since there is nothing
            # to cross-check against for a digest-only trunk.
            $var(ca_ip_check) = $sht(trunk_ip_identity=>$Ri:$Rp:$si);
            if ($var(ca_ip_check) != $null && $var(ca_ip_check) != "") {
                $var(ca_ip_trunk_id) = $(var(ca_ip_check){s.select,0,|});
                if ($var(ca_ip_trunk_id) != $var(ca_trunk_id)) {
                    $var(reject_reason) = "digest auth valid for trunk $var(ca_trunk_name), but source IP "
                                         + "$si belongs to a different trunk's ACL -- rejecting the mismatch";
                    route(LOG_REJECTED);
                    sl_send_reply("403", "Forbidden");
                    exit;
                }
            }
            $var(ca_trust_ok) = 1;
            if ($var(ca_trust_cidr_1) != "" || $var(ca_trust_cidr_2) != "") {
                $var(ca_trust_ok) = 0;
                if ($var(ca_trust_cidr_1) != "" && is_in_subnet("$si", "$var(ca_trust_cidr_1)")) {
                    $var(ca_trust_ok) = 1;
                }
                if ($var(ca_trust_ok) == 0 && $var(ca_trust_cidr_2) != "" && is_in_subnet("$si", "$var(ca_trust_cidr_2)")) {
                    $var(ca_trust_ok) = 1;
                }
            }
            if ($var(ca_trust_ok) == 0) {
                $var(reject_reason) = "digest auth valid for trunk $var(ca_trunk_name), but source "
                                     + "$si is outside that trunk's configured Trust CIDR -- rejecting";
                route(LOG_REJECTED);
                sl_send_reply("403", "Forbidden");
                exit;
            }
            $var(profile_id) = $var(ca_profile_id);
            $var(inbound_media_profile_id) = $var(ca_media_profile_id);
            $var(src_trunk_name) = $var(ca_trunk_name);
            $var(from_user_call) = 0;
            $var(reg_id_matched) = 1;
            $var(inbound_trunk_setid) = $var(ca_trunk_id);
            $var(inbound_trunk_real_id) = $var(ca_trunk_id);
            $var(inbound_trunk_name) = $var(ca_trunk_name);
        } else {
        # identity_allowlist type (or no Call 1 match at all) falls
        # through here -- an allowlist hit alone is a routing signal
        # toward the IP-trust path below, not sufficient proof on its
        # own, per the finalized design.
        #!ifdef SCANNER_BLOCK_ENABLED
        # Scanner fingerprint check -- only for INVITEs Call 1 could
        # NOT classify as a known subscriber or trunk_realm. A trusted
        # source never reaches here, so this costs nothing on
        # legitimate traffic and carries zero false-positive risk
        # against a real registered user. Dropped before allow_source_
        # address/rate-gate/SQL so an obvious scanner never triggers
        # that work. Emits a REJECTED line the kamailio-scanner fail2ban
        # jail bans on. UA is spoofable -- this stops the high volume of
        # low-effort automated scanning, not a determined attacker.
        if ($ua =~ SCANNER_UA_REGEX) {
            $var(reject_reason) = "scanner fingerprint blocked (User-Agent)";
            route(LOG_REJECTED);
            exit;
        }
        #!endif
        # Aggregate, source-IP-agnostic rate gate -- deliberately
        # before the trunk_ip_identity lookup below and the domain_
        # settings SQL fallback, both of which cost real work per
        # call. PIKE above is per-source-IP and generously tuned for
        # legitimate trunk bursts -- it cannot catch a distributed
        # attack spread across many distinct source IPs, each
        # individually staying under PIKE's own threshold. This gate
        # is the complementary piece: one shared, fixed-name pipe
        # (pl_check() called directly, no SQL lookup for the pipe
        # config itself -- this is a single always-the-same gate, not
        # the dynamic per-trunk/domain kind CHECK_RATE_LIMIT handles,
        # so a SQL lookup here would defeat the entire purpose), so no
        # matter how many distinct IPs an attacker uses, the total
        # rate of expensive work this node will ever do for traffic
        # not already proven to be a known trunk by direct IP/ACL
        # match is capped at one ceiling. Some legitimate hostname-
        # trunk/subscriber traffic sharing this pipe during a genuine
        # attack is an accepted, inherent trade-off of any aggregate
        # limit -- tuned generously so normal traffic never approaches
        # it under real conditions.
        if (!pl_check("unproven_source_traffic", "TAILDROP", "300")) {
            $var(reject_reason) = "unproven-source aggregate rate limit exceeded (possible distributed flood)";
            route(LOG_REJECTED);
            exit;
        }
        # Call 2 -- IP-only trunk identification, reached because Call 1
        # found no subscriber, domain, or trunk-realm match at all. Same
        # Ri:Rp:si key and value shape as Stage 3/the digest+ACL cross-
        # check use -- trust and full routing identity resolved in this
        # one lookup, no live DNS, no SQL query. Supersedes the old
        # allow_source_address()/CHECK_FQDN_TRUST gate entirely -- this
        # is the actual fix for the gap found this session: Call 2 was
        # previously only ever read by Stage 3, downstream of this
        # earlier gate still deciding trust via the pre-redesign
        # mechanism, meaning ip-mode trunks (which rely on Call 2 for
        # BOTH trust and identity, with no Digest backstop) were never
        # actually being trusted via trunk_ip_identity at the point that
        # mattered.
        $var(c2_val) = $sht(trunk_ip_identity=>$Ri:$Rp:$si);
        if ($var(c2_val) != $null && $var(c2_val) != "") {
            $var(profile_id) = $(var(c2_val){s.select,3,|});
            $var(inbound_media_profile_id) = $(var(c2_val){s.select,4,|});
            $var(src_trunk_name) = $(var(c2_val){s.select,1,|});
            $var(from_user_call) = 0;
            $var(reg_id_matched) = 1;
            $var(inbound_trunk_setid) = $(var(c2_val){s.select,0,|});
            $var(inbound_trunk_real_id) = $(var(c2_val){s.select,0,|});
            $var(inbound_trunk_name) = $(var(c2_val){s.select,1,|});
        } else {
            # v3 AOR: neither Call 1 nor Call 2 recognized this source
            # -- reject directly, no SQL. The only legitimate reason a
            # real subscriber's Call 1 entry could be missing here is
            # sync lag (a brand-new subscriber, created since the last
            # sync cycle -- up to ~60s) -- narrow and self-resolving,
            # not worth a real database query reachable by every
            # unrecognized source, which is exactly the traffic shape
            # a scanner or attacker produces. A SQL fallback here used
            # to run for precisely that untrusted, unproven traffic --
            # directly contradicting this platform's own Call 1/Call 2
            # design principle of keeping SQL off the DDoS-critical
            # path (confirmed: that principle was explicitly why Stage
            # 3's own SQL-based trunk-identity lookup only ever runs
            # for traffic ALREADY confirmed trusted via Call 2, never
            # for unproven traffic -- this fallback broke that same
            # rule for the subscriber side).
            $var(reject_reason) = "unauthorised source (not a known trunk or local-domain subscriber)";
            route(LOG_REJECTED);
            $var(rr_key) = "403_unknown_source"; $var(rr_default) = "Forbidden"; route(RESP_REASON);
            sl_send_reply("403", "$var(rr_effective)");
            exit;
        }
    }
    }

    # If we reach here with from_user_call still 0, this call arrived
    # from a recognized trunk source (either allow_source_address
    # succeeded directly, or Call 2/trunk_ip_identity did) -- reverse-
    # look up which trunk by matching the source IP against the
    # dispatcher table's own destination column, the same table
    # trunks are synced into.
    #
    # CHECK_INBOUND_POLICY (the old IP-keyed trunk auth-mode lookup)
    # deliberately REMOVED here, not just relocated -- per the
    # finalized design, Call 1's trunk_realm mechanism (checked much
    # earlier in this route, before allow_source_address even runs)
    # already retires this for every digest-requiring trunk. Keeping
    # this as a "fallback" would mean keeping the exact same
    # unreliable-for-ACL-trusted-trunks IP-only matching that
    # motivated building trunk_realm in the first place -- not a
    # genuine safety net, just the same known gap left in place. A
    # trunk whose realm doesn't match what Call 1 expects is a
    # configuration problem that should surface clearly (call fails,
    # admin fixes the realm), not one silently papered over by a
    # second, less-capable identity mechanism.
    #
    # setid alone is NOT the real trunk.id (it's an independently
    # allocated dispatcher grouping value -- see platform_trunks.
    # dispatcher_setid) -- the real trunk.id is recovered here from
    # attrs' own duid= field (same extraction already verified live
    # for the outbound credentials lookup), and the trunk's name comes
    # directly from dispatcher's own description column (already
    # correctly populated by sync-routing.py). Both flow into
    # dlg_var()s below and from there into cdr_extra, so CDRs carry a
    # correct trunk_id (matches platform_trunks.id, usable for stats/
    # joins) AND a human-readable trunk name with no join required.
    if ($var(from_user_call) == 0) {
        # Safe defaults first, unconditionally -- a real bug found and
        # fixed live this session: if the dispatcher lookup below finds
        # zero matching rows (source IP didn't match any known trunk's
        # destination column), every eff_in_cid_*/eff_topoh_in $var()
        # stayed completely undefined all the way to route(
        # ENFORCE_CALLERID)'s string comparisons -- confirmed live that
        # comparing an undefined $var() against a string literal throws
        # Kamailio's own "automatic string to int conversion" error
        # rather than simply evaluating false. Same class of bug as the
        # subscriber-origin path above, just missing here.
        $var(inbound_trunk_setid) = "";
        $var(eff_topoh_in) = "1";
        $var(eff_in_cid_name) = "";
        $var(eff_in_cid_mode) = "allow_any";
        $var(eff_in_cid_custom) = "";
        $var(eff_in_cid_forced) = "";
        $var(eff_in_pai_rpid) = "0";
        $var(eff_in_called_source) = "request_uri";
        # Real bug found via a live CDR showing inbound_trunk_id empty
        # for a call that DID correctly identify and route (PBXact17):
        # the original $si-matching query below only works when a
        # trunk's ip_addr is a literal IP (dispatcher.destination is
        # built from ip_addr verbatim) -- a hostname-valued ip_addr
        # (pbxact17.sangoma.cloud) never matches $si at all, silently
        # leaving inbound_trunk_id/eff_in_cid_* at their empty
        # defaults for every hostname-based trunk, not just in the CDR
        # but in actual caller-ID presentation behavior too, since this
        # was the only place those got resolved from. Fixed by querying
        # on duid (embedded in attrs, set by sync-routing.py to this
        # trunk's own platform_trunks.id) instead of $si -- robust
        # regardless of whether ip_addr is a literal IP or a hostname,
        # since it uses the trunk_id Call 1/Call 2 already correctly
        # resolved rather than re-deriving identity from the source IP
        # a second time.
        $var(it_found) = 0;
        if ($var(inbound_trunk_real_id) != "") {
            $var(tda_val) = $sht(trunk_dispatcher_attrs=>$var(inbound_trunk_real_id));
            if ($var(tda_val) != $null && $var(tda_val) != "") {
                $var(it_setid) = $(var(tda_val){s.select,0,|});
                $var(it_attrs) = $(var(tda_val){s.select,1,|});
                $var(it_description) = $(var(tda_val){s.select,2,|});
                $var(it_found) = 1;
            }
        } else {
            # Defensive fallback only -- should be unreachable given
            # from_user_call==0 implies a prior successful Call 1/Call 2
            # match already set inbound_trunk_real_id, but not assumed
            # without a safety net. Rare enough (effectively dead code
            # under normal operation) that it stays SQL rather than
            # justifying its own htable -- same reasoning as trunk_ping_
            # identity being deprioritized elsewhere in this same pass.
            $var(inbound_trunk_name) = "";
            sql_query("ca", "SELECT setid, attrs, description FROM dispatcher WHERE destination LIKE 'sip:' || '$si' || ':%' LIMIT 1", "it");
            if ($dbr(it=>rows) > 0) {
                $var(it_setid) = $dbr(it=>[0,0]);
                $var(it_attrs) = $dbr(it=>[0,1]);
                $var(it_description) = $dbr(it=>[0,2]);
                $var(it_found) = 1;
            }
            sql_result_free("it");
        }
        if ($var(it_found) == 1) {
            $var(inbound_trunk_setid) = $var(it_setid);
            $var(inbound_trunk_name) = $var(it_description);
            if ($var(inbound_trunk_real_id) == "") {
                $var(inbound_trunk_real_id) = "";
                if ($var(it_attrs) =~ "duid=") {
                    $var(inbound_trunk_real_id) = $(var(it_attrs){re.subst,/.*duid=([0-9]+).*/\1/}{s.int});
                }
            }
            # Trunk-source caller-ID/topoh settings -- same eff_* $var()s
            # the subscriber-origin path (above) populates, so downstream
            # logic in route[HANDLE_CALL] doesn't need to know or care
            # which side of the call this was. Inbound fields only --
            # this trunk's own outbound_* settings (presentation method
            # etc.) are irrelevant here, same reasoning as the
            # subscriber-origin path just above: this trunk is the
            # SOURCE of the call being processed, never its destination.
            if ($var(it_attrs) =~ "topoh_in=") {
                $var(eff_topoh_in) = $(var(it_attrs){re.subst,/.*topoh_in=([01]).*/\1/});
            }
            if ($var(it_attrs) =~ "in_cid_name=") {
                $var(eff_in_cid_name) = $(var(it_attrs){re.subst,/.*in_cid_name="?([^;"]*)"?.*/\1/});
            }
            if ($var(it_attrs) =~ "in_cid_mode=") {
                $var(eff_in_cid_mode) = $(var(it_attrs){re.subst,/.*in_cid_mode=([a-z_]+).*/\1/});
            }
            if ($var(it_attrs) =~ "in_cid_custom=") {
                $var(eff_in_cid_custom) = $(var(it_attrs){re.subst,/.*in_cid_custom="?([^;"]*)"?.*/\1/});
            }
            if ($var(it_attrs) =~ "in_cid_forced=") {
                $var(eff_in_cid_forced) = $(var(it_attrs){re.subst,/.*in_cid_forced="?([^;"]*)"?.*/\1/});
            }
            if ($var(it_attrs) =~ "in_pai_rpid=") {
                $var(eff_in_pai_rpid) = $(var(it_attrs){re.subst,/.*in_pai_rpid=([01]).*/\1/});
            }
            if ($var(it_attrs) =~ "in_called_source=") {
                $var(eff_in_called_source) = $(var(it_attrs){re.subst,/.*in_called_source=([a-z_]+).*/\1/});
            }
        }
        route(EXTRACT_CALLED_NUMBER);
    }

    # Session timers (sst) -- flagging this dialog for sst tracking
    # lets the dialog module automatically expire stale/zombie
    # sessions based on the negotiated Session-Expires, rather than
    # relying solely on the fixed default_timeout. Deliberately NOT
    # using sstCheckMin() to reject undersized Session-Expires/Min-SE
    # values here -- confirmed via direct testing against a real
    # instance that it returned "too small" (true) even for a
    # Session-Expires of 3600 against a min_se of 1800, which would
    # have rejected every call in production. Not shipping unverified,
    # reject-capable logic; tracking-only is the safe, confirmed value.
    setflag(FLT_SST);

    setflag(FLT_ACC);
    dlg_manage();
    # The caller's own address -- what event_route[topoh:msg-outgoing]
    # compares $sndto against to tell "message headed back toward the
    # caller" apart from any other direction. Set unconditionally here
    # (not per source type) since $si:$sp is always the address this
    # INVITE actually arrived from, whether that's a trunk or a
    # subscriber's registered contact. Deliberately caller-address-
    # based rather than callee-address-based: the caller side is
    # always exactly one address, but the callee side can legitimately
    # be several (ring_policy=all parallel-forking to multiple
    # registered contacts) -- comparing against the one side that's
    # always singular is what makes this correct in both cases.
    $dlg_var(topoh_caller_addr) = $si + ":" + $sp;
    # from_tag is known from the very start (the original INVITE's
    # own From-tag persists unchanged through the whole dialog) --
    # captured here for the same call/CDR/recording correlation
    # purpose as everything else on this line, so a recording's
    # metadata and its corresponding CDR row can be joined on more
    # than Call-ID alone (which is the common case, but From-tag/
    # To-tag together with it is the fully unambiguous dialog key
    # per RFC 3261, useful if a Call-ID were ever somehow reused).
    $dlg_var(call_from_tag) = $ft;
    # Transfer into dlg_var now that the dialog exists -- these were
    # only resolvable as plain $var() earlier in this same route,
    # before dlg_manage() had run. $dlg_var() is what survives through
    # to BYE-time CDR generation; $var() would not (confirmed via
    # direct testing -- see the cdr_extra modparam comment above).
    #
    # Explicitly inbound_/outbound_ prefixed throughout (here and at
    # the outbound-trunk/outbound-user resolution points later) --
    # every call has independent inbound and outbound sides (trunk to
    # trunk, trunk to user, user to trunk, or user to user), and a
    # single unprefixed "trunk_id"/"domain_id" would silently
    # conflate them depending on call direction.
    if ($var(from_user_call) == 1) {
        $dlg_var(inbound_domain_id) = $var(from_domain_id);
        $dlg_var(inbound_subscriber) = $var(from_username) + "@" + $var(from_domain_name);
    }
    if ($var(inbound_trunk_setid) != "") {
        $dlg_var(inbound_trunk_id) = $var(inbound_trunk_real_id);
        $dlg_var(inbound_trunk_name) = $var(inbound_trunk_name);
    }
    # topoh_mask_toward_caller must be a dlg_var (not just $var()) --
    # event_route[topoh:msg-outgoing] fires for later, separate
    # requests on this dialog (responses, in-dialog BYE etc), each its
    # own message-processing cycle that plain $var() doesn't survive
    # to (confirmed live earlier this session) but $dlg_var() does.
    $dlg_var(topoh_mask_toward_caller) = $var(eff_topoh_in);

    # Caller-ID extraction + SOURCE-side enforcement -- runs once per
    # call, using whichever eff_in_* settings the trunk-source or
    # subscriber-source path above already resolved (same unified
    # variable names regardless of which, so this doesn't need to
    # know or care). Produces the enforced number BEFORE routing runs
    # -- routing must operate on the trustworthy, already-enforced
    # value, not raw (potentially spoofed) input.
    #
    # Step 1: extract the raw candidate from wherever it actually
    # lives. Plain From by default; PAI/RPID preferred instead when
    # this source's own inbound_use_pai_rpid_incoming says so, since
    # some carriers put the real, billable number there while From
    # carries something else entirely. $ai gives the full PAI URI
    # (confirmed live: $(ai{uri.user}) extracts just the number);
    # RPID has no dedicated pseudo-variable, extracted from
    # $hdr(Remote-Party-ID) via regex instead (also confirmed live).
    # Both correctly evaluate empty when the header is genuinely
    # absent from the message (confirmed live), which is the common
    # case -- most calls carry neither.
    $var(cid_raw_candidate) = $fU;
    if ($var(eff_in_pai_rpid) == "1") {
        if ($ai != "") {
            $var(cid_raw_candidate) = $(ai{uri.user});
        } else if ($hdr(Remote-Party-ID) != "") {
            $var(cid_rpid_raw) = $hdr(Remote-Party-ID);
            if ($var(cid_rpid_raw) =~ "sip:") {
                $var(cid_raw_candidate) = $(var(cid_rpid_raw){re.subst,/.*sip:([^@]+)@.*/\1/});
            }
        }
    }

    # Step 2: source-side enforcement via the shared route.
    $var(cid_enforce_mode) = $var(eff_in_cid_mode);
    $var(cid_enforce_custom) = $var(eff_in_cid_custom);
    $var(cid_enforce_forced) = $var(eff_in_cid_forced);
    $var(cid_enforce_candidate) = $var(cid_raw_candidate);
    if ($var(from_user_call) == 1) {
        $var(cid_enforce_pool_type) = "subscriber";
        $var(cid_enforce_pool_key) = $var(from_username) + "@" + $var(from_domain_name);
    } else {
        $var(cid_enforce_pool_type) = "trunk";
        $var(cid_enforce_pool_key) = $var(inbound_trunk_real_id);
    }
    route(ENFORCE_CALLERID);

    # Persist as dlg_var -- source of truth for the rest of the call.
    # Destination-side enforcement (in route[HANDLE_CALL], after
    # routing) can still further override this; routing/manipulation
    # runs against it as-is; every log/CDR downstream reads from here
    # rather than re-deriving. original_calling (set above, unchanged
    # raw $fU) stays alongside this for the "what actually arrived vs
    # what we determined is correct" distinction in logs.
    $dlg_var(effective_caller_id_number) = $var(cid_enforced_number);
    $dlg_var(effective_caller_id_name) = $var(eff_in_cid_name);
    $dlg_var(caller_requested_privacy) = $var(caller_requested_privacy);

    # Manual 100 Trying (tm's own auto_inv_100 disabled globally) --
    # sent HERE, not at the top of request_route, so t_newtran()
    # (which allocates transaction state) only ever runs for an INVITE
    # whose source is already confirmed legitimate. By this line the
    # call has passed Call 1 identity / Call 2 ACL / FQDN-trust /
    # local-domain-subscriber checks (any untrusted source already
    # 403'd or hit the unproven-source rate gate and exited above),
    # and any digest-required call already challenged-and-exited. This
    # is still before route(HANDLE_CALL)'s SQL-heavy routing decision
    # and number manipulation, so the caller still gets its 100 well
    # ahead of any real routing latency -- the original intent -- just
    # no longer at the cost of letting unauthenticated floods allocate
    # transactions.
    $var(rr_key) = "100_trying"; $var(rr_default) = "Trying"; route(RESP_REASON);
    t_newtran();
    t_reply("100", "$var(rr_effective)");

    route(HANDLE_CALL);
}
# values, only route[] blocks with side effects) and produces
# $var(cid_enforced_number). Used at both the SOURCE side (before
# routing/manipulation runs, using the calling party's own inbound_*
# settings) and the DESTINATION side (after routing, using the
# destination's outbound_* settings, capable of overriding whatever
# the source side already decided) -- see the Caller ID Settings UI's
# own explanation of this pipeline for the full picture.
#
# Inputs:
#   $var(cid_enforce_mode)         -- allow_any | allow_dids_only | force_custom | force_specific_number | force_per_number
#   $var(cid_enforce_custom)       -- used only for force_custom
#   $var(cid_enforce_forced)       -- used only for force_specific_number
#   $var(cid_enforce_candidate)    -- the number being checked/enforced
#   $var(cid_enforce_pool_type)    -- "trunk" or "subscriber"
#   $var(cid_enforce_pool_key)     -- trunk.id (as a string) or "username@domain"
# Output:
#   $var(cid_enforced_number)
route[ENFORCE_CALLERID] {
    # Default: pass the candidate through unchanged -- covers
    # allow_any and is the safe starting point for every other mode.
    $var(cid_enforced_number) = $var(cid_enforce_candidate);

    if ($var(cid_enforce_mode) == "force_custom") {
        $var(cid_enforced_number) = $var(cid_enforce_custom);
    } else if ($var(cid_enforce_mode) == "force_specific_number") {
        $var(cid_enforced_number) = $var(cid_enforce_forced);
    } else if ($var(cid_enforce_mode) == "allow_dids_only" || $var(cid_enforce_mode) == "force_per_number") {
        # allow_dids_only and force_per_number resolve identically here
        # -- both require the candidate to be a real, assigned DID of
        # the relevant pool; force_per_number's distinct meaning (each
        # number maps to itself rather than a single fixed number) is
        # already satisfied by leaving the candidate unchanged when
        # it's found in the pool, same as allow_dids_only.
        #
        # Two explicit branches with STATIC table names, not one
        # dynamic-table-name $sht() call -- confirmed live via a
        # targeted 4-way isolation test that $sht() with a variable
        # table name silently fails to find existing entries on this
        # Kamailio build, regardless of whether the key is static or
        # dynamic. This was a real, confirmed production bug: every
        # allow_dids_only/force_per_number enforcement was silently
        # falling through to the SQL "first DID" fallback, never
        # recognizing a candidate as already being in its own pool.
        $var(cid_in_pool) = 0;
        if ($var(cid_enforce_pool_type) == "subscriber") {
            if ($sht(subscriber_numbers=>$var(cid_enforce_candidate)) != $null) {
                $var(cid_pool_val) = $sht(subscriber_numbers=>$var(cid_enforce_candidate));
                # subscriber_numbers value is "username@domain|number_type"
                $var(cid_pool_owner) = $(var(cid_pool_val){s.select,0,@}) + "@" + $(var(cid_pool_val){s.select,1,@}{s.select,0,|});
                if ($var(cid_pool_owner) == $var(cid_enforce_pool_key)) {
                    $var(cid_in_pool) = 1;
                }
            }
        } else {
            if ($sht(trunk_numbers=>$var(cid_enforce_candidate)) != $null) {
                $var(cid_pool_val) = $sht(trunk_numbers=>$var(cid_enforce_candidate));
                # trunk_numbers value is "trunk_id|number_type"
                $var(cid_pool_owner) = $(var(cid_pool_val){s.select,0,|});
                if ($var(cid_pool_owner) == $var(cid_enforce_pool_key)) {
                    $var(cid_in_pool) = 1;
                }
            }
        }
        if ($var(cid_in_pool) == 0) {
            # Not in the pool -- fall back to this pool's own default
            # (first DID found) rather than reject the call outright.
            # trunk_numbers/subscriber_numbers are htable-backed real
            # SQLite tables, still directly queryable via SQL for this
            # reverse (owner -> number) lookup that htable itself
            # can't do (only keyed the other direction). Confirmed
            # live this session against both pool types, including
            # the not-in-pool fallback case specifically.
            if ($var(cid_enforce_pool_type) == "trunk") {
                sql_query("ca", "SELECT key_name FROM trunk_numbers WHERE key_value LIKE '$var(cid_enforce_pool_key)|%' LIMIT 1", "cidf");
            } else {
                sql_query("ca", "SELECT key_name FROM subscriber_numbers WHERE key_value LIKE '$var(cid_enforce_pool_key)|%' LIMIT 1", "cidf");
            }
            if ($dbr(cidf=>rows) > 0) {
                $var(cid_enforced_number) = $dbr(cidf=>[0,0]);
            }
            sql_result_free("cidf");
        }
    }
}

# Caller-ID presentation -- takes the final, fully-enforced
# $dlg_var(effective_caller_id_number/name) (both source- and
# destination-side enforcement have already run by the time this is
# called, right before dispatch) and actually writes it into the
# outgoing message, per the destination's own presentation settings.
# Building blocks individually confirmed live this session before
# integration: uac_replace_from("", uri) genuinely omits the display
# name entirely (no stale/empty-quoted name left behind, unlike an
# old documented Kamailio 3.3-era quirk); tel: URIs work correctly
# through uac_replace_from(); append_hf() correctly adds PAI/RPID/
# Privacy headers.
#
# Inputs (read directly, not passed -- all already resolved by the
# time this runs): $dlg_var(effective_caller_id_number/name),
# $var(eff_out_cid_method), $var(eff_out_uri_format),
# $var(eff_out_privacy), $var(eff_out_local_addr_from)
route[APPLY_CALLERID_PRESENTATION] {
    $var(cid_apply_number) = $dlg_var(effective_caller_id_number);
    if ($var(cid_apply_number) == $null || $var(cid_apply_number) == "") {
        # Nothing resolved to enforce/present (shouldn't normally
        # happen -- enforcement always assigns something, even if
        # just the original candidate unchanged -- but a misconfigured
        # force_custom/force_specific_number with a blank field could
        # get here) -- leave the message's own From entirely untouched
        # rather than write something empty into it.
        return;
    }

    $var(cid_apply_name) = $dlg_var(effective_caller_id_name);
    if ($var(cid_apply_name) == $null) { $var(cid_apply_name) = ""; }

    # Domain part for sip: URIs -- default preserves whatever domain
    # the caller's own identity carried ($fd). Trunk-sourced calls
    # (eff_out_from_domain_mode set) get the full 5-way choice below;
    # domain-sourced calls (that var left unset/null -- still driven by
    # the older per-domain/per-subscriber boolean, unchanged in this
    # pass) keep the original two-state behavior.
    $var(cid_apply_domain) = $fd;
    if ($var(eff_out_from_domain_mode) != $null && $var(eff_out_from_domain_mode) != "") {
        if ($var(eff_out_from_domain_mode) == "local_ip") {
            $var(cid_apply_domain) = "__NODE_IP__";
        } else if ($var(eff_out_from_domain_mode) == "advertised_ip") {
            $var(cid_apply_domain) = "__EIP__";
        } else if ($var(eff_out_from_domain_mode) == "remote") {
            # This trunk's own configured identity (ip_addr/hostname
            # [:port]), already resolved earlier in this same route --
            # NOT $du, which can differ if an outbound_proxy override is
            # set (that changes where packets go, not who this trunk
            # logically IS). Falls back to transparent if somehow empty
            # (defensive -- trunk_host should always be set by this
            # point on the trunk-outbound path).
            if ($var(trunk_host) != $null && $var(trunk_host) != "") {
                $var(cid_apply_domain) = $var(trunk_host);
            }
        } else if ($var(eff_out_from_domain_mode) == "custom") {
            # This trunk's own register_from_domain field (labeled
            # "From domain" on the trunk form) -- falls back to
            # transparent if left blank, so an admin picking "custom"
            # without filling in that field can never produce a broken,
            # domain-less From URI.
            if ($var(eff_out_custom_from_domain) != "") {
                $var(cid_apply_domain) = $var(eff_out_custom_from_domain);
            }
        }
        # "transparent" (and any unrecognized value): $fd, already set
        # above -- no action needed.
    } else if ($var(eff_out_local_addr_from) == "1") {
        $var(cid_apply_domain) = "__EIP__";
    }

    if ($var(eff_out_uri_format) == "tel_uri") {
        $var(cid_apply_uri) = "tel:" + $var(cid_apply_number);
    } else if ($var(eff_out_uri_format) == "sip_uri_user_phone") {
        $var(cid_apply_uri) = "sip:" + $var(cid_apply_number) + "@" + $var(cid_apply_domain) + ";user=phone";
    } else {
        $var(cid_apply_uri) = "sip:" + $var(cid_apply_number) + "@" + $var(cid_apply_domain);
    }

    # Effective privacy level -- the destination's own configured
    # outbound_privacy_mode, floored by whatever the caller's own
    # original Privacy header actually requested (checked once, very
    # early in route[INVITE], before any downstream config was even
    # resolved -- see $dlg_var(caller_requested_privacy)'s own
    # comment). Never let downstream trunk/domain config silently
    # strip a privacy level the caller explicitly asked for -- the
    # caller's own request is a floor, not a ceiling, so the stricter
    # of the two always wins. none < id < full.
    $var(privacy_rank_out) = 0;
    if ($var(eff_out_privacy) == "id") { $var(privacy_rank_out) = 1; }
    else if ($var(eff_out_privacy) == "full") { $var(privacy_rank_out) = 2; }
    $var(privacy_rank_caller) = 0;
    if ($dlg_var(caller_requested_privacy) == "id") { $var(privacy_rank_caller) = 1; }
    else if ($dlg_var(caller_requested_privacy) == "full") { $var(privacy_rank_caller) = 2; }
    $var(effective_privacy) = $var(eff_out_privacy);
    if ($var(privacy_rank_caller) > $var(privacy_rank_out)) {
        $var(effective_privacy) = $dlg_var(caller_requested_privacy);
    }

    # Privacy overlay -- applied last, can override the presentation
    # method above when they'd otherwise conflict, per this session's
    # design discussion.
    # Remove any pre-existing Privacy/PAI/RPID headers before adding
    # our own -- append_hf() adds, it doesn't replace, so a caller's
    # own original Privacy/PAI/RPID header would otherwise survive
    # alongside whatever we add here, producing duplicates. Confirmed
    # live: a caller-sent "Privacy: id" ended up doubled in the
    # forwarded message before this fix.
    if (is_present_hf("Privacy")) { remove_hf("Privacy"); }
    if (is_present_hf("P-Asserted-Identity")) { remove_hf("P-Asserted-Identity"); }
    if (is_present_hf("Remote-Party-ID")) { remove_hf("Remote-Party-ID"); }

    if ($var(effective_privacy) == "none") {
        uac_replace_from($var(cid_apply_name), $var(cid_apply_uri));
        if ($var(eff_out_cid_method) == "pai") {
            append_hf("P-Asserted-Identity: <$var(cid_apply_uri)>\r\n");
        } else if ($var(eff_out_cid_method) == "rpid") {
            append_hf("Remote-Party-ID: <$var(cid_apply_uri)>;party=calling;screen=yes;privacy=off\r\n");
        }
    } else {
        # id or full: From is always anonymized -- RFC 3323 convention.
        uac_replace_from("", "sip:anonymous@anonymous.invalid");
        if ($var(effective_privacy) == "id") {
            append_hf("Privacy: id\r\n");
            # RFC 3325's whole point -- hide from the far-end user,
            # not the far-end network, so the real identity still
            # travels in PAI for this trusted next hop regardless of
            # what the presentation method said (method only governs
            # placement when privacy isn't overriding it).
            append_hf("P-Asserted-Identity: <$var(cid_apply_uri)>\r\n");
        } else {
            # full -- no real identity leaves the platform on this
            # leg at all, PAI deliberately suppressed.
            append_hf("Privacy: id;header;session\r\n");
        }
    }
}

# Called-number presentation -- simpler than caller-ID: no
# enforcement-mode concept (no allow_dids_only/force_* for called
# numbers), just where the already-correct $rU (extracted and routed
# by this point) also gets written for destinations that expect it
# somewhere other than the request-URI. Deliberately a separate route
# from APPLY_CALLERID_PRESENTATION rather than folded into it -- that
# route has an early return for an empty/unresolved caller-ID number,
# which would wrongly skip this logic too if combined, even though
# called-number placement has nothing to do with whether caller-ID
# enforcement produced a value.
#
# Input: $var(eff_out_called_placement) -- request_uri | to_header | rpid
route[APPLY_CALLED_NUMBER_PLACEMENT] {
    if ($var(eff_out_called_placement) == "to_header") {
        if ($var(to_header_applied) == 1) {
            xlog("L_DBG", "$ci: [called number placement] to_header requested but already applied by R-URI/To construction -- skipping to avoid a duplicate uac_replace_to() call\n");
        } else {
            $var(called_uri) = "sip:" + $dlg_var(effective_called_number) + "@" + $rd;
            uac_replace_to("", $var(called_uri));
            $var(to_header_applied) = 1;
        }
    } else if ($var(eff_out_called_placement) == "rpid") {
        $var(called_uri) = "sip:" + $dlg_var(effective_called_number) + "@" + $rd;
        append_hf("Remote-Party-ID: <$var(called_uri)>;party=called;screen=yes;privacy=off\r\n");
    }
    # request_uri (default): no action needed here for the trunk-
    # destination path ($rU already carries it there); the
    # local_subscriber path's own R-URI/To construction (after
    # lookup("location")) separately restores $rU's user-part for
    # this mode.
}

# Called-number extraction -- rewrites $rU per this call's source's
# own inbound_called_number_source setting, BEFORE routing runs,
# since routing's prefix/regex matching reads $rU directly. Unlike
# caller-ID (where $fU can't be rewritten -- confirmed live earlier
# this session -- so a separate dlg_var had to carry the enforced
# value through to routing's own queries instead), $rU is genuinely
# writable and takes effect immediately for any subsequent read,
# including from SQL query string interpolation (also confirmed live)
# -- so no parallel dlg_var/query-rewiring is needed here, a direct
# $rU assignment is sufficient.
#
# Input: $var(eff_in_called_source) -- request_uri | to_header | rpid
route[EXTRACT_CALLED_NUMBER] {
    if ($var(eff_in_called_source) == "to_header") {
        if ($tU != "") {
            $rU = $tU;
        }
    } else if ($var(eff_in_called_source) == "rpid") {
        # A called-number RPID would carry party=called, distinct
        # from the caller-ID RPID extraction elsewhere (party=
        # calling) -- in practice most sources sending RPID at all
        # only send one, typically for the caller, so this is a
        # best-effort extraction of whatever RPID is present per this
        # setting rather than a party=called-specific parse.
        if ($hdr(Remote-Party-ID) != "") {
            $var(called_rpid_raw) = $hdr(Remote-Party-ID);
            if ($var(called_rpid_raw) =~ "sip:") {
                $var(called_rpid_num) = $(var(called_rpid_raw){re.subst,/.*sip:([^@]+)@.*/\1/});
                if ($var(called_rpid_num) != "") {
                    $rU = $var(called_rpid_num);
                }
            }
        }
    }
    # request_uri (default): no change needed, $rU already correct.
}

route[BUILD_RTPENGINE_FLAGS] {
    # Dead code -- confirmed via a full grep of this file that nothing
    # ever calls route(BUILD_RTPENGINE_FLAGS). Also still references
    # the $avp(ds_attrs) mechanism confirmed broken elsewhere this
    # session (see the dispatcher modparam block's own note) -- if
    # this is ever wired in, it needs the same fix applied to the
    # trunk-level manipulation logic in route[HANDLE_CALL]: query
    # dispatcher.attrs directly by setid+destination instead.
    $var(flags) = "replace-origin replace-session-connection codec-strip-all";
    if ($avp(ds_attrs) =~ "srtp=required") { $var(flags) = $var(flags) + " SRTP-passthrough"; }
    if ($avp(ds_attrs) =~ "nat=force_rport") { $var(flags) = $var(flags) + " force"; }
}

# ── Route Plan Test tool -- reached only via the X-Route-Test header
#    checked at the very top of request_route. Reuses the real
#    matching logic in route[HANDLE_CALL]/route[LOOKUP_PROFILE]
#    completely unmodified -- the only test-specific things here are
#    (a) setting $var(route_test_mode), checked at every actual
#    dispatch point inside route[HANDLE_CALL] to report the decision
#    instead of acting on it, and (b) for trunk mode only, directly
#    resolving profile_id since $si won't match a real trunk's IP for
#    a synthetic request generated locally on this node. User mode
#    needs no such override: the test-generating script sends the
#    synthetic request directly to the target SIP Profile's own
#    listener IP:port, so $Ri:$Rp already resolves correctly through
#    route[LOOKUP_PROFILE]'s existing, unmodified logic. ──
route[ROUTE_TEST] {
    $var(route_test_mode) = 1;

    if ($hdr(X-Test-Trunk-Ip) != "") {
        $var(from_user_call) = 0;
        $var(src_trunk_name) = "-";
        $var(profile_id) = 0;
        $var(inbound_media_profile_id) = 0;
        # Mirrors the real, current Call 2 mechanism exactly (see
        # route[INVITE]'s own trunk_ip_identity lookup) -- confirmed
        # via a live bug report that the PREVIOUS version of this
        # block (trunk_identity_candidates) always reported "no
        # routing plan assigned" for every trunk, since nothing has
        # populated that table since Stage 3 was retired and replaced
        # by trunk_ip_identity this session. Same htable, same key
        # shape (Ri:Rp:ip), same value fields -- a genuine simulation
        # of the real runtime path, not a separate, drifting copy of it.
        $var(rt_val) = $sht(trunk_ip_identity=>$Ri:$Rp:$(hdr(X-Test-Trunk-Ip)));
        if ($var(rt_val) != $null && $var(rt_val) != "") {
            $var(profile_id) = $(var(rt_val){s.select,3,|});
            $var(inbound_media_profile_id) = $(var(rt_val){s.select,4,|});
            $var(src_trunk_name) = $(var(rt_val){s.select,1,|});
        }
        $var(src_descriptor) = "trunk:" + $var(src_trunk_name);

        if ($var(profile_id) == 0) {
            append_to_reply("X-Test-Result: no-routing-plan-assigned\r\n");
            append_to_reply("X-Test-Detail: this trunk has no routing plan assigned at all (see the earlier default-routing-plan-removal work this session) -- every inbound call from it gets 404 No Route Found before any rule is even considered\r\n");
            sl_send_reply("200", "Route-Test-Result");
            exit;
        }
    } else if ($hdr(X-Test-From-User) != "" && $hdr(X-Test-From-Domain) != "") {
        $var(from_user_call) = 1;
        $var(from_username) = $hdr(X-Test-From-User);
        $var(from_domain_name) = $hdr(X-Test-From-Domain);
    } else {
        sl_send_reply("400", "Route Test: missing X-Test-Trunk-Ip or X-Test-From-User/X-Test-From-Domain");
        exit;
    }

    route(HANDLE_CALL);
}

# ── Determine which Routing Profile applies to this source ──
route[LOOKUP_PROFILE] {
    if ($var(route_test_mode) == 1 && $var(from_user_call) == 0) {
        # Trunk test mode already resolved profile_id directly in
        # route[ROUTE_TEST] (source_profile keyed on the test trunk's
        # real IP, not $si -- a synthetic request generated locally on
        # this node would never match a real trunk's IP there). User
        # test mode needs no such skip: it deliberately relies on this
        # route's own unmodified $Ri:$Rp-based resolution below, since
        # the test-generating script sends the request directly to the
        # target SIP Profile's own listener.
        return;
    }
    # Call 1 (Entry A/B) or Call 2 (trunk_ip_identity) already fully
    # resolved profile_id/inbound_media_profile_id/src_trunk_name
    # earlier in request_route, before this route was ever called.
    # This check MUST happen before the profile_id reset immediately
    # below -- confirmed via a real production bug this session: with
    # the check positioned after the reset (further down, where it
    # used to be inside Stage 3's own block), this route unconditionally
    # wiped a call's already-correctly-resolved profile_id back to 0
    # on every single trunk-sourced INVITE, then returned early without
    # ever restoring it -- silently breaking routing for every ip-mode
    # and digest-mode trunk call, while looking completely fine in the
    # earlier identification-stage logs (identity was resolved
    # correctly; only the routing decision downstream saw profile 0).
    if ($var(reg_id_matched) == 1) {
        return;
    }
    $var(profile_id) = 0;
    $var(inbound_media_profile_id) = 0;
    $var(src_trunk_name) = "-";

    # Receiving listener -> SIP Profile, via $Ri:$Rp -- needed by BOTH
    # branches below (subscriber call: to resolve sip_profile_domains;
    # trunk call: Stage 3's trunk identity resolution, further down,
    # scopes its candidate search to this same SIP Profile). Real bug
    # found and fixed this session: this used to live entirely inside
    # the from_user_call==1 branch below, including that branch's own
    # early return -- meaning for every trunk-originated call,
    # recv_profile_id was NEVER assigned in this route invocation at
    # all, silently coercing to "0" wherever it was subsequently used
    # in a SQL string. Confirmed directly against real production
    # logs: the very first SQL query visible for a failing
    # trunk-originated INVITE was already "trunk_identity_candidates
    # WHERE sip_profile_id = 0" -- this sip_listeners query itself
    # never appeared in the log at all for those calls, meaning it
    # never ran, not that it ran and missed. Ruled out a sync-timing/
    # concurrency race as the cause first, via a direct, isolated WAL-
    # mode test proving reads are correctly protected during a
    # writer's open transaction -- this is a plain scoping bug, not a
    # timing issue.
    $var(sipl_val) = $sht(sip_listeners=>$Ri:$Rp);
    if ($var(sipl_val) != $null && $var(sipl_val) != "") {
        $var(recv_profile_id) = $var(sipl_val);
        $dlg_var(inbound_sip_profile_id) = $var(recv_profile_id);
    }

    # v3 AOR: a call FROM one of our own authenticated users resolves
    # its routing profile via identity, not source IP (softphones
    # don't have static IPs the way trunks do). Per-user override
    # first (subscriber_meta.routing_profile_id), else the
    # domain-on-this-SIP-Profile resolved default (already resolved
    # at sync time into sip_profile_domains.routing_profile_id --
    # junction override if set, else the SIP Profile's own mandatory
    # default -- see sync-routing.py).
    if ($var(from_user_call) == 1) {
        $var(subauth_routing_key) = $var(from_username) + "@" + $var(from_domain_name);
        $var(subauth_routing_hit) = 0;
        if ($sht(subscriber_auth=>$var(subauth_routing_key)) != $null && $sht(subscriber_auth=>$var(subauth_routing_key)) != "") {
            $var(subauth_routing_val) = $sht(subscriber_auth=>$var(subauth_routing_key));
            # Pipe-delimited: routing_profile_id|engine_type|
            # callerid_name|callerid_mode|callerid_custom|
            # callerid_forced|use_pai_rpid|called_number_source|
            # topoh_mask_inbound|user_rl_name|user_rl_algo|
            # user_rl_limit|domain_rl_name|domain_rl_algo|
            # domain_rl_limit[|bridge_segment]
            #
            # Rate-limit fields (9-14) are extracted here, unconditionally
            # whenever this htable row exists at all -- NOT nested inside
            # the routing-override check below, since the sync-side write
            # is now unconditional for every subscriber (item 15 of the
            # SQL-to-htable optimization pass), while routing_profile_id
            # itself may still legitimately be empty (no per-user
            # override configured).
            $var(user_rl_name) = $(var(subauth_routing_val){s.select,9,|});
            $var(user_rl_algo) = $(var(subauth_routing_val){s.select,10,|});
            $var(user_rl_limit) = $(var(subauth_routing_val){s.select,11,|});
            $var(domain_rl_name) = $(var(subauth_routing_val){s.select,12,|});
            $var(domain_rl_algo) = $(var(subauth_routing_val){s.select,13,|});
            $var(domain_rl_limit) = $(var(subauth_routing_val){s.select,14,|});
            $var(sa_field0) = $(var(subauth_routing_val){s.select,0,|});
            if ($var(sa_field0) != $null && $var(sa_field0) != "") {
                $var(profile_id) = $(var(subauth_routing_val){s.select,0,|});
                $var(engine_type) = $(var(subauth_routing_val){s.select,1,|});
                $var(eff_in_cid_name) = $(var(subauth_routing_val){s.select,2,|});
                $var(eff_in_cid_mode) = $(var(subauth_routing_val){s.select,3,|});
                $var(eff_in_cid_custom) = $(var(subauth_routing_val){s.select,4,|});
                $var(eff_in_cid_forced) = $(var(subauth_routing_val){s.select,5,|});
                $var(eff_in_pai_rpid) = $(var(subauth_routing_val){s.select,6,|});
                $var(eff_in_called_source) = $(var(subauth_routing_val){s.select,7,|});
                $dlg_var(topoh_mask_toward_caller) = $(var(subauth_routing_val){s.select,8,|});
                $var(bridge_segment) = $(var(subauth_routing_val){s.select,15,|});
                $var(subauth_routing_hit) = 1;

                route(EXTRACT_CALLED_NUMBER);
                $var(cid_raw_candidate) = $fU;
                if ($var(eff_in_pai_rpid) == "1") {
                    if ($ai != "") {
                        $var(cid_raw_candidate) = $(ai{uri.user});
                    } else if ($hdr(Remote-Party-ID) != "") {
                        $var(cid_rpid_raw) = $hdr(Remote-Party-ID);
                        if ($var(cid_rpid_raw) =~ "sip:") {
                            $var(cid_raw_candidate) = $(var(cid_rpid_raw){re.subst,/.*sip:([^@]+)@.*/\1/});
                        }
                    }
                }
                $var(cid_enforce_mode) = $var(eff_in_cid_mode);
                $var(cid_enforce_custom) = $var(eff_in_cid_custom);
                $var(cid_enforce_forced) = $var(eff_in_cid_forced);
                $var(cid_enforce_candidate) = $var(cid_raw_candidate);
                $var(cid_enforce_pool_type) = "subscriber";
                $var(cid_enforce_pool_key) = $var(from_username) + "@" + $var(from_domain_name);
                route(ENFORCE_CALLERID);
                $dlg_var(effective_caller_id_number) = $var(cid_enforced_number);
                $dlg_var(effective_caller_id_name) = $var(eff_in_cid_name);
            }
        }
        if ($var(subauth_routing_hit) == 0) {
        # SQL fallback -- only reached on a genuine htable miss (sync-
        # staleness window: a subscriber added/changed between sync
        # cycles hasn't reached this node's local cache yet). Kept as
        # a real, working fallback rather than removed -- correctness
        # over speed for the rare case, speed for the common one.
        sql_query("ca", "SELECT sm.routing_profile_id, "
                  "COALESCE(sm.inbound_callerid_name, ds.inbound_callerid_name), "
                  "COALESCE(sm.inbound_callerid_mode, ds.inbound_callerid_mode), "
                  "COALESCE(sm.inbound_callerid_custom_number, ds.inbound_callerid_custom_number), "
                  "COALESCE(sm.inbound_callerid_forced_number, ds.inbound_callerid_forced_number), "
                  "COALESCE(sm.inbound_use_pai_rpid_incoming, ds.inbound_use_pai_rpid_incoming), "
                  "COALESCE(sm.inbound_called_number_source, ds.inbound_called_number_source), "
                  "COALESCE(sm.topoh_mask_inbound, ds.topoh_mask_inbound) "
                  "FROM domain_settings ds LEFT JOIN subscriber_meta sm "
                  "ON sm.username = '$var(from_username)' AND sm.domain_name = '$var(from_domain_name)' "
                  "WHERE ds.domain_name = '$var(from_domain_name)'", "um");
        if ($dbr(um=>rows) > 0) {
            if ($dbr(um=>[0,0]) != $null) { $var(profile_id) = $dbr(um=>[0,0]); }
            # Safe defaults first -- direct $dbr() assignment without
            # this guard silently produces the literal string "0" when
            # the underlying SQL value is NULL, confirmed live (same
            # class of bug as $au defaulting to "0" when unauthenticated,
            # fixed earlier this session). Caught here because it fed
            # straight into a live From header display name ("0"
            # showing up as the caller's name instead of being omitted).
            $var(eff_in_cid_name) = "";
            $var(eff_in_cid_mode) = "allow_any";
            $var(eff_in_cid_custom) = "";
            $var(eff_in_cid_forced) = "";
            $var(eff_in_pai_rpid) = "0";
            $var(eff_in_called_source) = "request_uri";
            if ($dbr(um=>[0,1]) != $null) { $var(eff_in_cid_name) = $dbr(um=>[0,1]); }
            if ($dbr(um=>[0,2]) != $null) { $var(eff_in_cid_mode) = $dbr(um=>[0,2]); }
            if ($dbr(um=>[0,3]) != $null) { $var(eff_in_cid_custom) = $dbr(um=>[0,3]); }
            if ($dbr(um=>[0,4]) != $null) { $var(eff_in_cid_forced) = $dbr(um=>[0,4]); }
            if ($dbr(um=>[0,5]) != $null) { $var(eff_in_pai_rpid) = $dbr(um=>[0,5]); }
            if ($dbr(um=>[0,6]) != $null) { $var(eff_in_called_source) = $dbr(um=>[0,6]); }
            route(EXTRACT_CALLED_NUMBER);

            # Caller-ID re-extraction + re-enforcement -- the first
            # pass in route[INVITE] ran with only safe "allow any"
            # defaults (see that route's own comment on why: the real
            # per-subscriber values aren't resolvable until this exact
            # point). Now that they are, re-extract the raw candidate
            # (PAI/RPID preference may have changed from the earlier
            # default) and re-run enforcement to correct
            # $dlg_var(effective_caller_id_number/name) with the real,
            # per-subscriber-correct result.
            $var(cid_raw_candidate) = $fU;
            if ($var(eff_in_pai_rpid) == "1") {
                if ($ai != "") {
                    $var(cid_raw_candidate) = $(ai{uri.user});
                } else if ($hdr(Remote-Party-ID) != "") {
                    $var(cid_rpid_raw) = $hdr(Remote-Party-ID);
                    if ($var(cid_rpid_raw) =~ "sip:") {
                        $var(cid_raw_candidate) = $(var(cid_rpid_raw){re.subst,/.*sip:([^@]+)@.*/\1/});
                    }
                }
            }
            $var(cid_enforce_mode) = $var(eff_in_cid_mode);
            $var(cid_enforce_custom) = $var(eff_in_cid_custom);
            $var(cid_enforce_forced) = $var(eff_in_cid_forced);
            $var(cid_enforce_candidate) = $var(cid_raw_candidate);
            $var(cid_enforce_pool_type) = "subscriber";
            $var(cid_enforce_pool_key) = $var(from_username) + "@" + $var(from_domain_name);
            route(ENFORCE_CALLERID);
            $dlg_var(effective_caller_id_number) = $var(cid_enforced_number);
            $dlg_var(effective_caller_id_name) = $var(eff_in_cid_name);

            # topoh_mask_toward_caller was already set once in
            # route[INVITE] (domain-only, before this subscriber's
            # identity was resolvable) -- overridden here now that a
            # per-subscriber override (if any) is known. dlg_manage()
            # has already run by this point (route[LOOKUP_PROFILE] is
            # only reached after it), so the dlg_var is directly
            # writable here.
            $dlg_var(topoh_mask_toward_caller) = $dbr(um=>[0,7]);
        }
        }
        sql_result_free("um");

        if ($var(recv_profile_id) != $null && $var(recv_profile_id) != "0") {
            # Media profile follows the same junction-override-else-
            # SIP-Profile-default resolution already baked in by
            # sync-routing.py -- one query gets both routing and media.
            $var(spd_val) = $sht(sip_profile_domains=>$var(recv_profile_id):$var(from_domain_name));
            if ($var(spd_val) != $null && $var(spd_val) != "") {
                $var(spd_routing_id) = $(var(spd_val){s.select,0,|});
                $var(spd_media_id) = $(var(spd_val){s.select,1,|});
                if ($var(profile_id) == 0 && $var(spd_routing_id) != "") { $var(profile_id) = $var(spd_routing_id); }
                if ($var(spd_media_id) == "") { $var(spd_media_id) = "0"; }
                $var(inbound_media_profile_id) = $var(spd_media_id);
            }
        }
        return;
    }

    # Stage 3 -- retired as a separate SQL-query mechanism. Call 2
    # (trunk_ip_identity) fully replaces it: ACL entries are now
    # pre-expanded into individual IPs at sync time (the /28 cap that
    # makes this practical), so there is no CIDR range left to test at
    # runtime via is_in_subnet() -- a direct htable lookup on the exact
    # source IP is both simpler and faster than the SQL query + loop
    # this used to be.
    $var(tic_val) = $sht(trunk_ip_identity=>$Ri:$Rp:$si);
    if ($var(tic_val) != $null && $var(tic_val) != "") {
        $var(profile_id) = $(var(tic_val){s.select,3,|});
        $var(inbound_media_profile_id) = $(var(tic_val){s.select,4,|});
        $var(src_trunk_name) = $(var(tic_val){s.select,1,|});
    }
}

# ── Variable placeholder substitution for admin-authored header
#    templates (platform_trunk_custom_headers.header_line /
#    platform_domain_custom_headers.header_line). Confirmed this
#    session: raw Kamailio pv syntax ($rU, $dlg_var(...) etc) typed
#    directly into a database-sourced string is NOT evaluated by
#    Kamailio -- only pv syntax hardcoded in the .cfg source itself
#    gets resolved. So substitution happens here explicitly, matching
#    ${placeholder} tokens against the 16 known catalog entries and
#    replacing each with its real, already-resolved value via a
#    chained re.subst -- confirmed via direct testing earlier this
#    session that chaining multiple re.subst transforms in sequence
#    works correctly. $null-guarded per placeholder since several
#    (outbound_trunk_id/name, inbound_trunk_id/name, etc) are only
#    ever set for one call direction or the other, never both. ──
# ── Response-reason customization -- node-level override of the
#    reason phrase used in script-generated rejections, resolved via
#    the preloaded response_reasons htable (catalog default, or a
#    node-level override -- both already resolved at sync time, this
#    is just the lookup). Falls back to the literal default passed in
#    if the htable entry is missing for any reason. ──
route[RESP_REASON] {
    $var(rr_effective) = $sht(response_reasons=>$var(rr_key));
    # Confirmed via direct testing against the real binary: same root
    # cause as the $dlg_var() discovery elsewhere in this file -- a
    # missing htable key reads back as the literal string "0", not
    # $null. None of the 14 real default reason texts are ever
    # legitimately "0", so this string comparison is a safe guard.
    if ($var(rr_effective) == $null || $var(rr_effective) == "0") {
        $var(rr_effective) = $var(rr_default);
    }
}

route[APPLY_HEADER_VARS] {
    # Confirmed via direct testing against the real binary: an unset
    # $dlg_var() reads back as the literal string "0", NOT $null -- a
    # "== $null" guard here would silently never trigger, leaking a
    # bare "0" into the header wherever the placeholder was actually
    # meant to resolve to empty. None of these 16 sources are ever a
    # legitimately real "0" value (IDs start at 1, the rest are names/
    # usernames), so the string comparison below is a safe guard.
    $var(ph_call_id) = $ci;
    $var(ph_original_called) = $dlg_var(original_called);
    if ($var(ph_original_called) == "0") { $var(ph_original_called) = ""; }
    $var(ph_original_calling) = $dlg_var(original_calling);
    if ($var(ph_original_calling) == "0") { $var(ph_original_calling) = ""; }
    $var(ph_effective_caller_id_number) = $dlg_var(effective_caller_id_number);
    if ($var(ph_effective_caller_id_number) == "0") { $var(ph_effective_caller_id_number) = ""; }
    $var(ph_effective_caller_id_name) = $dlg_var(effective_caller_id_name);
    if ($var(ph_effective_caller_id_name) == "0") { $var(ph_effective_caller_id_name) = ""; }
    $var(ph_inbound_trunk_id) = $dlg_var(inbound_trunk_id);
    if ($var(ph_inbound_trunk_id) == "0") { $var(ph_inbound_trunk_id) = ""; }
    $var(ph_inbound_trunk_name) = $dlg_var(inbound_trunk_name);
    if ($var(ph_inbound_trunk_name) == "0") { $var(ph_inbound_trunk_name) = ""; }
    $var(ph_inbound_subscriber) = $dlg_var(inbound_subscriber);
    if ($var(ph_inbound_subscriber) == "0") { $var(ph_inbound_subscriber) = ""; }
    $var(ph_inbound_domain_id) = $dlg_var(inbound_domain_id);
    if ($var(ph_inbound_domain_id) == "0") { $var(ph_inbound_domain_id) = ""; }
    $var(ph_inbound_sip_profile_id) = $dlg_var(inbound_sip_profile_id);
    if ($var(ph_inbound_sip_profile_id) == "0") { $var(ph_inbound_sip_profile_id) = ""; }
    $var(ph_outbound_trunk_id) = $dlg_var(outbound_trunk_id);
    if ($var(ph_outbound_trunk_id) == "0") { $var(ph_outbound_trunk_id) = ""; }
    $var(ph_outbound_trunk_name) = $dlg_var(outbound_trunk_name);
    if ($var(ph_outbound_trunk_name) == "0") { $var(ph_outbound_trunk_name) = ""; }
    $var(ph_outbound_subscriber) = $dlg_var(outbound_subscriber);
    if ($var(ph_outbound_subscriber) == "0") { $var(ph_outbound_subscriber) = ""; }
    $var(ph_outbound_domain_id) = $dlg_var(outbound_domain_id);
    if ($var(ph_outbound_domain_id) == "0") { $var(ph_outbound_domain_id) = ""; }
    $var(ph_outbound_sip_profile_id) = $dlg_var(outbound_sip_profile_id);
    if ($var(ph_outbound_sip_profile_id) == "0") { $var(ph_outbound_sip_profile_id) = ""; }
    $var(ph_node_id) = $avp(cdr_node_id);
    if ($var(ph_node_id) == "0") { $var(ph_node_id) = ""; }

    $var(hdr_template_out) = $(var(hdr_template_in){re.subst,/\$\{call_id\}/$var(ph_call_id)/g}{re.subst,/\$\{original_called\}/$var(ph_original_called)/g}{re.subst,/\$\{original_calling\}/$var(ph_original_calling)/g}{re.subst,/\$\{effective_caller_id_number\}/$var(ph_effective_caller_id_number)/g}{re.subst,/\$\{effective_caller_id_name\}/$var(ph_effective_caller_id_name)/g}{re.subst,/\$\{inbound_trunk_id\}/$var(ph_inbound_trunk_id)/g}{re.subst,/\$\{inbound_trunk_name\}/$var(ph_inbound_trunk_name)/g}{re.subst,/\$\{inbound_subscriber\}/$var(ph_inbound_subscriber)/g}{re.subst,/\$\{inbound_domain_id\}/$var(ph_inbound_domain_id)/g}{re.subst,/\$\{inbound_sip_profile_id\}/$var(ph_inbound_sip_profile_id)/g}{re.subst,/\$\{outbound_trunk_id\}/$var(ph_outbound_trunk_id)/g}{re.subst,/\$\{outbound_trunk_name\}/$var(ph_outbound_trunk_name)/g}{re.subst,/\$\{outbound_subscriber\}/$var(ph_outbound_subscriber)/g}{re.subst,/\$\{outbound_domain_id\}/$var(ph_outbound_domain_id)/g}{re.subst,/\$\{outbound_sip_profile_id\}/$var(ph_outbound_sip_profile_id)/g}{re.subst,/\$\{node_id\}/$var(ph_node_id)/g});
}


# ── Try longest-prefix match within a specific profile, caller-
#    aware. A DID is just a full-length prefix row -- no separate
#    step needed, it naturally wins via LENGTH(prefix) DESC. Only
#    considers rows with a real destination (trunk/group/user) --
#    monitoring-only rows (trace/record tag, no destination) are
#    deliberately excluded from the routing decision itself; see the
#    NOTE below HANDLE_CALL for why their activation isn't wired in
#    yet. ──
# ── Looks up the profile's engine_type (fixed per profile, per the
#    finalized design) and dispatches to the matching TRY_* route.
#    Used for both the initial profile attempt and any fallback
#    attempt in HANDLE_CALL, since a fallback profile can have a
#    different engine_type than the one that fell through to it. ────
route[TRY_PROFILE_DISPATCH] {
    # Same profile already resolved via the subscriber_auth htable
    # lookup in route[LOOKUP_PROFILE] -- $var(engine_type) is already
    # correct in that case, skip the SQL query entirely. Only a
    # genuinely different (fallback) profile needs the query below,
    # since no cached data exists for an arbitrary fallback_profile_id.
    if (!($var(try_profile) == $var(profile_id) && $var(engine_type) != $null && $var(engine_type) != "")) {
        $var(engine_type) = "prefix";
        $var(bridge_segment) = "";
        $var(rpm_val) = $sht(routing_profile_meta=>$var(try_profile));
        if ($var(rpm_val) != $null && $var(rpm_val) != "") {
            $var(rpm_engine_type) = $(var(rpm_val){s.select,0,|});
            if ($var(rpm_engine_type) != $null && $var(rpm_engine_type) != "") {
                $var(engine_type) = $var(rpm_engine_type);
            }
            if ($var(engine_type) == "bridge") {
                $var(bridge_segment) = $(var(rpm_val){s.select,14,|});
            }
        }
    }

    if ($var(engine_type) == "prefix") {
        route(TRY_PREFIX_IN_PROFILE);
    } else if ($var(engine_type) == "regex") {
        route(TRY_REGEX_IN_PROFILE);
    } else if ($var(engine_type) == "subscriber_lookup") {
        route(TRY_SUBSCRIBER_LOOKUP_IN_PROFILE);
    } else if ($var(engine_type) == "lcr") {
        route(TRY_LCR_IN_PROFILE);
    } else if ($var(engine_type) == "arithmetic") {
        route(TRY_ARITHMETIC_IN_PROFILE);
    } else if ($var(engine_type) == "bridge") {
        route(TRY_BRIDGE_IN_PROFILE);
    } else if ($var(engine_type) == "blocklist") {
        route(TRY_BLOCKLIST_IN_PROFILE);
    }
}

# ── lcr engine: load_gws() finds matching gateways for this LCR
#    instance (lcr_id = this platform's routing_profile id, reused
#    directly), next_gw() picks the first one in cost order and
#    rewrites $rU/$du accordingly. Return codes confirmed from the
#    module's own docs: 1 = at least one match, 2 = no match (not an
#    error -- just nothing to try). match_kind="lcr" signals
#    HANDLE_CALL to skip the dispatcher-based trunk-selection path
#    entirely below, since next_gw() already resolved the real
#    destination directly. ──────────────────────────────────────────
route[TRY_LCR_IN_PROFILE] {
    # Confirmed via extensive isolated testing this session: load_gws()'s
    # arguments must be direct, unquoted PVs -- embedding them inside a
    # quoted string (e.g. "$rU" instead of $rU) causes this to silently
    # return 2 (no match) instead of 1, with no error at all, even
    # though the exact same data matches correctly via the module's own
    # RPC (lcr.load_gws) and with literal argument values. A genuine,
    # undocumented quirk specific to this function -- normal Kamailio
    # PV-in-string interpolation (used everywhere else in this file,
    # e.g. sql_query()) does not apply here.
    if (load_gws($var(try_profile), $rU, $fU) == 1) {
        if (next_gw()) {
            $var(matched) = 1;
            $var(match_kind) = "lcr";
            $avp(lcr_active_lcr_id) = $var(try_profile);
            $dlg_var(lcr_active) = "1";
            xlog("L_DBG", "$ci: [lcr match] profile=$var(try_profile) -> ru=$ru du=$du (cost-ordered gateway selected)\n");
        }
    } else {
        xlog("L_DBG", "$ci: [lcr match] profile=$var(try_profile) ru=$ru -> no lcr gateway matched\n");
    }
}

route[TRY_PREFIX_IN_PROFILE] {
    sql_query("ca", "SELECT trunk_setid, strip_digits, prepend_digits, caller_strip_digits, caller_prepend_digits, failover_setid, dest_username, dest_domain, friendly_name, trace_enabled, record_enabled, COALESCE(media_profile_id, 0), jump_to_routing_profile_id, forced_called_number, forced_calling_number FROM route_prefixes WHERE profile_id = $var(try_profile) AND (trunk_setid IS NOT NULL OR (dest_username IS NOT NULL AND dest_username != '') OR jump_to_routing_profile_id IS NOT NULL) AND '$(rU{s.escape.common})' LIKE (prefix || '%') AND (caller_prefix IS NULL OR '$(dlg_var(effective_caller_id_number){s.escape.common})' LIKE (caller_prefix || '%')) ORDER BY LENGTH(COALESCE(caller_prefix,'')) DESC, LENGTH(prefix) DESC, priority ASC LIMIT 1", "ro");
    if ($dbr(ro=>rows) > 0) {
        $var(matched) = 1;
        $var(target_setid) = $dbr(ro=>[0,0]);
        $var(strip) = $dbr(ro=>[0,1]);
        $var(prepend) = $dbr(ro=>[0,2]);
        $var(caller_strip) = $dbr(ro=>[0,3]);
        $var(caller_prepend) = $dbr(ro=>[0,4]);
        $var(failover_setid) = $dbr(ro=>[0,5]);
        $var(dest_username) = $dbr(ro=>[0,6]);
        $var(dest_domain) = $dbr(ro=>[0,7]);
        $var(rule_name) = $dbr(ro=>[0,8]);
        $var(rule_trace) = $dbr(ro=>[0,9]);
        $var(rule_record) = $dbr(ro=>[0,10]);
        $var(outbound_media_profile_id) = $dbr(ro=>[0,11]);
        $var(jump_target) = $dbr(ro=>[0,12]);
        $var(forced_called_number) = $dbr(ro=>[0,13]);
        $var(forced_calling_number) = $dbr(ro=>[0,14]);
        $var(match_kind) = "prefix";
        xlog("L_DBG", "$ci: [prefix match] profile=$var(try_profile) rule=\"$var(rule_name)\" ru=$ru -> setid=$var(target_setid) strip=$var(strip) prepend=\"$var(prepend)\" dest_user=\"$var(dest_username)\" jump=$var(jump_target)\n");
    } else {
        xlog("L_DBG", "$ci: [prefix match] profile=$var(try_profile) ru=$ru -> no prefix rule matched\n");
    }
    sql_result_free("ro");
}

# ── Try regex rules within a specific profile, caller-aware.
#    Caller-constrained rules tried before caller-unconstrained ones
#    (same tiering as prefix), priority as the tie-break within each
#    group. Only considers rows with a real destination -- see the
#    same monitoring-only note as TRY_PREFIX_IN_PROFILE. ──
# ── Monitoring-only rules: a rule can exist purely to tag trace/
#    record for matching calls with no destination at all -- checked
#    independently of the destination-matching queries above so it
#    never competes with (or gets skipped because of) a real routing
#    decision. Aggregates across every matching row via MAX(), so
#    multiple monitoring rules matching the same call all contribute.
#    NOTE: this only computes the decision ($var(monitor_trace)/
#    $var(monitor_record)) -- see the NOTE at the bottom of
#    HANDLE_CALL for why nothing acts on it yet. ──
route[CHECK_MONITORING_RULES] {
    $var(monitor_trace) = 0;
    $var(monitor_record) = 0;
    sql_query("ca", "SELECT MAX(trace_enabled), MAX(record_enabled) FROM route_prefixes WHERE profile_id = $var(try_profile) AND '$(rU{s.escape.common})' LIKE (prefix || '%') AND (caller_prefix IS NULL OR '$(dlg_var(effective_caller_id_number){s.escape.common})' LIKE (caller_prefix || '%')) AND (trace_enabled=1 OR record_enabled=1)", "mp");
    if ($dbr(mp=>rows) > 0) {
        if ($dbr(mp=>[0,0]) == 1) { $var(monitor_trace) = 1; }
        if ($dbr(mp=>[0,1]) == 1) { $var(monitor_record) = 1; }
    }
    sql_result_free("mp");
    sql_query("ca", "SELECT pattern, trace_enabled, record_enabled FROM route_regex WHERE profile_id = $var(try_profile) AND (trace_enabled=1 OR record_enabled=1)", "mr");
    $var(mr_rows) = $dbr(mr=>rows);
    $var(mr_i) = 0;
    while ($var(mr_i) < $var(mr_rows)) {
        $var(mr_pattern) = $dbr(mr=>[$var(mr_i),0]);
        if ($rU =~ $var(mr_pattern)) {
            if ($dbr(mr=>[$var(mr_i),1]) == 1) { $var(monitor_trace) = 1; }
            if ($dbr(mr=>[$var(mr_i),2]) == 1) { $var(monitor_record) = 1; }
        }
        $var(mr_i) = $var(mr_i) + 1;
    }
    sql_result_free("mr");
}

# ── subscriber_lookup engine: O(1) htable lookup instead of SQL,
#    for the bulk-import/scale case confirmed as the actual reason
#    this engine type exists (route_prefixes' dest_subscriber_id
#    already does the same job at smaller scale). $sht() returns
#    $null on a miss, not empty string -- checked explicitly with
#    sht_is_null() rather than a plain string comparison, since an
#    empty-string comparison against $null doesn't reliably mean
#    "not found" in Kamailio's PV semantics. ──────────────────────
route[TRY_SUBSCRIBER_LOOKUP_IN_PROFILE] {
    if ($sht(subscriber_numbers=>$rU) != $null) {
        $var(resolved) = $sht(subscriber_numbers=>$rU);
        $var(dest_username) = $(var(resolved){s.select,0,@});
        # value is "username@domain|number_type" -- select the @-delimited
        # domain part, then strip the |number_type suffix off it. Number
        # type isn't consulted here (this route resolves an inbound DID
        # to its owning subscriber for call routing, unrelated to
        # whether that DID is later eligible as an outbound caller ID),
        # but the suffix must still be stripped or it corrupts dest_domain.
        $var(dest_domain) = $(var(resolved){s.select,1,@}{s.select,0,|});
        if ($var(dest_domain) != "") {
            $var(matched) = 1;
            $var(match_kind) = "subscriber_lookup";
            $var(target_setid) = 0;
            $var(strip) = 0;
            $var(prepend) = "";
            $var(failover_setid) = 0;
            $var(rule_trace) = 0;
            $var(rule_record) = 0;
            $var(outbound_media_profile_id) = 0;
        }
    }
}

# ── Extracts one short-key field's value from a bridge_segment
#    string (comma-delimited key=value pairs, sparse -- a field
#    absent from the segment means it was never set on the profile).
#    Input: $var(bf_segment), $var(bf_key). Output: $var(bf_value)
#    (empty string if the key isn't present at all). Bounded loop
#    (35 iterations -- comfortably above the ~34 possible fields in
#    the full bridge segment shape) rather than an unbounded while,
#    since s.select returns empty/unchanged past the real field
#    count rather than erroring, so a fixed bound is both safe and
#    simpler than trying to first count the real number of pairs. ──
route[BRIDGE_EXTRACT_FIELD] {
    $var(bf_value) = "";
    $var(bf_i) = 0;
    $var(bf_found) = 0;
    while ($var(bf_i) < 35 && $var(bf_found) == 0) {
        $var(bf_pair) = $(var(bf_segment){s.select,$var(bf_i),,});
        if ($var(bf_pair) == "") {
            $var(bf_i) = 35;
        } else {
            $var(bf_pair_key) = $(var(bf_pair){s.select,0,=});
            if ($var(bf_pair_key) == $var(bf_key)) {
                $var(bf_value) = $(var(bf_pair){s.select,1,=});
                $var(bf_found) = 1;
            }
        }
        $var(bf_i) = $var(bf_i) + 1;
    }
}

# ── Normalizes ONE number to the configured target format. Input:
#    $var(bn_number), $var(bn_prefix) ("cd"/"cg"). Output:
#    $var(bn_number) (mutated in place). Reference fields (home
#    country code/area code, national trunk prefix, international
#    prefix, target format, plus mode) extracted from the same
#    bridge_segment via BRIDGE_EXTRACT_FIELD. A pragmatic, clearly-
#    scoped algorithm, not an exhaustive international numbering-plan
#    implementation:
#      1. Detect current form and reduce to a canonical
#         country_code + national_number, by checking (in order) for
#         a leading "+", a leading international_prefix (e.g. "00"),
#         a leading national_trunk_prefix (e.g. "0"), or neither
#         (already bare). Only strips home_country_code specifically
#         when recognized as a prefix after "+"/international_prefix
#         -- an unrecognized leading country code is left as part of
#         national_number rather than guessed at.
#      2. Reconstruct per target_format: e164_plus/e164_no_plus always
#         use country_code+national_number; national/local use
#         national_trunk_prefix+national_number when the number is
#         domestic (country_code == home_country_code), falling back
#         to the international form for anything not recognized as
#         domestic (no way to guess a foreign trunk prefix); local
#         additionally strips home_area_code from the front of
#         national_number if present.
#      3. plus_mode is an independent override applied last -- "add"
#         forces a leading "+" regardless of target_format's own
#         default, "strip" forces none, "unchanged" leaves whatever
#         step 2 produced. ──
route[BRIDGE_NORMALIZE_NUMBER] {
    $var(bf_key) = $var(bn_prefix) + "cc"; route(BRIDGE_EXTRACT_FIELD); $var(bn_home_cc) = $var(bf_value);
    $var(bf_key) = $var(bn_prefix) + "ac"; route(BRIDGE_EXTRACT_FIELD); $var(bn_home_ac) = $var(bf_value);
    $var(bf_key) = $var(bn_prefix) + "tp"; route(BRIDGE_EXTRACT_FIELD); $var(bn_trunk_prefix) = $var(bf_value);
    $var(bf_key) = $var(bn_prefix) + "ip"; route(BRIDGE_EXTRACT_FIELD); $var(bn_intl_prefix) = $var(bf_value);
    $var(bf_key) = $var(bn_prefix) + "fmt"; route(BRIDGE_EXTRACT_FIELD); $var(bn_target_fmt) = $var(bf_value);
    $var(bf_key) = $var(bn_prefix) + "pl"; route(BRIDGE_EXTRACT_FIELD); $var(bn_plus_mode) = $var(bf_value);

    # Nothing configured at all -- no reference data to normalize
    # against, leave the number untouched rather than guessing.
    if ($var(bn_home_cc) == "" || $var(bn_target_fmt) == "") {
        return;
    }

    # Step 1 -- reduce to canonical country_code + national_number.
    $var(bn_cc) = $var(bn_home_cc);
    $var(bn_is_domestic) = 1;
    $var(bn_working) = $var(bn_number);
    $var(bn_working_len) = $(var(bn_working){s.len});
    $var(bn_was_international) = 0;
    if ($(var(bn_working){s.substr,0,1}) == "+") {
        $var(bn_working) = $(var(bn_working){s.substr,1,0});
        $var(bn_was_international) = 1;
    } else if ($var(bn_intl_prefix) != "") {
        $var(bn_intl_len) = $(var(bn_intl_prefix){s.len});
        $var(bn_intl_len_i) = $(var(bn_intl_len){s.int});
        if ($(var(bn_working){s.substr,0,$var(bn_intl_len_i)}) == $var(bn_intl_prefix)) {
            $var(bn_working) = $(var(bn_working){s.substr,$var(bn_intl_len_i),0});
            $var(bn_was_international) = 1;
        }
    }
    if ($var(bn_was_international) == 1) {
        # Number was ACTUALLY in international form (confirmed match
        # above, not just "a prefix is configured") -- check whether
        # it starts with our home country code specifically.
        $var(bn_cc_len) = $(var(bn_home_cc){s.len});
        $var(bn_cc_len_i) = $(var(bn_cc_len){s.int});
        if ($(var(bn_working){s.substr,0,$var(bn_cc_len_i)}) == $var(bn_home_cc)) {
            $var(bn_national) = $(var(bn_working){s.substr,$var(bn_cc_len_i),0});
            $var(bn_cc) = $var(bn_home_cc);
            $var(bn_is_domestic) = 1;
        } else {
            # Foreign country code -- don't guess where it ends,
            # keep the whole remainder as-is under an unknown cc.
            $var(bn_national) = $var(bn_working);
            $var(bn_cc) = "";
            $var(bn_is_domestic) = 0;
        }
    } else if ($var(bn_trunk_prefix) != "" && $(var(bn_working){s.substr,0,1}) == $(var(bn_trunk_prefix){s.substr,0,1}) && $(var(bn_working){s.substr,0,$(var(bn_trunk_prefix){s.len})}) == $var(bn_trunk_prefix)) {
        $var(bn_tp_len) = $(var(bn_trunk_prefix){s.len});
        $var(bn_tp_len_i) = $(var(bn_tp_len){s.int});
        $var(bn_national) = $(var(bn_working){s.substr,$var(bn_tp_len_i),0});
    } else {
        # No recognizable prefix at all -- already bare national/
        # subscriber format.
        $var(bn_national) = $var(bn_working);
    }

    # Step 2 -- reconstruct per target_format.
    if ($var(bn_target_fmt) == "e164_plus") {
        $var(bn_number) = "+" + $var(bn_cc) + $var(bn_national);
    } else if ($var(bn_target_fmt) == "e164_no_plus") {
        $var(bn_number) = $var(bn_cc) + $var(bn_national);
    } else if ($var(bn_target_fmt) == "national" || $var(bn_target_fmt) == "local") {
        $var(bn_local_national) = $var(bn_national);
        if ($var(bn_target_fmt) == "local" && $var(bn_home_ac) != "") {
            $var(bn_ac_len) = $(var(bn_home_ac){s.len});
            $var(bn_ac_len_i) = $(var(bn_ac_len){s.int});
            if ($(var(bn_local_national){s.substr,0,$var(bn_ac_len_i)}) == $var(bn_home_ac)) {
                $var(bn_local_national) = $(var(bn_local_national){s.substr,$var(bn_ac_len_i),0});
            }
        }
        if ($var(bn_is_domestic) == 1) {
            $var(bn_number) = $var(bn_trunk_prefix) + $var(bn_local_national);
        } else {
            # Can't produce a national form for a foreign number --
            # fall back to international form rather than guess.
            $var(bn_number) = $var(bn_intl_prefix) + $var(bn_cc) + $var(bn_national);
        }
    }

    # Step 3 -- plus_mode override, independent of target_format.
    if ($var(bn_plus_mode) == "add") {
        if ($(var(bn_number){s.substr,0,1}) != "+") {
            $var(bn_number) = "+" + $var(bn_number);
        }
    } else if ($var(bn_plus_mode) == "strip") {
        if ($(var(bn_number){s.substr,0,1}) == "+") {
            $var(bn_number) = $(var(bn_number){s.substr,1,0});
        }
    }
}

# ── Applies the finalized 8-step Bridge number-manipulation pipeline
#    to ONE number (called or calling, called independently for
#    each). Input: $var(bn_number) (the number to transform),
#    $var(bn_prefix) ("cd" or "cg", selects which half of the bridge
#    segment's fields apply). Output: $var(bn_number) (mutated in
#    place). Order, confirmed and finalized this session: forced
#    override (handled by the CALLER before invoking this route at
#    all, not here -- forced is an absolute bypass of the entire
#    pipeline, not one more step within it) -> pre-normalize ->
#    strip_digits -> strip_last_digits -> retain_last_digits ->
#    prepend_digits -> append_suffix -> post-normalize. ──
route[BRIDGE_APPLY_NUMBER_PIPELINE] {
    $var(bf_key) = $var(bn_prefix) + "pr"; route(BRIDGE_EXTRACT_FIELD); $var(bn_pre_normalize) = $var(bf_value);
    $var(bf_key) = $var(bn_prefix) + "s"; route(BRIDGE_EXTRACT_FIELD); $var(bn_strip) = $var(bf_value);
    $var(bf_key) = $var(bn_prefix) + "sl"; route(BRIDGE_EXTRACT_FIELD); $var(bn_strip_last) = $var(bf_value);
    $var(bf_key) = $var(bn_prefix) + "rl"; route(BRIDGE_EXTRACT_FIELD); $var(bn_retain_last) = $var(bf_value);
    $var(bf_key) = $var(bn_prefix) + "p"; route(BRIDGE_EXTRACT_FIELD); $var(bn_prepend) = $var(bf_value);
    $var(bf_key) = $var(bn_prefix) + "x"; route(BRIDGE_EXTRACT_FIELD); $var(bn_suffix) = $var(bf_value);
    $var(bf_key) = $var(bn_prefix) + "po"; route(BRIDGE_EXTRACT_FIELD); $var(bn_post_normalize) = $var(bf_value);

    if ($var(bn_pre_normalize) == "1") {
        route(BRIDGE_NORMALIZE_NUMBER);
    }

    # NOTE: bn_strip/bn_strip_last/bn_retain_last are extracted as
    # STRING-typed values (via BRIDGE_EXTRACT_FIELD's s.select-based
    # parsing). Confirmed via direct live testing this session: a
    # string-typed PV that merely contains digits (e.g. "2") CANNOT
    # be used directly as an {s.substr} offset/length parameter, or
    # in arithmetic with an integer -- {s.substr} silently produces
    # wrong output (not an error) rather than failing loudly, and
    # string+int performs CONCATENATION ("2"+0 => "20"), not numeric
    # addition. {s.int} is the confirmed, tested fix -- explicitly
    # converts to a genuine integer-typed PV before any such use.
    if ($var(bn_strip) != "") {
        $var(bn_strip_i) = $(var(bn_strip){s.int});
        $var(bn_number) = $(var(bn_number){s.substr,$var(bn_strip_i),0});
    }
    if ($var(bn_strip_last) != "") {
        $var(bn_strip_last_i) = $(var(bn_strip_last){s.int});
        $var(bn_len) = $(var(bn_number){s.len});
        $var(bn_keep) = $var(bn_len) - $var(bn_strip_last_i);
        if ($var(bn_keep) > 0) {
            $var(bn_number) = $(var(bn_number){s.substr,0,$var(bn_keep)});
        } else {
            $var(bn_number) = "";
        }
    }
    if ($var(bn_retain_last) != "") {
        $var(bn_retain_last_i) = $(var(bn_retain_last){s.int});
        $var(bn_len) = $(var(bn_number){s.len});
        if ($var(bn_len) > $var(bn_retain_last_i)) {
            $var(bn_start) = $var(bn_len) - $var(bn_retain_last_i);
            $var(bn_number) = $(var(bn_number){s.substr,$var(bn_start),0});
        }
    }
    if ($var(bn_prepend) != "") {
        $var(bn_number) = $var(bn_prepend) + $var(bn_number);
    }
    if ($var(bn_suffix) != "") {
        $var(bn_number) = $var(bn_number) + $var(bn_suffix);
    }

    if ($var(bn_post_normalize) == "1") {
        route(BRIDGE_NORMALIZE_NUMBER);
    }
}

# ── bridge engine: catch-all, fully in-memory, zero SQL. Always
#    matches (there's only ever one outcome for an unconditional
#    rule) -- the entire routing decision, destination AND number
#    manipulation, resolves from $var(bridge_segment) alone, already
#    extracted for free in route[LOOKUP_PROFILE]'s subscriber_auth
#    htable lookup. ──
route[TRY_BRIDGE_IN_PROFILE] {
    $var(matched) = 1;
    $var(match_kind) = "bridge";
    $var(rule_trace) = 0;
    $var(rule_record) = 0;
    $var(outbound_media_profile_id) = 0;
    $var(strip) = 0;
    $var(prepend) = "";
    $var(failover_setid) = 0;
    $var(target_setid) = 0;
    $var(dest_username) = "";
    $var(dest_domain) = "";

    $var(bf_segment) = $var(bridge_segment);

    # Forced override -- absolute, bypasses the entire pipeline for
    # that number, checked BEFORE any manipulation step, per the
    # finalized design (not "one more step in the pipeline" -- a
    # distinct top-level branch).
    $var(bf_key) = "cdf"; route(BRIDGE_EXTRACT_FIELD); $var(bridge_forced_called) = $var(bf_value);
    $var(bf_key) = "cgf"; route(BRIDGE_EXTRACT_FIELD); $var(bridge_forced_calling) = $var(bf_value);

    if ($var(bridge_forced_called) != "") {
        $rU = $var(bridge_forced_called);
    } else {
        $var(bn_number) = $rU;
        $var(bn_prefix) = "cd";
        route(BRIDGE_APPLY_NUMBER_PIPELINE);
        $rU = $var(bn_number);
    }
    if ($var(bridge_forced_calling) != "") {
        $dlg_var(effective_caller_id_number) = $var(bridge_forced_calling);
    } else {
        $var(bn_number) = $dlg_var(effective_caller_id_number);
        $var(bn_prefix) = "cg";
        route(BRIDGE_APPLY_NUMBER_PIPELINE);
        $dlg_var(effective_caller_id_number) = $var(bn_number);
    }

    # Destination resolution.
    $var(bf_key) = "dt"; route(BRIDGE_EXTRACT_FIELD); $var(bridge_dest_type) = $var(bf_value);
    if ($var(bridge_dest_type) == "trunk") {
        $var(bf_key) = "tr"; route(BRIDGE_EXTRACT_FIELD); $var(target_setid) = $var(bf_value);
        $var(bf_key) = "fo"; route(BRIDGE_EXTRACT_FIELD); $var(failover_setid) = $var(bf_value);
    } else if ($var(bridge_dest_type) == "local_subscriber") {
        $var(bf_key) = "du"; route(BRIDGE_EXTRACT_FIELD); $var(dest_username) = $var(bf_value);
        $var(bf_key) = "dd"; route(BRIDGE_EXTRACT_FIELD); $var(dest_domain) = $var(bf_value);
    } else if ($var(bridge_dest_type) == "jump_profile") {
        $var(bf_key) = "dj"; route(BRIDGE_EXTRACT_FIELD); $var(jump_to_routing_profile_id) = $var(bf_value);
    } else if ($var(bridge_dest_type) == "subscriber_lookup") {
        # Same subscriber_numbers htable lookup already proven in
        # TRY_SUBSCRIBER_LOOKUP_IN_PROFILE -- $rU is already the
        # final, manipulated called number by this point (destination
        # resolution runs after the number pipeline above), so this
        # resolves exactly the number a real call would be routed on.
        if ($sht(subscriber_numbers=>$rU) != $null) {
            $var(bridge_sl_resolved) = $sht(subscriber_numbers=>$rU);
            $var(dest_username) = $(var(bridge_sl_resolved){s.select,0,@});
            $var(dest_domain) = $(var(bridge_sl_resolved){s.select,1,@}{s.select,0,|});
        }
        # No match -- dest_username/dest_domain stay empty, same
        # "unresolved destination" behavior as any other unmatched
        # destination_type, not a special case requiring its own
        # reject handling.
    }

    $var(bf_key) = "tc"; route(BRIDGE_EXTRACT_FIELD); if ($var(bf_value) == "1") { $var(rule_trace) = 1; }
    $var(bf_key) = "rc"; route(BRIDGE_EXTRACT_FIELD); if ($var(bf_value) == "1") { $var(rule_record) = 1; }
    $var(bf_key) = "mp"; route(BRIDGE_EXTRACT_FIELD); if ($var(bf_value) != "") { $var(outbound_media_profile_id) = $var(bf_value); }
}

# ── Evaluates ONE arithmetic condition. Input: $var(ac_field),
#    $var(ac_operator), $var(ac_value). Output: $var(ac_result) (1 or
#    0). called_length/calling_length compare as integers (via
#    {s.int}, per the confirmed fix earlier this session -- string-
#    typed values from parsing cannot be used directly in numeric
#    comparison); called_number/calling_number compare as strings
#    (== and != are the only operators that make real sense for a
#    number's literal value, but all six are technically supported
#    for consistency -- an admin using >/< on a number field gets
#    string/lexicographic comparison, not validated against here). ──
route[ARITHMETIC_EVAL_CONDITION] {
    $var(ac_result) = 0;
    if ($var(ac_field) == "called_length") {
        $var(ac_actual) = $(rU{s.len});
        $var(ac_value_i) = $(var(ac_value){s.int});
        if ($var(ac_operator) == ">=") { if ($var(ac_actual) >= $var(ac_value_i)) { $var(ac_result) = 1; } }
        else if ($var(ac_operator) == "<=") { if ($var(ac_actual) <= $var(ac_value_i)) { $var(ac_result) = 1; } }
        else if ($var(ac_operator) == "==") { if ($var(ac_actual) == $var(ac_value_i)) { $var(ac_result) = 1; } }
        else if ($var(ac_operator) == "!=") { if ($var(ac_actual) != $var(ac_value_i)) { $var(ac_result) = 1; } }
        else if ($var(ac_operator) == ">") { if ($var(ac_actual) > $var(ac_value_i)) { $var(ac_result) = 1; } }
        else if ($var(ac_operator) == "<") { if ($var(ac_actual) < $var(ac_value_i)) { $var(ac_result) = 1; } }
    } else if ($var(ac_field) == "calling_length") {
        $var(ac_actual) = $(dlg_var(effective_caller_id_number){s.len});
        $var(ac_value_i) = $(var(ac_value){s.int});
        if ($var(ac_operator) == ">=") { if ($var(ac_actual) >= $var(ac_value_i)) { $var(ac_result) = 1; } }
        else if ($var(ac_operator) == "<=") { if ($var(ac_actual) <= $var(ac_value_i)) { $var(ac_result) = 1; } }
        else if ($var(ac_operator) == "==") { if ($var(ac_actual) == $var(ac_value_i)) { $var(ac_result) = 1; } }
        else if ($var(ac_operator) == "!=") { if ($var(ac_actual) != $var(ac_value_i)) { $var(ac_result) = 1; } }
        else if ($var(ac_operator) == ">") { if ($var(ac_actual) > $var(ac_value_i)) { $var(ac_result) = 1; } }
        else if ($var(ac_operator) == "<") { if ($var(ac_actual) < $var(ac_value_i)) { $var(ac_result) = 1; } }
    } else if ($var(ac_field) == "called_number") {
        if ($var(ac_operator) == "==") { if ($rU == $var(ac_value)) { $var(ac_result) = 1; } }
        else if ($var(ac_operator) == "!=") { if ($rU != $var(ac_value)) { $var(ac_result) = 1; } }
    } else if ($var(ac_field) == "calling_number") {
        if ($var(ac_operator) == "==") { if ($dlg_var(effective_caller_id_number) == $var(ac_value)) { $var(ac_result) = 1; } }
        else if ($var(ac_operator) == "!=") { if ($dlg_var(effective_caller_id_number) != $var(ac_value)) { $var(ac_result) = 1; } }
    }
}

# ── Evaluates one rule's full condition list against the confirmed
#    match_mode semantics. Input: $var(ar_conditions) (comma-
#    delimited condition strings, each field:operator:value:
#    chain_operator), $var(ar_match_mode). Output: $var(ar_rule_result)
#    (1 or 0). chain mode: STRICT LEFT-TO-RIGHT, NO OPERATOR
#    PRECEDENCE -- confirmed and finalized this session, explicitly
#    NOT standard boolean precedence (AND binding tighter than OR),
#    since the two give genuinely different results for the same
#    rule and left-to-right is simpler to implement/reason about. ──
route[ARITHMETIC_EVAL_RULE] {
    $var(ar_i) = 0;
    $var(ar_rule_result) = -1;
    $var(ar_prev_chain_op) = "";
    while ($var(ar_i) < 5) {
        $var(ar_cond) = $(var(ar_conditions){s.select,$var(ar_i),,});
        if ($var(ar_cond) == "") {
            $var(ar_i) = 5;
        } else {
            $var(ac_field) = $(var(ar_cond){s.select,0,:});
            $var(ac_operator) = $(var(ar_cond){s.select,1,:});
            $var(ac_value) = $(var(ar_cond){s.select,2,:});
            $var(ac_chain_op) = $(var(ar_cond){s.select,3,:});
            route(ARITHMETIC_EVAL_CONDITION);

            if ($var(ar_match_mode) == "match_all") {
                if ($var(ar_rule_result) == -1) { $var(ar_rule_result) = $var(ac_result); }
                else if ($var(ac_result) == 0) { $var(ar_rule_result) = 0; }
            } else if ($var(ar_match_mode) == "match_any") {
                if ($var(ar_rule_result) == -1) { $var(ar_rule_result) = $var(ac_result); }
                else if ($var(ac_result) == 1) { $var(ar_rule_result) = 1; }
            } else {
                # chain: strict left-to-right, no precedence.
                if ($var(ar_rule_result) == -1) {
                    $var(ar_rule_result) = $var(ac_result);
                } else if ($var(ar_prev_chain_op) == "and") {
                    if ($var(ar_rule_result) == 1 && $var(ac_result) == 1) { $var(ar_rule_result) = 1; } else { $var(ar_rule_result) = 0; }
                } else if ($var(ar_prev_chain_op) == "or") {
                    if ($var(ar_rule_result) == 1 || $var(ac_result) == 1) { $var(ar_rule_result) = 1; } else { $var(ar_rule_result) = 0; }
                }
                $var(ar_prev_chain_op) = $var(ac_chain_op);
            }
            $var(ar_i) = $var(ar_i) + 1;
        }
    }
    if ($var(ar_rule_result) == -1) { $var(ar_rule_result) = 0; }
}

# ── arithmetic engine: multi-condition rule chains, fully in-memory
#    (routing_profile_data htable, keyed by routing_profile_id alone
#    -- a second, still fully in-memory lookup during Stage 4 engine
#    dispatch, per the finalized design's decision NOT to unify
#    bridge and arithmetic storage). Rules evaluated in order, first
#    matching rule wins -> its destination. No rule matches -> falls
#    through to fallback_profile_id, same as every other engine
#    type's miss case (handled by the caller, not this route). ──
route[TRY_ARITHMETIC_IN_PROFILE] {
    $var(ar_data) = $sht(routing_profile_data=>$var(try_profile));
    if ($var(ar_data) == $null || $var(ar_data) == "") {
        return;
    }
    $var(ar_rule_i) = 0;
    while ($var(ar_rule_i) < 5 && $var(matched) == 0) {
        $var(ar_rule_full) = $(var(ar_data){s.select,$var(ar_rule_i),;});
        if ($var(ar_rule_full) == "") {
            $var(ar_rule_i) = 5;
        } else {
            $var(ar_match_mode) = $(var(ar_rule_full){s.select,0,|});
            $var(ar_conditions) = $(var(ar_rule_full){s.select,1,|});
            $var(ar_dest) = $(var(ar_rule_full){s.select,2,|});
            route(ARITHMETIC_EVAL_RULE);

            if ($var(ar_rule_result) == 1) {
                $var(matched) = 1;
                $var(match_kind) = "arithmetic";
                $var(rule_trace) = 0;
                $var(rule_record) = 0;
                $var(outbound_media_profile_id) = 0;
                $var(strip) = 0;
                $var(prepend) = "";
                $var(failover_setid) = 0;
                $var(target_setid) = 0;
                $var(dest_username) = "";
                $var(dest_domain) = "";

                $var(ar_dest_type) = $(var(ar_dest){s.select,0,:});
                if ($var(ar_dest_type) == "trunk") {
                    $var(target_setid) = $(var(ar_dest){s.select,1,:});
                    $var(failover_setid) = $(var(ar_dest){s.select,2,:});
                } else if ($var(ar_dest_type) == "local_subscriber") {
                    $var(dest_username) = $(var(ar_dest){s.select,3,:});
                    $var(dest_domain) = $(var(ar_dest){s.select,4,:});
                } else if ($var(ar_dest_type) == "jump_profile") {
                    $var(jump_to_routing_profile_id) = $(var(ar_dest){s.select,5,:});
                }
            }
            $var(ar_rule_i) = $var(ar_rule_i) + 1;
        }
    }
}

# ── Checks ONE number against ONE blocklist. Input: $var(bc_blocklist_id),
#    $var(bc_number), $var(bc_direction) ("called" or "calling", filters
#    entries whose block_on doesn't apply to this direction). Output:
#    $var(bc_matched) (0/1), $var(bc_action), $var(bc_code),
#    $var(bc_reason), $var(bc_divert). Tries an exact match on the full
#    number first, then a bounded, sequential decreasing-length prefix
#    walk (confirmed genuinely feasible for blocklist specifically --
#    unlike the general prefix routing engine, this is a pure
#    membership test with no destination to pick between and no
#    tie-break needed, so trying each length in turn is sufficient,
#    no combinatorial caller_prefix problem the way route_prefixes has). ──
route[BLOCKLIST_CHECK] {
    $var(bc_matched) = 0;
    $var(bc_len) = $(var(bc_number){s.len});
    $var(bc_try_len) = $var(bc_len);
    $var(bc_done) = 0;
    while ($var(bc_try_len) >= 1 && $var(bc_done) == 0) {
        if ($var(bc_try_len) == $var(bc_len)) {
            $var(bc_candidate) = $var(bc_number);
        } else {
            $var(bc_candidate) = $(var(bc_number){s.substr,0,$var(bc_try_len)});
        }
        $var(bc_key) = $var(bc_blocklist_id) + ":" + $var(bc_candidate);
        $var(bc_entry) = $sht(blocklist_entries=>$var(bc_key));
        if ($var(bc_entry) != $null && $var(bc_entry) != "") {
            $var(bc_block_on) = $(var(bc_entry){s.select,4,|});
            $var(bc_block_on) = $(var(bc_block_on){s.select,1,=});
            if ($var(bc_block_on) == $var(bc_direction) || $var(bc_block_on) == "both") {
                $var(bc_action_field) = $(var(bc_entry){s.select,0,|});
                $var(bc_action) = $(var(bc_action_field){s.select,1,=});
                $var(bc_code_field) = $(var(bc_entry){s.select,1,|});
                $var(bc_code) = $(var(bc_code_field){s.select,1,=});
                $var(bc_reason_field) = $(var(bc_entry){s.select,2,|});
                $var(bc_reason) = $(var(bc_reason_field){s.select,1,=});
                $var(bc_divert_field) = $(var(bc_entry){s.select,3,|});
                $var(bc_divert) = $(var(bc_divert_field){s.select,1,=});
                $var(bc_matched) = 1;
                $var(bc_done) = 1;
            }
        }
        $var(bc_try_len) = $var(bc_try_len) - 1;
    }
}

# ── blocklist engine: sequential called/calling check against up to
#    two reusable blocklists, admin-selectable order, short-circuits
#    on first reject -- confirmed explicitly: if the first check
#    rejects, the second blocklist is never even evaluated. divert
#    substitutes the number and falls through to the SAME shared
#    destination as the no-match case; reject is the only outcome
#    needing no destination at all. Profile-level config (check_order,
#    blocklist IDs, destination) queried once per attempt -- not
#    cached in the identity htable the way bridge is, since blocklist
#    profiles are expected to be admin-configured, relatively rare
#    routing types, unlike the common subscriber-routing path bridge
#    optimizes for. ──
route[TRY_BLOCKLIST_IN_PROFILE] {
    $var(rpm_val) = $sht(routing_profile_meta=>$var(try_profile));
    if ($var(rpm_val) == $null || $var(rpm_val) == "") {
        return;
    }
    $var(bl_check_order) = $(var(rpm_val){s.select,5,|});
    $var(bl_called_blocklist_id) = $(var(rpm_val){s.select,6,|});
    $var(bl_calling_blocklist_id) = $(var(rpm_val){s.select,7,|});
    $var(bl_dest_type) = $(var(rpm_val){s.select,8,|});
    $var(bl_dest_trunk_setid) = $(var(rpm_val){s.select,9,|});
    $var(bl_dest_failover_setid) = $(var(rpm_val){s.select,10,|});
    $var(bl_dest_username) = $(var(rpm_val){s.select,11,|});
    $var(bl_dest_domain) = $(var(rpm_val){s.select,12,|});
    $var(bl_dest_jump_profile_id) = $(var(rpm_val){s.select,13,|});

    $var(bl_rejected) = 0;
    if ($var(bl_check_order) == "calling_first") {
        $var(bl_first_dir) = "calling";
        $var(bl_second_dir) = "called";
    } else {
        $var(bl_first_dir) = "called";
        $var(bl_second_dir) = "calling";
    }

    $var(bl_i) = 0;
    while ($var(bl_i) < 2 && $var(bl_rejected) == 0) {
        if ($var(bl_i) == 0) { $var(bl_dir) = $var(bl_first_dir); }
        else { $var(bl_dir) = $var(bl_second_dir); }

        if ($var(bl_dir) == "called") { $var(bl_bl_id) = $var(bl_called_blocklist_id); }
        else { $var(bl_bl_id) = $var(bl_calling_blocklist_id); }

        if ($var(bl_bl_id) != $null && $var(bl_bl_id) != "" && $var(bl_bl_id) != "0") {
            if ($var(bl_dir) == "called") { $var(bc_number) = $rU; }
            else { $var(bc_number) = $dlg_var(effective_caller_id_number); }
            $var(bc_blocklist_id) = $var(bl_bl_id);
            $var(bc_direction) = $var(bl_dir);
            route(BLOCKLIST_CHECK);

            if ($var(bc_matched) == 1) {
                if ($var(bc_action) == "reject") {
                    $var(bl_rejected) = 1;
                    $var(blocklist_reject_code) = $var(bc_code);
                    $var(blocklist_reject_reason) = $var(bc_reason);
                } else if ($var(bc_action) == "divert" && $var(bc_divert) != "") {
                    if ($var(bl_dir) == "called") { $rU = $var(bc_divert); }
                    else { $dlg_var(effective_caller_id_number) = $var(bc_divert); }
                }
            }
        }
        $var(bl_i) = $var(bl_i) + 1;
    }

    if ($var(bl_rejected) == 1) {
        $var(matched) = 1;
        $var(match_kind) = "blocklist_reject";
        $var(blocklist_should_reject) = 1;
    } else {
        $var(matched) = 1;
        $var(match_kind) = "blocklist";
        $var(rule_trace) = 0;
        $var(rule_record) = 0;
        $var(outbound_media_profile_id) = 0;
        $var(strip) = 0;
        $var(prepend) = "";
        $var(failover_setid) = 0;
        $var(target_setid) = 0;
        $var(dest_username) = "";
        $var(dest_domain) = "";

        if ($var(bl_dest_type) == "trunk") {
            $var(target_setid) = $var(bl_dest_trunk_setid);
            $var(failover_setid) = $var(bl_dest_failover_setid);
        } else if ($var(bl_dest_type) == "local_subscriber") {
            $var(dest_username) = $var(bl_dest_username);
            $var(dest_domain) = $var(bl_dest_domain);
        } else if ($var(bl_dest_type) == "jump_profile") {
            $var(jump_to_routing_profile_id) = $var(bl_dest_jump_profile_id);
        }
    }
}

route[TRY_REGEX_IN_PROFILE] {
    sql_query("ca", "SELECT pattern, trunk_setid, strip_digits, prepend_digits, caller_pattern, caller_strip_digits, caller_prepend_digits, dest_username, dest_domain, trace_enabled, record_enabled, COALESCE(media_profile_id, 0), jump_to_routing_profile_id, name FROM route_regex WHERE profile_id = $var(try_profile) AND (trunk_setid IS NOT NULL OR (dest_username IS NOT NULL AND dest_username != '') OR jump_to_routing_profile_id IS NOT NULL) ORDER BY (CASE WHEN caller_pattern IS NOT NULL THEN 0 ELSE 1 END), priority", "rx");
    $var(rx_rows) = $dbr(rx=>rows);
    $var(rx_i) = 0;
    while ($var(rx_i) < $var(rx_rows) && $var(matched) == 0) {
        $var(rx_pattern) = $dbr(rx=>[$var(rx_i),0]);
        $var(rx_caller_pattern) = $dbr(rx=>[$var(rx_i),4]);
        $var(rx_caller_ok) = 1;
        if ($var(rx_caller_pattern) != "" && $var(rx_caller_pattern) != "$null") {
            if (!($dlg_var(effective_caller_id_number) =~ $var(rx_caller_pattern))) { $var(rx_caller_ok) = 0; }
        }
        if ($var(rx_caller_ok) == 1 && $rU =~ $var(rx_pattern)) {
            $var(matched) = 1;
            $var(target_setid) = $dbr(rx=>[$var(rx_i),1]);
            $var(strip) = $dbr(rx=>[$var(rx_i),2]);
            $var(prepend) = $dbr(rx=>[$var(rx_i),3]);
            $var(caller_strip) = $dbr(rx=>[$var(rx_i),5]);
            $var(caller_prepend) = $dbr(rx=>[$var(rx_i),6]);
            $var(dest_username) = $dbr(rx=>[$var(rx_i),7]);
            $var(dest_domain) = $dbr(rx=>[$var(rx_i),8]);
            $var(rule_trace) = $dbr(rx=>[$var(rx_i),9]);
            $var(rule_record) = $dbr(rx=>[$var(rx_i),10]);
            $var(outbound_media_profile_id) = $dbr(rx=>[$var(rx_i),11]);
            $var(jump_target) = $dbr(rx=>[$var(rx_i),12]);
            $var(rule_name) = $dbr(rx=>[$var(rx_i),13]);
            $var(match_kind) = "regex";
            xlog("L_DBG", "$ci: [regex match] profile=$var(try_profile) rule=\"$var(rule_name)\" pattern=\"$var(rx_pattern)\" ru=$ru -> setid=$var(target_setid) strip=$var(strip) prepend=\"$var(prepend)\" dest_user=\"$var(dest_username)\" jump=$var(jump_target)\n");
        }
        $var(rx_i) = $var(rx_i) + 1;
    }
    if ($var(matched) == 0) {
        xlog("L_DBG", "$ci: [regex match] profile=$var(try_profile) ru=$ru -> no regex rule matched ($var(rx_rows) candidates tried)\n");
    }
    sql_result_free("rx");
}

# ── Main orchestration: DID -> prefix -> regex, current profile
#    then fallback profile (if any), then reject ────────────
route[HANDLE_CALL] {
    route(LOOKUP_PROFILE);

    $var(matched) = 0;
    $var(match_kind) = "none";
    $var(try_profile) = $var(profile_id);
    $var(dest_username) = "";
    $var(dest_domain) = "";
    $var(caller_strip) = 0;
    $var(caller_prepend) = "";
    $var(forced_called_number) = "";
    $var(forced_calling_number) = "";
    $var(failover_setid) = 0;
    $var(jump_target) = 0;

    # Source trunk name, for the ROUTE_SUMMARY trunk= field -- captured
    # here, before any matching/rejection logic, so it's available on
    # every exit path including the rejection ones (loop detected, no
    # route found), not just successful destinations. Only meaningful
    # for a trunk-originated (inbound) call; blank for a subscriber-
    # originated one. Matched by looking up $si against dispatcher's
    # own destination (which embeds each trunk's IP), since that's
    # where a trunk's name (description) actually lives on the node
    # side.
    if ($var(route_test_mode) != 1) {
        # Unified source descriptor for ROUTE_SUMMARY. src_trunk_name
        # itself is already resolved earlier, in route[LOOKUP_PROFILE],
        # via the same reliable source_profile table used for routing/
        # media profile resolution -- real gap found and fixed this
        # session: a separate, fragile dispatcher-table lookup by
        # source IP used to live here instead, and could fail to match
        # even when that source_profile lookup already succeeded for
        # the exact same trunk (confirmed on real production calls).
        if ($var(from_user_call) == 1) {
            $var(src_descriptor) = "user:" + $var(from_username) + "@" + $var(from_domain_name);
        } else if ($var(src_trunk_name) != "-") {
            $var(src_descriptor) = "trunk:" + $var(src_trunk_name);
        } else {
            # Matched neither a known subscriber nor a known trunk --
            # src_trunk_name never left its "-" default. Previously
            # this fell through to the trunk branch anyway, mislabeling
            # a genuinely unrecognized source as "trunk:-" (implying a
            # known trunk with just an unresolved name). Source IP
            # included so this is actually investigable.
            $var(src_descriptor) = "unknown:" + $si;
        }
    }

    # Unified loop for both profile-level fallback (fires only when
    # NOTHING in the current plan matches) and rule-level jump (a
    # SPECIFIC matching rule redirects to another plan) -- both
    # advance $var(try_profile) and loop again, sharing one max-hop
    # safeguard. Rule-level jump genuinely needs this: unlike
    # fallback, it isn't constrained to "only on no-match", so an
    # admin misconfiguring two profiles to jump to each other is a
    # real, reachable infinite loop without a hard limit here -- same
    # principle as SIP's own Max-Forwards.
    $var(hop_count) = 0;
    $var(max_hops) = 10;
    $var(loop_detected) = 0;
    $var(keep_going) = 1;
    while ($var(keep_going) == 1) {
        $var(jump_target) = 0;
        route(TRY_PROFILE_DISPATCH);

        if ($var(matched) == 1 && $var(jump_target) > 0) {
            # Matched a rule whose destination is "jump to another
            # plan" -- not a real destination yet, keep going.
            $var(hop_count) = $var(hop_count) + 1;
            if ($var(hop_count) >= $var(max_hops)) {
                $var(loop_detected) = 1;
                $var(keep_going) = 0;
                xlog("L_DBG", "$ci: [profile hop] jump from profile=$var(try_profile) to profile=$var(jump_target) -- max hops ($var(max_hops)) reached, stopping\n");
            } else {
                xlog("L_DBG", "$ci: [profile hop] jump from profile=$var(try_profile) to profile=$var(jump_target) (hop $var(hop_count))\n");
                $var(try_profile) = $var(jump_target);
                $var(matched) = 0;
            }
        } else if ($var(matched) == 0) {
            # Nothing matched in this plan -- try its fallback, if any.
            $var(fallback_id) = 0;
            $var(rpm_val) = $sht(routing_profile_meta=>$var(try_profile));
            if ($var(rpm_val) != $null && $var(rpm_val) != "") {
                $var(rpm_fallback) = $(var(rpm_val){s.select,2,|});
                if ($var(rpm_fallback) != $null && $var(rpm_fallback) != "") {
                    $var(fallback_id) = $(var(rpm_fallback){s.int});
                }
            }

            $var(hop_count) = $var(hop_count) + 1;
            if ($var(fallback_id) > 0 && $var(hop_count) < $var(max_hops)) {
                xlog("L_DBG", "$ci: [profile hop] no match in profile=$var(try_profile), falling back to profile=$var(fallback_id) (hop $var(hop_count))\n");
                $var(try_profile) = $var(fallback_id);
            } else {
                xlog("L_DBG", "$ci: [profile hop] no match in profile=$var(try_profile), no fallback configured -- stopping\n");
                $var(keep_going) = 0;
            }
        } else {
            # Matched a real destination (trunk/subscriber/monitoring-
            # only) -- done.
            xlog("L_DBG", "$ci: [profile hop] settled: profile=$var(try_profile) via $var(match_kind)\n");
            $var(keep_going) = 0;
        }
    }

    if ($var(loop_detected) == 1) {
        xlog("L_ERR", "$ci: routing loop detected for $rU from $si (stopped at profile $var(try_profile) after $var(max_hops) hops)\n");
        xlog("L_INFO", "ROUTE_SUMMARY: source=$var(src_descriptor) original_called=$ru original_calling=$fu callid=$ci plan=profile-$var(try_profile) effective_called=$ru effective_calling=$dlg_var(effective_caller_id_number) routed_trunk=REJECTED:508-loop-detected\n");
        if ($var(route_test_mode) == 1) {
            append_to_reply("X-Test-Result: rejected\r\n");
            append_to_reply("X-Test-Reject-Code: 508\r\n");
            append_to_reply("X-Test-Reject-Reason: Loop Detected\r\n");
            append_to_reply("X-Test-Detail: this routing plan chain jump/fallback loops back on itself and never settles within $var(max_hops) hops -- stopped at profile $var(try_profile). Check the jump_to_routing_profile_id / fallback_profile_id configuration on the plans involved.\r\n");
            sl_send_reply("200", "Route-Test-Result");
            exit;
        }
        $var(rr_key) = "508_loop_detected"; $var(rr_default) = "Loop Detected"; route(RESP_REASON);
        acc_db_request("508 $var(rr_effective)", "missed_calls");
        sl_send_reply("508", "$var(rr_effective)");
        exit;
    }

    if ($var(matched) == 0) {
        $var(reject_code) = 404;
        $var(reject_reason) = "No Route Found";
        $var(rpm_val) = $sht(routing_profile_meta=>$var(profile_id));
        if ($var(rpm_val) != $null && $var(rpm_val) != "") {
            # Same {s.int} safety cast the existing code already
            # documents as necessary (confirmed, live-tested bug:
            # sl_send_reply's code argument silently produces 500 for
            # a string-typed PV regardless of its content).
            $var(reject_code) = $(var(rpm_val){s.select,3,|}{s.int});
            $var(reject_reason) = $(var(rpm_val){s.select,4,|});
        }
        xlog("L_ERR", "No route for $rU from $si (profile $var(profile_id)): $var(reject_code) $var(reject_reason)\n");
        xlog("L_INFO", "ROUTE_SUMMARY: source=$var(src_descriptor) original_called=$ru original_calling=$fu callid=$ci plan=profile-$var(profile_id) effective_called=$ru effective_calling=$dlg_var(effective_caller_id_number) routed_trunk=REJECTED:$var(reject_code)-$var(reject_reason)\n");
        if ($var(route_test_mode) == 1) {
            append_to_reply("X-Test-Result: rejected\r\n");
            append_to_reply("X-Test-Reject-Code: $var(reject_code)\r\n");
            append_to_reply("X-Test-Reject-Reason: $var(reject_reason)\r\n");
            append_to_reply("X-Test-Detail: no prefix, regex, or LCR rule in profile $var(profile_id) (or any profile reached via its fallback chain) matched this called/calling number combination\r\n");
            sl_send_reply("200", "Route-Test-Result");
            exit;
        }
        acc_db_request("$var(reject_code) $var(reject_reason)", "missed_calls");
        sl_send_reply("$var(reject_code)", "$var(reject_reason)");
        exit;
    }

    # $var(orig_ru)/$var(orig_fu) already captured at the very start
    # of route[INVITE], before any extraction/manipulation could touch
    # $rU/$fU -- still valid here since this is the same message-
    # processing cycle, not a separate request. Persist into dlg_var
    # now that the dialog exists ($dlg_var() survives to BYE-time CDR
    # generation; plain $var() would not).
    $dlg_var(original_called) = $var(orig_ru);
    $dlg_var(original_calling) = $var(cid_raw_candidate);
    $var(plan_name) = "profile-" + $var(try_profile);
    $var(rpm_val) = $sht(routing_profile_meta=>$var(try_profile));
    if ($var(rpm_val) != $null && $var(rpm_val) != "") {
        $var(rpm_name) = $(var(rpm_val){s.select,1,|});
        if ($var(rpm_name) != $null && $var(rpm_name) != "") {
            $var(plan_name) = $var(rpm_name);
        }
    }

    # v3: trace/record decision -- OR across every scope that applies
    # to this call. Rule-level and monitoring-only-rule contributions
    # are both known by this point; trunk-level and callee-subscriber-
    # level get OR'd in further below, once we know which destination
    # branch this call actually takes. Caller-subscriber-level (this
    # call being FROM one of our own registered users) is checked
    # here since it doesn't depend on the destination at all.
    route(CHECK_MONITORING_RULES);
    $var(should_trace) = 0;
    $var(should_record) = 0;
    if ($var(rule_trace) == 1) { $var(should_trace) = 1; }
    if ($var(rule_record) == 1) { $var(should_record) = 1; }
    if ($var(monitor_trace) == 1) { $var(should_trace) = 1; }
    if ($var(monitor_record) == 1) { $var(should_record) = 1; }
    if ($var(from_user_call) == 1) {
        sql_query("ca", "SELECT trace_enabled, record_enabled FROM subscriber_meta WHERE username = '$var(from_username)' AND domain_name = '$var(from_domain_name)'", "fsm");
        if ($dbr(fsm=>rows) > 0) {
            if ($dbr(fsm=>[0,0]) == 1) { $var(should_trace) = 1; }
            if ($dbr(fsm=>[0,1]) == 1) { $var(should_record) = 1; }
        }
        sql_result_free("fsm");

        if ($var(domain_rl_name) != $null && $var(domain_rl_name) != "") {
            if (!pl_check("$var(domain_rl_name)", "$var(domain_rl_algo)", "$(var(domain_rl_limit){s.int})")) {
                xlog("L_INFO", "$ci: rate limit exceeded (pipe $var(domain_rl_name), scope domain)\n");
                $var(rr_key) = "503_rate_limit_exceeded"; $var(rr_default) = "Rate Limit Exceeded"; route(RESP_REASON);
                sl_send_reply("503", "$var(rr_effective)");
                exit;
            }
        }
        if ($var(user_rl_name) != $null && $var(user_rl_name) != "") {
            if (!pl_check("$var(user_rl_name)", "$var(user_rl_algo)", "$(var(user_rl_limit){s.int})")) {
                xlog("L_INFO", "$ci: rate limit exceeded (pipe $var(user_rl_name), scope user)\n");
                $var(rr_key) = "503_rate_limit_exceeded"; $var(rr_default) = "Rate Limit Exceeded"; route(RESP_REASON);
                sl_send_reply("503", "$var(rr_effective)");
                exit;
            }
        }
    }

    # Rule-level manipulation -- called AND caller side, applied at
    # routing time before the trunk-vs-user branch splits below, so
    # it's symmetric across both destination types.
    if ($var(strip) > 0 || $var(prepend) != "") {
        xlog("L_DBG", "$ci: [rule manipulation] called number before: $rU\n");
    }
    if ($var(strip) > 0) {
        $var(ru_len) = strlen($rU);
        if ($var(strip) >= $var(ru_len)) {
            $rU = "";
        } else {
            $var(ru_rem_len) = $var(ru_len) - $var(strip);
            $rU = $(rU{s.substr,$var(strip),$var(ru_rem_len)});
        }
    }
    if ($var(prepend) != "") {
        $rU = $var(prepend) + $rU;
    }
    if ($var(strip) > 0 || $var(prepend) != "") {
        xlog("L_DBG", "$ci: [rule manipulation] called number after: $rU (strip=$var(strip) prepend=\"$var(prepend)\")\n");
    }
    if ($var(caller_strip) > 0 || $var(caller_prepend) != "") {
        xlog("L_DBG", "$ci: [rule manipulation] calling number before: $dlg_var(effective_caller_id_number)\n");
    }
    $var(rule_cid_candidate) = $dlg_var(effective_caller_id_number);
    if ($var(rule_cid_candidate) == $null) { $var(rule_cid_candidate) = $fU; }
    if ($var(caller_strip) > 0) {
        $var(fu_len) = strlen($var(rule_cid_candidate));
        if ($var(caller_strip) >= $var(fu_len)) {
            $var(rule_cid_candidate) = "";
        } else {
            $var(fu_rem_len) = $var(fu_len) - $var(caller_strip);
            $var(rule_cid_candidate) = $(var(rule_cid_candidate){s.substr,$var(caller_strip),$var(fu_rem_len)});
        }
    }
    if ($var(caller_prepend) != "") {
        $var(rule_cid_candidate) = $var(caller_prepend) + $var(rule_cid_candidate);
    }
    if ($var(caller_strip) > 0 || $var(caller_prepend) != "") {
        $dlg_var(effective_caller_id_number) = $var(rule_cid_candidate);
        xlog("L_DBG", "$ci: [rule manipulation] calling number after: $dlg_var(effective_caller_id_number) (strip=$var(caller_strip) prepend=\"$var(caller_prepend)\")\n");
    }
    if ($var(forced_called_number) != "") {
        xlog("L_DBG", "$ci: [rule manipulation] called number overridden to Extension: $rU -> $var(forced_called_number)\n");
        $rU = $var(forced_called_number);
    }
    if ($var(forced_calling_number) != "") {
        xlog("L_DBG", "$ci: [rule manipulation] calling number overridden to Fixed Caller ID: $dlg_var(effective_caller_id_number) -> $var(forced_calling_number)\n");
        $dlg_var(effective_caller_id_number) = $var(forced_calling_number);
    }

    # v3 AOR: this rule's destination is a specific registered
    # subscriber rather than a trunk/group -- lookup("location") for
    # their AOR and relay there. Ring policy ('all' rings every
    # registered contact in parallel via lookup()'s own branch
    # handling; 'latest' pins to a single contact) is read from the
    # user's own override if set, else their domain's default. Zero
    # active registrations -> reject with that domain's configurable
    # unreachable code/text, not a generic 404.
    if ($var(dest_username) != "") {
        # Captured for CDR purposes (platform_cdrs.effective_called_number)
        # -- the LAST point $rU holds the actual, rule-manipulated
        # dialed number (post any strip_digits/prepend_digits/
        # forced_called_number from the matching routing rule) before
        # it gets overwritten just below to this subscriber's AOR
        # (sip:dest_username@dest_domain, required for lookup(
        # "location") to find their registration) and, further down,
        # to their registered contact's own URI by lookup() itself.
        # Confirmed via live end-to-end testing (REGISTER + INVITE
        # against the real binary): capturing any later than this
        # recorded the destination's identity or their device's raw
        # contact instead of the number that was actually dialed --
        # wrong even for the ordinary case where nothing was ever
        # manipulated at all, not just the lookup()-overwrite case
        # fixed earlier. Used by both the unconditional-forward branch
        # immediately below and the direct-delivery path further down,
        # so both report the same, correct value consistently.
        $dlg_var(effective_called_number) = $rU;

        # Call forwarding: unconditional -- checked before lookup()
        # is even attempted, so the subscriber's own phone never
        # rings at all if this is active. Same domain-gate-then-
        # subscriber-setting pattern as unavailable forwarding.
        # Consolidated htable lookup (item 15 optimization) -- fields
        # 0=gate, 1-5=unconditional forwarding row, 23=diversion_
        # enabled, per subscriber_forwarding_meta_ht's value format.
        $var(sfm_key) = $var(dest_username) + "@" + $var(dest_domain);
        $var(sfm_val) = $sht(subscriber_forwarding_meta=>$var(sfm_key));
        $var(fwd_gate) = 0;
        if ($var(sfm_val) != $null && $var(sfm_val) != "") {
            $var(fwd_gate) = $(var(sfm_val){s.select,0,|});
        }

        if ($var(fwd_gate) == 1 && $(var(sfm_val){s.select,1,|}) == 1) {
            $var(fwd_target_user) = $(var(sfm_val){s.select,2,|});
            $var(fwd_target_domain) = $(var(sfm_val){s.select,3,|});
            $var(fwd_target_ext) = $(var(sfm_val){s.select,4,|});
            $var(fwd_mode) = $(var(sfm_val){s.select,5,|});

            if ($var(fwd_target_ext) != "" && $var(fwd_target_ext) != "$null") {
                $var(fwd_uri) = "sip:" + $var(fwd_target_ext) + "@" + $var(dest_domain);
            } else {
                $var(fwd_uri) = "sip:" + $var(fwd_target_user) + "@" + $var(fwd_target_domain);
            }

            if ($var(route_test_mode) == 1) {
                append_to_reply("X-Test-Result: routed\r\n");
                append_to_reply("X-Test-Plan: $var(plan_name)\r\n");
                append_to_reply("X-Test-Outcome: unconditional-forward\r\n");
                append_to_reply("X-Test-Forward-Target: $var(fwd_uri)\r\n");
                append_to_reply("X-Test-Forward-Mode: $var(fwd_mode)\r\n");
                sl_send_reply("200", "Route-Test-Result");
                exit;
            }
            if ($var(fwd_mode) == "redirect") {
                append_to_reply("Contact: <" + $var(fwd_uri) + ">\r\n");
                $var(rr_key) = "302_call_forwarded"; $var(rr_default) = "Moved Temporarily"; route(RESP_REASON);
                sl_send_reply("302", "$var(rr_effective)");
            } else {
                # Diversion header (RFC 5806) -- see the busy/
                # no-answer forwarding block further below for the
                # full reasoning; "unconditional" is RFC 5806's own
                # exact token, confirmed against its grammar. Gated
                # on the effective (subscriber-override-else-
                # domain-default) diversion_header_enabled setting,
                # pre-resolved at sync time (field 23).
                if ($(var(sfm_val){s.select,23,|}) == 1) {
                    append_hf("Diversion: <sip:$var(dest_username)@$var(dest_domain)>;reason=unconditional;counter=1\r\n");
                }
                $ru = $var(fwd_uri);
                append_branch();
                t_relay();
            }
            xlog("L_INFO", "ROUTE_SUMMARY: source=$var(src_descriptor) original_called=$var(orig_ru) original_calling=$dlg_var(original_calling) callid=$ci plan=\"$var(plan_name)\" effective_called=$dlg_var(effective_called_number) effective_calling=$dlg_var(effective_caller_id_number) routed_trunk=USER:$var(dest_username)@$var(dest_domain) (unconditional forward -> $var(fwd_uri))\n");
            exit;
        }

        $ru = "sip:" + $var(dest_username) + "@" + $var(dest_domain);
        $var(som_key) = $var(dest_username) + "@" + $var(dest_domain);
        $var(som_val) = $sht(subscriber_outbound_meta=>$var(som_key));
        $var(user_ring_policy) = "all";
        $var(no_answer_gate) = 0;
        $var(eff_out_cid_method) = "from_header";
        $var(eff_out_called_placement) = "request_uri";
        $var(eff_out_uri_format) = "sip_uri";
        $var(eff_out_local_addr_from) = "0";
        $var(eff_out_privacy) = "none";
        $var(eff_topoh_out) = "1";
        $var(eff_out_cid_mode) = "allow_any";
        $var(eff_out_cid_custom) = "";
        $var(eff_out_cid_forced) = "";
        $var(eff_ruri_user_src) = "dialed_number";
        $var(eff_ruri_dom_src) = "node_address";
        $var(eff_ruri_fmt) = "sip_uri";
        $var(eff_to_same_as_ruri) = "1";
        $var(eff_to_user_src) = "dialed_number";
        $var(eff_to_dom_src) = "node_address";
        $var(eff_to_fmt) = "sip_uri";
        if ($var(som_val) != $null && $var(som_val) != "") {
            $var(user_ring_policy) = $(var(som_val){s.select,0,;});
            if ($(var(som_val){s.select,1,;}) == 1) { $var(should_trace) = 1; }
            if ($(var(som_val){s.select,2,;}) == 1) { $var(should_record) = 1; }
            $var(outbound_domain_id_val) = $(var(som_val){s.select,3,;});
            $dlg_var(outbound_domain_id) = $var(outbound_domain_id_val);
            $dlg_var(outbound_subscriber) = $var(dest_username) + "@" + $var(dest_domain);
            $var(no_answer_gate) = $(var(som_val){s.select,4,;});
            $var(eff_out_cid_method) = $(var(som_val){s.select,5,;});
            $var(eff_out_called_placement) = $(var(som_val){s.select,6,;});
            $var(eff_out_uri_format) = $(var(som_val){s.select,7,;});
            $var(eff_out_local_addr_from) = $(var(som_val){s.select,8,;});
            $var(eff_out_privacy) = $(var(som_val){s.select,9,;});
            $var(eff_topoh_out) = $(var(som_val){s.select,10,;});
            $var(eff_out_cid_mode) = $(var(som_val){s.select,11,;});
            $var(eff_out_cid_custom) = $(var(som_val){s.select,12,;});
            $var(eff_out_cid_forced) = $(var(som_val){s.select,13,;});
            $var(dom_custom_hdrs) = $(var(som_val){s.select,14,;});
            if ($var(dom_custom_hdrs) != $null && $var(dom_custom_hdrs) != "") {
                $var(dch_n) = $(var(dom_custom_hdrs){s.count,|});
                $var(dch_i) = 0;
                while ($var(dch_i) <= $var(dch_n)) {
                    $var(dch_b64) = $(var(dom_custom_hdrs){s.select,$var(dch_i),|});
                    if ($var(dch_b64) != "") {
                        $var(dch_val) = $(var(dch_b64){s.decode.base64});
                        if ($var(dch_val) != "") {
                            if ($var(dch_val) =~ "\\$\\{") {
                                $var(hdr_template_in) = $var(dch_val);
                                route(APPLY_HEADER_VARS);
                                $var(dch_val) = $var(hdr_template_out);
                            }
                            append_hf("$var(dch_val)\r\n");
                        }
                    }
                    $var(dch_i) = $var(dch_i) + 1;
                }
            }
            $var(dom_strip_hdrs) = $(var(som_val){s.select,15,;});
            $var(eff_ruri_user_src) = $(var(som_val){s.select,16,;});
            $var(eff_ruri_dom_src) = $(var(som_val){s.select,17,;});
            $var(eff_ruri_fmt) = $(var(som_val){s.select,18,;});
            $var(eff_to_same_as_ruri) = $(var(som_val){s.select,19,;});
            $var(eff_to_user_src) = $(var(som_val){s.select,20,;});
            $var(eff_to_dom_src) = $(var(som_val){s.select,21,;});
            $var(eff_to_fmt) = $(var(som_val){s.select,22,;});
            if ($var(dom_strip_hdrs) != $null && $var(dom_strip_hdrs) != "") {
                $var(dsh_n) = $(var(dom_strip_hdrs){s.count,|});
                $var(dsh_i) = 0;
                while ($var(dsh_i) <= $var(dsh_n)) {
                    $var(dsh_name) = $(var(dom_strip_hdrs){s.select,$var(dsh_i),|});
                    $var(dsh_name_lc) = $(var(dsh_name){s.tolower});
                    if ($var(dsh_name) != "" && $var(dsh_name_lc) != "via" && $var(dsh_name_lc) != "from"
                        && $var(dsh_name_lc) != "to" && $var(dsh_name_lc) != "call-id"
                        && $var(dsh_name_lc) != "cseq" && $var(dsh_name_lc) != "max-forwards") {
                        if (is_present_hf_pv("$var(dsh_name)")) { remove_hf_pv("$var(dsh_name)"); }
                    }
                    $var(dsh_i) = $var(dsh_i) + 1;
                }
            }
        }
        $dlg_var(topoh_mask_toward_callee) = $var(eff_topoh_out);

        # DESTINATION-side enforcement -- final say, can override
        # whatever the source side already decided. Candidate is the
        # source-enforced number (dlg_var, set in route[INVITE]),
        # never the raw original -- enforcement always operates on
        # the already-enforced value from the prior stage, per the
        # pipeline this session settled on.
        $var(cid_enforce_mode) = $var(eff_out_cid_mode);
        $var(cid_enforce_custom) = $var(eff_out_cid_custom);
        $var(cid_enforce_forced) = $var(eff_out_cid_forced);
        $var(cid_enforce_candidate) = $dlg_var(effective_caller_id_number);
        $var(cid_enforce_pool_type) = "subscriber";
        $var(cid_enforce_pool_key) = $var(dest_username) + "@" + $var(dest_domain);
        route(ENFORCE_CALLERID);
        $dlg_var(effective_caller_id_number) = $var(cid_enforced_number);
        $var(eff_out_from_domain_mode) = "";
        route(APPLY_CALLERID_PRESENTATION);
        route(APPLY_CALLED_NUMBER_PLACEMENT);

        if ($var(user_ring_policy) == "latest") {
            if (!lookup("location", "method-filtering")) {
                route(USER_UNREACHABLE);
                exit;
            }
        } else {
            if (!lookup("location")) {
                route(USER_UNREACHABLE);
                exit;
            }
        }

        # R-URI/To construction, honoring this domain's own outbound
        # R-URI/To settings (outbound_ruri_user_source etc) -- MUST run
        # here, after lookup("location") above, not before. lookup()
        # destructively overwrites $rU with the registered contact's
        # own URI (host/port/transport/line-params all correctly come
        # from the real contact -- that part is necessary), but this
        # also silently discarded whatever the domain's own R-URI/To
        # construction settings had built, and those settings were
        # never even wired into this path's routing logic at all until
        # now (subscriber_outbound_meta_ht previously carried none of
        # them -- confirmed via schema and sync-routing.py). Confirmed
        # live in production: a real device's own registered contact
        # can carry an arbitrary, generic user-part (e.g. "s") entirely
        # unrelated to the number that was actually dialed.
        #
        # $dlg_var(effective_called_number), captured just above before
        # lookup() ran, is the "dialed_number" base value here --
        # simpler than the trunk-destination path's equivalent (no
        # "registered_identity"/"trunk hostname"/"registrar domain"
        # concept applies to a local_subscriber destination; the only
        # two dimensions that exist here are this node's own address
        # vs the domain's own name, and the subscriber's own AOR
        # username as the one non-dialed-number user option).
        $var(eff_ruri_user) = $dlg_var(effective_called_number);
        if ($var(eff_ruri_user_src) == "registered_identity") {
            $var(eff_ruri_user) = $var(dest_username);
        }
        $var(eff_ruri_dom) = "__EIP__";
        if ($var(eff_ruri_dom_src) == "domain_name") {
            $var(eff_ruri_dom) = $var(dest_domain);
        }
        $var(ru_host) = $(ru{uri.host});
        $var(ru_port) = $(ru{uri.port});
        $var(ru_params) = $(ru{uri.params});
        if ($var(eff_ruri_fmt) == "tel_uri") {
            $var(new_ru) = "tel:" + $var(eff_ruri_user);
        } else {
            if ($var(ru_params) != "") {
                $var(new_ru) = "sip:" + $var(eff_ruri_user) + "@" + $var(ru_host) + ":" + $var(ru_port) + ";" + $var(ru_params);
            } else {
                $var(new_ru) = "sip:" + $var(eff_ruri_user) + "@" + $var(ru_host) + ":" + $var(ru_port);
            }
            if ($var(eff_ruri_fmt) == "sip_uri_user_phone") {
                $var(new_ru) = $var(new_ru) + ";user=phone";
            }
        }
        $ru = $var(new_ru);

        $var(ruri_construction_customized) = 0;
        if ($var(eff_ruri_user_src) != "dialed_number" || $var(eff_ruri_dom_src) != "node_address" || $var(eff_ruri_fmt) != "sip_uri") {
            $var(ruri_construction_customized) = 1;
        }
        if ($var(to_header_applied) != 1) {
            if ($var(eff_to_same_as_ruri) == "0") {
                $var(eff_to_user) = $dlg_var(effective_called_number);
                if ($var(eff_to_user_src) == "registered_identity") {
                    $var(eff_to_user) = $var(dest_username);
                }
                $var(eff_to_dom) = "__EIP__";
                if ($var(eff_to_dom_src) == "domain_name") {
                    $var(eff_to_dom) = $var(dest_domain);
                }
                if ($var(eff_to_fmt) == "tel_uri") {
                    $var(to_uri) = "tel:" + $var(eff_to_user);
                } else if ($var(eff_to_fmt) == "sip_uri_user_phone") {
                    $var(to_uri) = "sip:" + $var(eff_to_user) + "@" + $var(eff_to_dom) + ";user=phone";
                } else {
                    $var(to_uri) = "sip:" + $var(eff_to_user) + "@" + $var(eff_to_dom);
                }
                uac_replace_to("", $var(to_uri));
            } else if ($var(ruri_construction_customized) == 1) {
                # to_same_as_ruri=1 (default) AND the R-URI construction
                # was genuinely customized -- match To to the new R-URI,
                # same reasoning as the trunk-destination path's
                # identical branch above.
                uac_replace_to("", $ru);
            }
        }

        # Call forwarding: no-answer -- only sets up a custom ring
        # timeout when this domain's gate is on, avoiding the
        # overhead entirely for domains that never use it, per the
        # finalized design. Single-argument t_set_fr() sets only
        # fr_inv_timer (the post-provisional/ring timeout), leaving
        # the initial fr_timer at its configured default. Known, real
        # limitation worth documenting rather than hiding: t_set_fr()
        # is confirmed unreliable for TCP-registered contacts in some
        # Kamailio versions (only reliably honored over UDP) -- no-
        # answer forwarding may not fire correctly for a TCP-
        # registered subscriber even with this gate on.
        if ($var(no_answer_gate) == 1) {
            $dlg_var(no_answer_forward_active) = "1";
            t_set_fr(30000, 20000);
        }

        xlog("L_INFO", "ROUTE_SUMMARY: source=$var(src_descriptor) original_called=$var(orig_ru) original_calling=$dlg_var(original_calling) callid=$ci plan=\"$var(plan_name)\" effective_called=$dlg_var(effective_called_number) effective_calling=$dlg_var(effective_caller_id_number) routed_trunk=USER:$var(dest_username)@$var(dest_domain)\n");
        if ($var(route_test_mode) == 1) {
            append_to_reply("X-Test-Result: routed\r\n");
            append_to_reply("X-Test-Plan: $var(plan_name)\r\n");
            append_to_reply("X-Test-Outcome: user\r\n");
            append_to_reply("X-Test-Final-Called: $rU\r\n");
            append_to_reply("X-Test-Final-Calling: $fU\r\n");
            append_to_reply("X-Test-Destination-User: $var(dest_username)@$var(dest_domain)\r\n");
            append_to_reply("X-Test-Ring-Policy: $var(user_ring_policy)\r\n");
            append_to_reply("X-Test-Registered: yes\r\n");
            sl_send_reply("200", "Route-Test-Result");
            exit;
        }
        route(APPLY_MEDIA_PROFILE);
        route(RELAY);
        exit;
    }

    if ($var(match_kind) == "lcr") {
        # next_gw() already rewrote $rU/$du to the selected gateway --
        # no dispatcher involvement at all for this path, relay
        # directly. Live cost-ordered failover (trying the next
        # gateway if this one fails) happens in MANAGE_FAILURE via a
        # further next_gw() call, gated on $dlg_var(lcr_active).
        # Captured for CDR purposes (platform_cdrs.effective_called_number)
        # -- same gap and same fix as the local_subscriber path above,
        # caught proactively while fixing that reported bug.
        $dlg_var(effective_called_number) = $rU;
        xlog("L_INFO", "ROUTE_SUMMARY: source=$var(src_descriptor) original_called=$var(orig_ru) original_calling=$dlg_var(original_calling) callid=$ci plan=\"$var(plan_name)\" effective_called=$dlg_var(effective_called_number) effective_calling=$dlg_var(effective_caller_id_number) routed_trunk=$avp(lcr_gwtag)\n");
        if ($var(route_test_mode) == 1) {
            append_to_reply("X-Test-Result: routed\r\n");
            append_to_reply("X-Test-Plan: $var(plan_name)\r\n");
            append_to_reply("X-Test-Outcome: lcr\r\n");
            append_to_reply("X-Test-Final-Called: $rU\r\n");
            append_to_reply("X-Test-Final-Calling: $fU\r\n");
            append_to_reply("X-Test-Selected-Gateway: $du\r\n");
            sl_send_reply("200", "Route-Test-Result");
            exit;
        }
        route(APPLY_MEDIA_PROFILE);
        t_on_failure("MANAGE_FAILURE");
        route(RELAY);
        exit;
    }

    # Look up the actual configured dispatch algorithm for this setid
    # (individual trunks always get 4/round-robin -- single member,
    # algorithm choice is moot; gateway groups get whatever was
    # configured). Real fix this session for a confirmed gap: this
    # was unconditionally hardcoded to "4" before, regardless of what
    # was set on the group.
    $var(dispatch_alg) = "4";
    $var(dsa_val) = $sht(dispatcher_setid_alg=>$var(target_setid));
    if ($var(dsa_val) != $null && $var(dsa_val) != "") {
        $var(dispatch_alg) = $var(dsa_val);
    }

    if (!ds_select_dst("$var(target_setid)", "$var(dispatch_alg)")) {
        if ($var(failover_setid) > 0) {
            $var(failover_alg) = "4";
            $var(fdsa_val) = $sht(dispatcher_setid_alg=>$var(failover_setid));
            if ($var(fdsa_val) != $null && $var(fdsa_val) != "") {
                $var(failover_alg) = $var(fdsa_val);
            }
            xlog("L_DBG", "$ci: [dispatcher] setid=$var(target_setid) (alg=$var(dispatch_alg)) had no available destination, trying failover setid=$var(failover_setid) (alg=$var(failover_alg))\n");
            if (!ds_select_dst("$var(failover_setid)", "$var(failover_alg)")) {
                xlog("L_DBG", "$ci: [dispatcher] failover setid=$var(failover_setid) also had no available destination\n");
                $var(reject_reason) = "no trunk available (primary setid=" + $var(target_setid) + ", failover setid=" + $var(failover_setid) + ")";
                route(LOG_REJECTED);
                $var(rr_key) = "503_no_trunk_available"; $var(rr_default) = "No Trunk Available"; route(RESP_REASON);
                sl_send_reply("503", "$var(rr_effective)");
                exit;
            }
            $var(target_setid) = $var(failover_setid);
        } else {
            xlog("L_DBG", "$ci: [dispatcher] setid=$var(target_setid) (alg=$var(dispatch_alg)) had no available destination, no failover configured\n");
            $var(reject_reason) = "no trunk available (setid=" + $var(target_setid) + ", no failover configured)";
            route(LOG_REJECTED);
            $var(rr_key) = "503_no_trunk_available"; $var(rr_default) = "No Trunk Available"; route(RESP_REASON);
            sl_send_reply("503", "$var(rr_effective)");
            exit;
        }
    }
    xlog("L_DBG", "$ci: [dispatcher] setid=$var(target_setid) selected du=$du\n");

    # Trunk-level manipulation -- dispatcher-only, always, per the
    # earlier design discussion. Only ever reaches here because this
    # branch structurally never runs for the "route to user" path
    # above (that branch already exited).
    #
    # Real bug found via live testing this session: the previous
    # design read this from $avp(ds_attrs), populated by
    # ds_select_dst() via the dispatcher module's attrs_pvname
    # modparam -- confirmed live that this AVP is NEVER actually
    # populated (stayed <null> through repeated live tests, including
    # after adding the attrs_pvname modparam, which the module does
    # accept without error but which did not fix the underlying
    # issue). This meant every trunk-level strip/prepend/trace/
    # record/sip_profile/outbound_proxy/max_channels setting has been
    # silently non-functional in production regardless of what was
    # configured per-trunk, the whole time this code existed. Root
    # cause of the AVP mechanism itself not fully resolved -- rather
    # than continue guessing at module internals, this reads directly
    # from dispatcher.attrs via SQL instead, the same setid+destination
    # match already confirmed working for the trunk name (description)
    # lookup further below -- a mechanism already proven live, not a
    # new unknown.
    $var(attrs_raw) = "";
    $var(routed_trunk_name) = "setid-" + $var(target_setid);
    $var(dda_val) = $sht(dispatcher_dest_attrs=>$var(target_setid):$du);
    if ($var(dda_val) != $null && $var(dda_val) != "") {
        $var(attrs_raw) = $(var(dda_val){s.select,0,|});
        $var(dda_desc) = $(var(dda_val){s.select,1,|});
        if ($var(dda_desc) != "") {
            $var(routed_trunk_name) = $var(dda_desc);
        }
    }

    # Real bug found via live testing this session: re.subst returns
    # the entire ORIGINAL string unchanged when its pattern doesn't
    # match (confirmed with an isolated test), not empty -- every
    # extraction below explicitly tests the key is actually present
    # via =~ first, rather than trusting a "no match" case to produce
    # an empty/harmless result. Left unguarded, a trunk whose attrs
    # happens to be missing a given key (shouldn't happen with a real
    # sync-routing.py-generated attrs string, which always writes
    # every key, but is not something to leave unguarded regardless)
    # would silently extract garbage -- most dangerously for
    # outbound_proxy below, which would corrupt $du, the actual send
    # destination, with zero visible error.
    $var(trunk_strip) = 0;
    if ($var(attrs_raw) =~ "strip=") {
        $var(trunk_strip) = $(var(attrs_raw){re.subst,/.*strip=([0-9]+).*/\1/}{s.int});
    }
    $var(trunk_prepend) = "";
    if ($var(attrs_raw) =~ "prepend=") {
        $var(trunk_prepend) = $(var(attrs_raw){re.subst,/.*prepend="?([^;"]*)"?.*/\1/});
    }
    if ($var(trunk_strip) > 0 || $var(trunk_prepend) != "") {
        xlog("L_DBG", "$ci: [trunk manipulation] called number before: $rU\n");
    }
    if ($var(trunk_strip) > 0) {
        $var(ru_len2) = strlen($rU);
        if ($var(trunk_strip) >= $var(ru_len2)) {
            $rU = "";
        } else {
            $var(ru2_rem_len) = $var(ru_len2) - $var(trunk_strip);
            $rU = $(rU{s.substr,$var(trunk_strip),$var(ru2_rem_len)});
        }
    }
    if ($var(trunk_prepend) != "") {
        $rU = $var(trunk_prepend) + $rU;
    }
    if ($var(trunk_strip) > 0 || $var(trunk_prepend) != "") {
        xlog("L_DBG", "$ci: [trunk manipulation] called number after: $rU (strip=$var(trunk_strip) prepend=\"$var(trunk_prepend)\")\n");
    }

    # R-URI / To construction -- confirmed real gap found and fixed
    # this session: the R-URI domain always silently defaulted to
    # this node's own address with no way to configure it, and the
    # R-URI itself never respected any URI scheme setting at all
    # (only the caller-ID identity did). Three independent dimensions
    # per provider's genuinely differing requirements, confirmed via
    # direct testing against the real binary: $rd is a writable
    # pseudo-variable for the R-URI's domain alone, and $ru (lowercase)
    # can be reassigned as a complete URI in one shot for tel:, which
    # has no domain component to set independently at all.
    $var(dialed_number) = $rU;
    $dlg_var(effective_called_number) = $rU;
    $var(ruri_user_src) = "dialed_number";
    if ($var(attrs_raw) =~ "ruri_user=") {
        $var(ruri_user_src) = $(var(attrs_raw){re.subst,/.*ruri_user=([a-z_]+).*/\1/});
    }
    $var(ruri_dom_src) = "node_address";
    if ($var(attrs_raw) =~ "ruri_dom=") {
        $var(ruri_dom_src) = $(var(attrs_raw){re.subst,/.*ruri_dom=([a-z_]+).*/\1/});
    }
    $var(ruri_fmt) = "sip_uri";
    if ($var(attrs_raw) =~ "ruri_fmt=") {
        $var(ruri_fmt) = $(var(attrs_raw){re.subst,/.*ruri_fmt=([a-z_]+).*/\1/});
    }
    $var(reg_identity) = "";
    if ($var(attrs_raw) =~ "reg_identity=") {
        $var(reg_identity) = $(var(attrs_raw){re.subst,/.*reg_identity="([^"]*)".*/\1/});
    }
    $var(trunk_host) = "__EIP__";
    if ($var(attrs_raw) =~ "trunk_host=") {
        $var(trunk_host) = $(var(attrs_raw){re.subst,/.*trunk_host="([^"]*)".*/\1/});
    }
    $var(registrar_host) = $var(trunk_host);
    if ($var(attrs_raw) =~ "registrar_host=" && $(var(attrs_raw){re.subst,/.*registrar_host="([^"]*)".*/\1/}) != "") {
        $var(registrar_host) = $(var(attrs_raw){re.subst,/.*registrar_host="([^"]*)".*/\1/});
    }

    $var(eff_ruri_user) = $var(dialed_number);
    if ($var(ruri_user_src) == "registered_identity" && $var(reg_identity) != "") {
        $var(eff_ruri_user) = $var(reg_identity);
    }
    $var(eff_ruri_dom) = "__EIP__";
    if ($var(ruri_dom_src) == "trunk_hostname") {
        $var(eff_ruri_dom) = $var(trunk_host);
    } else if ($var(ruri_dom_src) == "registrar_domain") {
        $var(eff_ruri_dom) = $var(registrar_host);
    }

    if ($var(ruri_fmt) == "tel_uri") {
        $ru = "tel:" + $var(eff_ruri_user);
    } else if ($var(ruri_fmt) == "sip_uri_user_phone") {
        $ru = "sip:" + $var(eff_ruri_user) + "@" + $var(eff_ruri_dom) + ";user=phone";
    } else {
        $ru = "sip:" + $var(eff_ruri_user) + "@" + $var(eff_ruri_dom);
    }

    $var(to_same_as_ruri) = 1;
    if ($var(attrs_raw) =~ "to_same=") {
        $var(to_same_as_ruri) = $(var(attrs_raw){re.subst,/.*to_same=([01]).*/\1/}{s.int});
    }
    $var(ruri_construction_customized) = 0;
    if ($var(ruri_user_src) != "dialed_number" || $var(ruri_dom_src) != "node_address" || $var(ruri_fmt) != "sip_uri") {
        $var(ruri_construction_customized) = 1;
    }
    $var(to_header_applied) = 0;
    if ($var(to_same_as_ruri) == 0) {
        $var(to_user_src) = "dialed_number";
        if ($var(attrs_raw) =~ "to_user=") {
            $var(to_user_src) = $(var(attrs_raw){re.subst,/.*to_user=([a-z_]+).*/\1/});
        }
        $var(to_dom_src) = "node_address";
        if ($var(attrs_raw) =~ "to_dom=") {
            $var(to_dom_src) = $(var(attrs_raw){re.subst,/.*to_dom=([a-z_]+).*/\1/});
        }
        $var(to_fmt) = "sip_uri";
        if ($var(attrs_raw) =~ "to_fmt=") {
            $var(to_fmt) = $(var(attrs_raw){re.subst,/.*to_fmt=([a-z_]+).*/\1/});
        }
        $var(eff_to_user) = $var(dialed_number);
        if ($var(to_user_src) == "registered_identity" && $var(reg_identity) != "") {
            $var(eff_to_user) = $var(reg_identity);
        }
        $var(eff_to_dom) = "__EIP__";
        if ($var(to_dom_src) == "trunk_hostname") {
            $var(eff_to_dom) = $var(trunk_host);
        } else if ($var(to_dom_src) == "registrar_domain") {
            $var(eff_to_dom) = $var(registrar_host);
        }
        if ($var(to_fmt) == "tel_uri") {
            $var(to_uri) = "tel:" + $var(eff_to_user);
        } else if ($var(to_fmt) == "sip_uri_user_phone") {
            $var(to_uri) = "sip:" + $var(eff_to_user) + "@" + $var(eff_to_dom) + ";user=phone";
        } else {
            $var(to_uri) = "sip:" + $var(eff_to_user) + "@" + $var(eff_to_dom);
        }
        uac_replace_to("", $var(to_uri));
        $var(to_header_applied) = 1;
    } else if ($var(ruri_construction_customized) == 1) {
        # to_same_as_ruri=1 (default) AND the R-URI construction itself
        # was genuinely customized for this trunk -- match To to the
        # new R-URI.
        uac_replace_to("", $ru);
        $var(to_header_applied) = 1;
    }

    $var(trunk_trace) = 0;
    if ($var(attrs_raw) =~ "trace=") {
        $var(trunk_trace) = $(var(attrs_raw){re.subst,/.*trace=([0-9]+).*/\1/}{s.int});
    }
    $var(trunk_record) = 0;
    if ($var(attrs_raw) =~ "record=") {
        $var(trunk_record) = $(var(attrs_raw){re.subst,/.*record=([0-9]+).*/\1/}{s.int});
    }
    if ($var(trunk_trace) == 1) { $var(should_trace) = 1; }
    if ($var(trunk_record) == 1) { $var(should_record) = 1; }

    $avp(active_trunk_setid) = $var(target_setid);
    # active_trunk_setid AVP stays the raw setid (correct -- the
    # credentials lookup in failure_route[MANAGE_FAILURE] matches
    # against dispatcher's own setid column). The dlg_var (which flows
    # into cdr_extra/CDRs) needs the REAL trunk.id instead, recovered
    # here from attrs_raw's own duid= field -- same extraction already
    # verified live for both the credentials fix and the inbound-side
    # trunk resolution above. routed_trunk_name was already resolved
    # just above (dispatcher.description, the same proven lookup).
    $var(outbound_trunk_real_id) = "";
    if ($var(attrs_raw) =~ "duid=") {
        $var(outbound_trunk_real_id) = $(var(attrs_raw){re.subst,/.*duid=([0-9]+).*/\1/}{s.int});
    }
    $dlg_var(outbound_trunk_id) = $var(outbound_trunk_real_id);
    $dlg_var(outbound_trunk_name) = $var(routed_trunk_name);

    # Interop: custom headers to add + headers to strip, up to 10 each
    # -- per explicit request to expand from the old fixed 3-slot
    # mechanism to a real list. Add-header values are base64-encoded
    # by sync-routing.py (safely embeds arbitrary header text, which
    # could contain ';' or other characters that would otherwise
    # collide with attrs' own delimiter syntax), joined by '|' --
    # iterated via the s.count/s.select string transforms, confirmed
    # via direct testing against the real binary that s.count returns
    # the SEPARATOR count, not the element count, so the loop bound
    # below is deliberately <= not <, and the whole block is skipped
    # if the source string is empty (also confirmed necessary via
    # direct testing -- s.count on an empty string still risks a
    # spurious iteration otherwise).
    if ($var(attrs_raw) =~ "custom_hdrs=") {
        $var(ch_list) = $(var(attrs_raw){re.subst,/.*custom_hdrs=([^;]*).*/\1/});
        if ($var(ch_list) != "") {
            $var(ch_n) = $(var(ch_list){s.count,|});
            $var(ch_i) = 0;
            while ($var(ch_i) <= $var(ch_n)) {
                $var(ch_b64) = $(var(ch_list){s.select,$var(ch_i),|});
                if ($var(ch_b64) != "") {
                    $var(ch_val) = $(var(ch_b64){s.decode.base64});
                    if ($var(ch_val) != "") {
                        if ($var(ch_val) =~ "\\$\\{") {
                            $var(hdr_template_in) = $var(ch_val);
                            route(APPLY_HEADER_VARS);
                            $var(ch_val) = $var(hdr_template_out);
                        }
                        append_hf("$var(ch_val)\r\n");
                    }
                }
                $var(ch_i) = $var(ch_i) + 1;
            }
        }
    }
    if ($var(attrs_raw) =~ "strip_hdrs=") {
        $var(sh_list) = $(var(attrs_raw){re.subst,/.*strip_hdrs=([^;]*).*/\1/});
        if ($var(sh_list) != "") {
            $var(sh_n) = $(var(sh_list){s.count,|});
            $var(sh_i) = 0;
            while ($var(sh_i) <= $var(sh_n)) {
                $var(sh_name) = $(var(sh_list){s.select,$var(sh_i),|});
                $var(sh_name_lc) = $(var(sh_name){s.tolower});
                if ($var(sh_name) != "" && $var(sh_name_lc) != "via" && $var(sh_name_lc) != "from"
                    && $var(sh_name_lc) != "to" && $var(sh_name_lc) != "call-id"
                    && $var(sh_name_lc) != "cseq" && $var(sh_name_lc) != "max-forwards") {
                    if (is_present_hf_pv("$var(sh_name)")) { remove_hf_pv("$var(sh_name)"); }
                }
                $var(sh_i) = $var(sh_i) + 1;
            }
        }
    }
    # User-Agent override (trunk-level and SIP-Profile-level tiers)
    # REMOVED -- moved to node-level-only configuration per explicit
    # request. The node tier is unaffected: it's already correctly
    # baked into the process's own user_agent_header core modparam via
    # the existing, generic catalog mechanism (generate_sip_config.py),
    # applying uniformly to every request this node sends regardless
    # of trunk/profile.
    $var(trunk_sip_profile_id) = "";
    if ($var(attrs_raw) =~ "sip_profile=") {
        $var(trunk_sip_profile_id) = $(var(attrs_raw){re.subst,/.*sip_profile=([0-9]+).*/\1/});
    }
    if ($var(trunk_sip_profile_id) != "") {
        $dlg_var(outbound_sip_profile_id) = $var(trunk_sip_profile_id);
    }

    # Topology hiding: the destination's own "mask traffic sent to
    # me" preference. See topoh_caller_addr (set on the source side,
    # both trunk- and subscriber-origin paths) for how
    # event_route[topoh:msg-outgoing] tells this direction apart from
    # traffic headed back toward the caller -- comparing against the
    # CALLER's address rather than the callee's, since the caller side
    # is always a single well-defined value but the callee side can
    # legitimately be multiple parallel-forked contacts (ring_policy=
    # all routing to a subscriber with several registered devices).
    $var(topoh_out) = "1";
    if ($var(attrs_raw) =~ "topoh_out=") {
        $var(topoh_out) = $(var(attrs_raw){re.subst,/.*topoh_out=([01]).*/\1/});
    }
    $dlg_var(topoh_mask_toward_callee) = $var(topoh_out);

    # Outbound caller-ID/called-number presentation -- same eff_out_*
    # variables the destination-subscriber path (route[HANDLE_CALL]'s
    # subscriber-destination resolution) already populates, so any-to-
    # any routing (trunk-to-trunk, user-to-trunk, trunk-to-user,
    # user-to-user) gets consistent treatment regardless of which type
    # the destination happens to be.
    $var(eff_out_cid_method) = "from_header";
    if ($var(attrs_raw) =~ "out_cid_method=") {
        $var(eff_out_cid_method) = $(var(attrs_raw){re.subst,/.*out_cid_method=([a-z_]+).*/\1/});
    }
    $var(eff_out_cid_mode) = "allow_any";
    if ($var(attrs_raw) =~ "out_cid_mode=") {
        $var(eff_out_cid_mode) = $(var(attrs_raw){re.subst,/.*out_cid_mode=([a-z_]+).*/\1/});
    }
    $var(eff_out_cid_custom) = "";
    if ($var(attrs_raw) =~ "out_cid_custom=") {
        $var(eff_out_cid_custom) = $(var(attrs_raw){re.subst,/.*out_cid_custom="?([^;"]*)"?.*/\1/});
    }
    $var(eff_out_cid_forced) = "";
    if ($var(attrs_raw) =~ "out_cid_forced=") {
        $var(eff_out_cid_forced) = $(var(attrs_raw){re.subst,/.*out_cid_forced="?([^;"]*)"?.*/\1/});
    }

    # DESTINATION-side enforcement -- same pattern as the destination-
    # subscriber path: final say, overrides whatever the source side
    # already decided, candidate is the source-enforced number, never
    # the raw original. Runs AFTER the eff_out_cid_* extraction above
    # (real bug found and fixed live this session: this block
    # originally ran BEFORE that extraction, reading undefined $var()s
    # -- confirmed via live testing that comparing an undefined $var()
    # against a string literal triggers Kamailio's "automatic string
    # to int conversion" error rather than simply evaluating false).
    $var(cid_enforce_mode) = $var(eff_out_cid_mode);
    $var(cid_enforce_custom) = $var(eff_out_cid_custom);
    $var(cid_enforce_forced) = $var(eff_out_cid_forced);
    $var(cid_enforce_candidate) = $dlg_var(effective_caller_id_number);
    $var(cid_enforce_pool_type) = "trunk";
    $var(cid_enforce_pool_key) = $var(outbound_trunk_real_id);
    route(ENFORCE_CALLERID);
    $dlg_var(effective_caller_id_number) = $var(cid_enforced_number);

    $var(eff_out_called_placement) = "request_uri";
    if ($var(attrs_raw) =~ "out_called=") {
        $var(eff_out_called_placement) = $(var(attrs_raw){re.subst,/.*out_called=([a-z_]+).*/\1/});
    }
    $var(eff_out_uri_format) = "sip_uri";
    if ($var(attrs_raw) =~ "out_uri_format=") {
        $var(eff_out_uri_format) = $(var(attrs_raw){re.subst,/.*out_uri_format=([a-z_]+).*/\1/});
    }
    $var(eff_out_from_domain_mode) = "remote";
    if ($var(attrs_raw) =~ "from_domain_mode=") {
        $var(eff_out_from_domain_mode) = $(var(attrs_raw){re.subst,/.*from_domain_mode=([a-z_]+).*/\1/});
    }
    $var(eff_out_custom_from_domain) = "";
    if ($var(attrs_raw) =~ "custom_from_domain=") {
        $var(eff_out_custom_from_domain) = $(var(attrs_raw){re.subst,/.*custom_from_domain="([^"]*)".*/\1/});
    }
    $var(eff_out_privacy) = "none";
    if ($var(attrs_raw) =~ "out_privacy=") {
        $var(eff_out_privacy) = $(var(attrs_raw){re.subst,/.*out_privacy=([a-z_]+).*/\1/});
    }
    route(APPLY_CALLERID_PRESENTATION);
    route(APPLY_CALLED_NUMBER_PLACEMENT);

    # Outbound proxy override -- ds_select_dst() already set $du to
    # this trunk's own destination (confirmed from dispatcher's own
    # docs: $du is literally "the outbound proxy address" in
    # Kamailio's own terminology). If this trunk has its own
    # outbound_proxy configured, override that with a DIFFERENT
    # address -- $ru (this trunk's real logical identity, used for
    # routing/CDR/trust) is untouched; only where the packet actually
    # gets sent changes. Can be ip:port OR a bare hostname (optionally
    # with :port), validated Manager-side. A bare hostname with no
    # port deliberately produces no port here either -- that's what
    # engages Kamailio's own RFC 3263 NAPTR->SRV->A/AAAA resolution at
    # t_relay() time (dns_try_naptr/dns_srv_lb/use_dns_failover, now
    # in the modparam catalog); an explicit port on either form skips
    # SRV/NAPTR and resolves that host:port directly, same as always.
    $var(trunk_outbound_proxy) = "";
    if ($var(attrs_raw) =~ "outbound_proxy=") {
        $var(trunk_outbound_proxy) = $(var(attrs_raw){re.subst,/.*outbound_proxy="?([^;"]*)"?.*/\1/});
    }
    if ($var(trunk_outbound_proxy) != "") {
        $du = "sip:" + $var(trunk_outbound_proxy);
    }
    t_on_failure("MANAGE_FAILURE");

    # trunk-scope rate limiting moved to the inbound side (Entry B,
    # right after digest authentication succeeds) -- see route[INVITE]
    # above. This outbound-sending path never applied it, correcting a
    # confirmed inconsistency: every other rate-limit scope defends
    # against something arriving at this platform, not throttles its
    # own outbound sending rate toward a trunk.

    # Concurrent-call cap per trunk (max_channels) -- uses dialog's
    # own profile mechanism, confirmed via direct testing this session
    # that it requires dlg_manage() to have already run in a real
    # stateful transaction context to accumulate correctly (already
    # true here -- dlg_manage() ran earlier in route[INVITE], same
    # message-processing chain). 0 = unlimited, no cap applied.
    $var(trunk_max_channels) = 0;
    if ($var(attrs_raw) =~ "max_channels=") {
        $var(trunk_max_channels) = $(var(attrs_raw){re.subst,/.*max_channels=([0-9]+).*/\1/}{s.int});
    }
    if ($var(trunk_max_channels) > 0) {
        $var(current_channels) = 0;
        get_profile_size("concurrent_calls", "$var(target_setid)", "$var(current_channels)");
        if ($var(current_channels) >= $var(trunk_max_channels)) {
            xlog("L_INFO", "$ci: trunk $var(target_setid) at capacity ($var(current_channels)/$var(trunk_max_channels)) -- rejecting\n");
            if ($var(route_test_mode) == 1) {
                append_to_reply("X-Test-Result: rejected\r\n");
                append_to_reply("X-Test-Reject-Code: 503\r\n");
                append_to_reply("X-Test-Reject-Reason: Trunk At Capacity\r\n");
                append_to_reply("X-Test-Detail: this trunk's own max_channels cap ($var(trunk_max_channels)) is currently full ($var(current_channels) active) -- a real call right now would get 503\r\n");
                sl_send_reply("200", "Route-Test-Result");
                exit;
            }
            $var(rr_key) = "503_trunk_at_capacity"; $var(rr_default) = "Trunk At Capacity"; route(RESP_REASON);
            sl_send_reply("503", "$var(rr_effective)");
            exit;
        }
        set_dlg_profile("concurrent_calls", "$var(target_setid)");
    }

    # Captured for CDR purposes (platform_cdrs.effective_called_number)
    # -- mirrors the exact same $rU already used in this line's own
    # effective_called= xlog field below, so it's guaranteed consistent
    # with what ROUTE_SUMMARY already logs, not a separately-derived
    # value. Captured earlier in this same route (right after trunk-
    # level strip/prepend, before route(APPLY_CALLED_NUMBER_PLACEMENT)
    # needs it) -- the local_subscriber and LCR destination paths have
    # their own matching captures, positioned at the equivalent point
    # for each (after their own routing-plan-level number manipulation
    # completes, before any destination-identity/registrar-contact
    # rewriting that would otherwise clobber it).
    xlog("L_INFO", "ROUTE_SUMMARY: source=$var(src_descriptor) original_called=$var(orig_ru) original_calling=$dlg_var(original_calling) callid=$ci plan=\"$var(plan_name)\" effective_called=$dlg_var(effective_called_number) effective_calling=$dlg_var(effective_caller_id_number) routed_trunk=$var(routed_trunk_name)\n");
    route(APPLY_MEDIA_PROFILE);
    if ($var(route_test_mode) == 1) {
        append_to_reply("X-Test-Result: routed\r\n");
        append_to_reply("X-Test-Plan: $var(plan_name)\r\n");
        append_to_reply("X-Test-Outcome: trunk\r\n");
        append_to_reply("X-Test-Final-Called: $rU\r\n");
        append_to_reply("X-Test-Final-Calling: $fU\r\n");
        append_to_reply("X-Test-Routed-Trunk: $var(routed_trunk_name)\r\n");
        append_to_reply("X-Test-Dispatcher-Destination: $du\r\n");
        # Real gap found and fixed this session: this tool never ran
        # media profile resolution at all -- exited and reported before
        # route(APPLY_MEDIA_PROFILE) was ever reached. Confirmed safe to
        # call here even with no SDP body on the synthetic test request:
        # effective_mode_num is fully computed before that route's own
        # has_body() check, which returns early (never calling
        # rtpengine_offer()) when there's nothing to anchor against.
        append_to_reply("X-Test-Media-Mode: $var(effective_mode_num)\r\n");
        $var(effective_mode_name) = "transparent";
        if ($var(effective_mode_num) == 0) { $var(effective_mode_name) = "bypass"; }
        else if ($var(effective_mode_num) == 2) { $var(effective_mode_name) = "proxy"; }
        else if ($var(effective_mode_num) == 3) { $var(effective_mode_name) = "transcoding"; }
        append_to_reply("X-Test-Media-Mode-Name: $var(effective_mode_name)\r\n");
        append_to_reply("X-Test-Media-Inbound-Profile-Id: $var(inbound_media_profile_id)\r\n");
        append_to_reply("X-Test-Media-Outbound-Profile-Id: $var(outbound_media_profile_id)\r\n");
        append_to_reply("X-Test-Media-Combination-Policy: $var(in_policy)\r\n");
        sl_send_reply("200", "Route-Test-Result");
        exit;
    }

    route(RELAY);
}

# NOTE: $var(should_trace)/$var(should_record) are now fully computed
# by this point -- OR'd across every scope (matched rule, any
# independently-matching monitoring-only rule via
# CHECK_MONITORING_RULES, the calling subscriber if this call is FROM
# one of our own registered users, the callee subscriber if it's TO
# one, and the trunk if one was ultimately selected). This is genuine,
# tested decision logic, not a stub.
#
# What's deliberately NOT done: nothing below this point actually
# ACTS on $var(should_trace)/$var(should_record) yet -- no
# conditional sip_trace() call, no rtpengine_start_recording() call.
# The runtime mechanism for toggling siptrace/recording PER CALL (as
# opposed to the module-wide trace_on switch already fixed and
# verified this session) needs its own confirmation against a real
# running instance before being wired in, same discipline as the
# max_registrations gap and the trace_on discovery itself -- both of
# which turned out to have real, non-obvious surprises when actually
# tested rather than assumed. Guessing at this one carries the same
# risk without the same ability to verify it here.

# v3 AOR: a "route to user" destination matched, but the target has
# zero active registrations -- reject with that domain's own
# configurable code/text (default 480) rather than a generic 404.
route[USER_UNREACHABLE] {
    if ($var(route_test_mode) == 1) {
        append_to_reply("X-Test-Result: routed\r\n");
        append_to_reply("X-Test-Plan: $var(plan_name)\r\n");
        append_to_reply("X-Test-Outcome: user\r\n");
        append_to_reply("X-Test-Destination-User: $var(dest_username)@$var(dest_domain)\r\n");
        append_to_reply("X-Test-Registered: no\r\n");
        append_to_reply("X-Test-Detail: matched a rule routing to this user, but they have zero active registrations -- a real call would get the domain's configured unreachable response (or its unavailable-forwarding target, if that's enabled for this domain and this user has one configured)\r\n");
        sl_send_reply("200", "Route-Test-Result");
        exit;
    }
    # Call forwarding: unavailable -- only even checked if the domain-
    # level gate is on (per the finalized design, each forwarding type
    # is independently gated domain-wide before any subscriber's own
    # setting is ever consulted). Consolidated htable lookup (item 15
    # optimization) -- fields 6=gate, 7-11=unavailable forwarding row,
    # 23=diversion_enabled, 24/25=user_unreachable_code/text.
    $var(sfm_key) = $var(dest_username) + "@" + $var(dest_domain);
    $var(sfm_val) = $sht(subscriber_forwarding_meta=>$var(sfm_key));
    $var(fwd_gate) = 0;
    if ($var(sfm_val) != $null && $var(sfm_val) != "") {
        $var(fwd_gate) = $(var(sfm_val){s.select,6,|});
    }

    if ($var(fwd_gate) == 1 && $(var(sfm_val){s.select,7,|}) == 1) {
        $var(fwd_target_user) = $(var(sfm_val){s.select,8,|});
        $var(fwd_target_domain) = $(var(sfm_val){s.select,9,|});
        $var(fwd_target_ext) = $(var(sfm_val){s.select,10,|});
        $var(fwd_mode) = $(var(sfm_val){s.select,11,|});

        if ($var(fwd_target_ext) != "" && $var(fwd_target_ext) != "$null") {
            $var(fwd_uri) = "sip:" + $var(fwd_target_ext) + "@" + $var(dest_domain);
        } else {
            $var(fwd_uri) = "sip:" + $var(fwd_target_user) + "@" + $var(fwd_target_domain);
        }

        if ($var(fwd_mode) == "redirect") {
            append_to_reply("Contact: <" + $var(fwd_uri) + ">\r\n");
            $var(rr_key) = "302_call_forwarded"; $var(rr_default) = "Moved Temporarily"; route(RESP_REASON);
            sl_send_reply("302", "$var(rr_effective)");
        } else {
            # Diversion header (RFC 5806) -- see the busy/no-answer
            # forwarding block for full reasoning; "unavailable" is
            # RFC 5806's own exact token, confirmed against its grammar.
            # Gated on the effective diversion_header_enabled setting,
            # pre-resolved at sync time (field 23).
            if ($(var(sfm_val){s.select,23,|}) == 1) {
                append_hf("Diversion: <sip:$var(dest_username)@$var(dest_domain)>;reason=unavailable;counter=1\r\n");
            }
            $ru = $var(fwd_uri);
            append_branch();
            t_relay();
        }
        exit;
    }

    $var(reject_reason) = "user unreachable: " + $var(dest_username) + "@" + $var(dest_domain) + " (not registered or all contacts failed)";
    route(LOG_REJECTED);
    if ($var(sfm_val) != $null && $var(sfm_val) != "") {
        sl_send_reply("$(var(sfm_val){s.select,24,|}{s.int})", "$(var(sfm_val){s.select,25,|})");
    } else {
        $var(rr_key) = "480_user_unreachable_fallback"; $var(rr_default) = "Temporarily Unavailable"; route(RESP_REASON);
        sl_send_reply("480", "$var(rr_effective)");
    }
}

route[REGISTER] {
    #!ifdef REGISTER_FLOOD_GATE
    # Per-source-IP REGISTER-flood gate (plan #5, per-method limiting),
    # driven by the per-node rate-limit page: looks up an enabled
    # 'register'-scope pipe and applies it PER SOURCE IP (pipe name =
    # configured name + ":" + $si) so each source gets its own counter
    # and one flooding source is throttled without a shared aggregate.
    # No 'register' pipe configured = no gate (admin opts in on the rate-
    # limit page), same "no pipe = no limit" contract as every other
    # scope. A real client re-registers ~once/interval so even a modest
    # limit is safe; the page lets the admin tune it per node.
    #!ifdef REGISTER_RATE_LIMIT_NAME
    $var(rf_name) = REGISTER_RATE_LIMIT_NAME + ":" + $si;
    if (!pl_check("$var(rf_name)", REGISTER_RATE_LIMIT_ALGO, REGISTER_RATE_LIMIT_VALUE)) {
        $var(reject_reason) = "REGISTER rate limit exceeded from $si (possible credential-stuffing / REGISTER flood)";
        route(LOG_REJECTED);
        $var(rr_key) = "503_rate_limit_exceeded"; $var(rr_default) = "Rate Limit Exceeded"; route(RESP_REASON);
        sl_send_reply("503", "$var(rr_effective)");
        exit;
    }
    #!endif
    #!endif
    # Real bug found and fixed via live testing this session: REGISTER
    # is always a subscriber action -- trunks never REGISTER to this
    # platform, they're statically configured gateway connections, not
    # registering endpoints. A trunk-allowlist gate here (address
    # grp=1, populated exclusively from platform_trunks -- see
    # sync-routing.py.template) unconditionally rejected every
    # legitimate subscriber registration, since a real SIP client's
    # source IP essentially never coincidentally matches a trunk's IP.
    # Confirmed via a real REGISTER test: silently dropped with no
    # reply at all, before ever reaching the domain-binding check
    # below. The correct, already-existing mechanism for restricting
    # who can REGISTER is the domain-specific deny/ACL check further
    # down in this same route (platform_domain_acls via
    # deny_grp/acl_grp) -- per-domain, admin-configurable, not tied to
    # the trunk list at all. This check simply doesn't belong here.

    # v3 fast path: single htable lookup replaces what was up to 3
    # sequential SQL queries (sip_listeners, sip_profile_domains,
    # domain_settings/subscriber) for the common case -- measured
    # live this session: 57,956 req/sec vs 22,830 for the equivalent
    # chained SQLite queries, single worker, and confirmed end-to-end
    # with a real digest exchange (401->200, save("location")
    # verified via ul.lookup). Key is the receiving listener + the
    # AOR being registered; value is "ha1|domain_id" (pipe-separated,
    # split confirmed live via {s.select,N,|}) -- domain_id rides
    # along so the ACL check below needs no separate SQL round-trip
    # either. A hit both confirms legitimacy (this exact
    # listener+AOR combination is real, right now) and hands back
    # exactly what pv_www_authenticate needs, with only the ACL
    # count-checks below touching SQLite.
    # Real bug found via live testing this session: assigning a NULL
    # htable result directly to a $var() silently coerces it to the
    # string "0" rather than preserving NULL -- confirmed with a
    # focused isolated test (direct $sht(...) != $null check
    # correctly detects NULL; the exact same lookup, assigned to
    # $var() first, then compared, incorrectly evaluates as "not
    # null, value=0"). The null-check MUST happen directly on
    # $sht(...) before any assignment -- only assign to $var() inside
    # the confirmed-hit branch, never before the check itself.
    if ($sht(subscriber_auth=>$Ri:$Rp:$tU@$td) != $null) {
        $var(auth_entry) = $sht(subscriber_auth=>$Ri:$Rp:$tU@$td);
        $var(ha1) = $(var(auth_entry){s.select,1,|});
        $var(domain_id) = $(var(auth_entry){s.select,2,|});
        $var(has_deny) = $(var(auth_entry){s.select,3,|});
        $var(has_allow) = $(var(auth_entry){s.select,4,|});

        # v3 AOR: domain-level ACL check, before any credential
        # challenge -- an out-of-range source IP is rejected without
        # ever revealing whether a valid username exists on this
        # domain. A domain with zero attached ACL entries allows from
        # anywhere -- ACLs are an opt-in restriction, not a default
        # deny, so a newly-created domain is never silently locked
        # out. Explicit design decision this session: kept as its own
        # step even after the htable fast-path landed, since
        # source-IP network policy and subscriber identity are
        # genuinely different kinds of check -- not folded into the
        # htable's pass/fail, on purpose. has_deny/has_allow ride
        # along in the htable value (computed once at sync time, from
        # the same ACL-entry counts sync already has on hand) instead
        # of a live SQL COUNT(*) per REGISTER -- the actual CIDR match
        # still goes through permissions' own allow_address(), since
        # that's not something to reimplement; only the "is there any
        # restriction configured at all" opt-in check moved.
        if ($var(has_deny) == "1") {
            $var(deny_grp) = 20000 + $var(domain_id);
            if (allow_address("$var(deny_grp)", "$si", "0")) {
                $var(reject_reason) = "REGISTER for " + $td + " -- source matches a DENY ACL entry for this domain";
                route(LOG_REJECTED);
                $var(rr_key) = "403_acl_denied_source"; $var(rr_default) = "Forbidden (source explicitly denied for this domain)"; route(RESP_REASON);
                sl_send_reply("403", "$var(rr_effective)");
                exit;
            }
        }

        if ($var(has_allow) == "1") {
            $var(acl_grp) = 10000 + $var(domain_id);
            if (!allow_address("$var(acl_grp)", "$si", "0")) {
                $var(reject_reason) = "REGISTER for " + $td + " -- source not in this domain's ACL";
                route(LOG_REJECTED);
                $var(rr_key) = "403_acl_denied_dest"; $var(rr_default) = "Forbidden (source not permitted for this domain)"; route(RESP_REASON);
                sl_send_reply("403", "$var(rr_effective)");
                exit;
            }
        }

        if (!pv_www_authenticate("$td", "$var(ha1)", "1")) {
            #!ifdef REGISTER_FLOOD_GATE
            # Wrong-password detection: $au non-empty means the REGISTER
            # actually carried credentials that failed -- a real
            # credential-guessing attempt, not a normal first challenge
            # (which arrives with no credentials and just gets challenged
            # below). Distinct AUTH-FAILED line so a fail2ban jail can
            # ban repeated guessers -- the register-abuse jail only
            # catches ACL denials, not wrong passwords, so this closes a
            # genuine gap.
            if ($au != "") {
                xlog("L_INFO", "AUTH-FAILED REGISTER from $si:$sp user=$au realm=$td -- wrong credentials\n");
            }
            #!endif
            www_challenge("$td", "0");
            exit;
        }
        # NAT detection -- confirmed via direct live testing, both the
        # detection itself and this exact ordering/msg_apply_changes()
        # requirement. Only affects how this contact is stored (fixed
        # to its real source address, flagged for nathelper's own
        # keepalive ping timer); does not affect whether the
        # registration itself succeeds.
        if (nat_uac_test("3")) {
            setbflag(1);
            force_rport();
            fix_nated_contact();
            msg_apply_changes();
        }
        # NOTE: max_registrations (per-user, default from domain) is
        # not yet enforced here -- see STATUS.md "AOR / routing
        # design" for why: this Kamailio 5.7 build doesn't expose a
        # script-callable dynamic per-AOR contact-count check
        # (verified by testing, not assumed), and a manually-
        # maintained counter risks drifting from usrloc's own expiry.
        # Needs a version-verified approach against a real running
        # instance before shipping enforcement.
        # RFC 5626 (SIP Outbound) + Path -- STATUS: NOT CONFIRMED
        # WORKING. add_path() is called here (the documented, correct
        # place to wire it in), and registrar.use_path=1 is set (a
        # confirmed-required companion setting, without which
        # registrar ignores Path entirely). But live-testing this
        # session against the real binary could not get a Path value
        # to actually persist into the stored location record via
        # save("location") -- tried add_path() and add_path_received(),
        # with and without a client-sent Supported: path header, with
        # stun.so loaded (required for outbound.so's UDP flow-token
        # support, confirmed via a real warning) -- every attempt
        # returned a clean 200 OK with Path unset in ul.dump. Root
        # cause not yet isolated. Left wired in because it's harmless
        # either way (no errors, no rejected registrations, just
        # possibly ineffective right now) -- but do not assume this
        # provides working RFC 5626/Path support without further
        # verification. See DESIGN.md's Outbound/Path status note for
        # the full done/pending breakdown before building anything
        # (e.g. a domain/user-level toggle) on top of this.
        add_path();
        if (!save("location")) {
            $var(reject_reason) = "REGISTER for " + $td + " -- save(\"location\") failed";
            route(LOG_REJECTED);
            sl_reply_error();
        } else {
            $var(reg_expires) = $hdr(Expires);
            if ($var(reg_expires) == "" || $var(reg_expires) == $null) {
                $var(reg_expires) = "3600";
            }
            if ($var(reg_expires) != "0") {
                xlog("L_INFO", "REGISTERED-SUBSCRIBER ip=$si expires=$var(reg_expires) aor=$tU@$td\n");
            }
        }
        exit;
    }

    # Miss: this exact (listener, AOR) combination isn't recognized.
    #!ifdef SCANNER_BLOCK_ENABLED
    # Scanner fingerprint check -- only for REGISTERs that missed the
    # known-AOR fast path above (a real subscriber never reaches here).
    # Both the User-Agent signature and the IP-literal Contact tell
    # (real clients register with a domain/FQDN, scanners often use a
    # bare IP) are checked here since Contact identity is meaningful for
    # REGISTER. Dropped before the listener_settings lookup below.
    if ($ua =~ SCANNER_UA_REGEX) {
        $var(reject_reason) = "scanner fingerprint blocked (User-Agent)";
        route(LOG_REJECTED);
        exit;
    }
    if ($(ct{nameaddr.uri}) =~ "sip:[^@]*@?[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}") {
        $var(reject_reason) = "scanner fingerprint blocked (IP-literal Contact)";
        route(LOG_REJECTED);
        exit;
    }
    #!endif
    # Collapses what would otherwise be three distinct rejection
    # reasons (domain not bound to this profile / domain not
    # recognized on this node at all / username doesn't exist in an
    # otherwise-valid domain) into one fast-path outcome, per the
    # explicit design agreement this session -- the fine-grained
    # *why* isn't cheaply knowable without the SQL queries this path
    # exists to avoid, and doesn't need to be for a rejection.
    # Second htable, per the user's own suggestion: ip:port -> this
    # listener's own SIP Profile's unbound_domain settings, avoiding
    # even the 2 SQL queries the original miss-path design used --
    # this table is tiny (one row per listener, not per subscriber)
    # and reloads on the same sync cycle as everything else. Same
    # null-check discipline as the fast path above: check directly on
    # $sht(...), never after assigning to a $var() first.
    if ($sht(listener_settings=>$Ri:$Rp) != $null) {
        $var(ls) = $sht(listener_settings=>$Ri:$Rp);
        $var(ls_action) = $(var(ls){s.select,0,|});
        if ($var(ls_action) == "drop") {
            $var(reject_reason) = "REGISTER for " + $td + " -- domain not bound to this listener (configured action: silent drop)";
            route(LOG_REJECTED);
            exit;
        }
        if ($var(ls_action) == "challenge") {
            # Enumeration hardening: answer an unknown AOR with the SAME
            # 401 challenge a known user (wrong password) would get, so
            # existing and non-existing extensions are indistinguishable
            # to a prober. Realm = $td, identical to a genuine challenge
            # for this domain. An attacker that then supplies credentials
            # simply fails auth on the known-AOR path next time (the AOR
            # still won't exist), never learning which usernames are real.
            $var(reject_reason) = "REGISTER for " + $td + " -- unknown AOR, uniform 401 challenge (enumeration hardening)";
            route(LOG_REJECTED);
            www_challenge("$td", "0");
            exit;
        }
        # Real bug found via live testing this session: sl_send_reply's
        # code argument silently produces 500 for a STRING-typed PV,
        # even when its content is a valid-looking number -- confirmed
        # with a controlled 4-way comparison ($var(c)="404" fails,
        # $var(c)=404 unquoted works, a db1_INT column value works
        # even via an intermediate $var(), a db1_STRING/VARCHAR column
        # value fails the same way a plain string does). {s.select}
        # always returns a string result, so {s.int} is required here
        # to force integer type before sl_send_reply sees it --
        # {s.intv}, which looked like the more docs-recommended
        # choice, doesn't exist in this Kamailio 5.7.4 build (confirmed
        # via a parse error, not assumed).
        $var(ls_code) = $(var(ls){s.select,1,|}{s.int});
        $var(ls_text) = $(var(ls){s.select,2,|});
        $var(reject_reason) = "REGISTER for " + $td + " -- domain not bound to this listener (" + $var(ls_code) + " " + $var(ls_text) + ")";
        route(LOG_REJECTED);
        sl_send_reply("$var(ls_code)", "$var(ls_text)");
        exit;
    }
    # $Ri:$Rp has no listener_settings entry at all (shouldn't happen
    # for a real listener, but a sync gap is possible) -- fall back to
    # this node's own fallback reason rather than blocking on a data
    # gap.
    #!ifdef NODE_FALLBACK_REJECT_CODE
    $var(reject_reason) = "REGISTER for " + $td + " -- no listener_settings entry for " + $Ri + ":" + $Rp + " (node fallback reason)";
    route(LOG_REJECTED);
    sl_send_reply(NODE_FALLBACK_REJECT_CODE, NODE_FALLBACK_REJECT_TEXT);
    #!else
    $var(reject_reason) = "REGISTER for " + $td + " -- no listener_settings entry for " + $Ri + ":" + $Rp + " (no fallback configured either)";
    route(LOG_REJECTED);
    $var(rr_key) = "404_domain_not_found"; $var(rr_default) = "Domain Not Found"; route(RESP_REASON);
    sl_send_reply("404", "$var(rr_effective)");
    #!endif
    exit;
}


# ── Media Profile resolution -> real rtpengine behavior. Called from
#    HANDLE_CALL right before every route(RELAY), both the user-
#    destined and trunk-destined paths -- $var(inbound_media_profile_id)
#    was resolved in LOOKUP_PROFILE, $var(outbound_media_profile_id) in
#    TRY_PREFIX_IN_PROFILE/TRY_REGEX_IN_PROFILE (0 if this call routes
#    to a user rather than a trunk, or if genuinely unresolved -- both
#    treated the same way: inbound's own settings apply directly, no
#    combination-policy math needed since there's nothing to combine
#    against).
#
#    Compatibility checking is done BEFORE touching the SDP at all --
#    confirmed via direct testing against a real Kamailio instance
#    this session that sdp_keep_codecs_by_name() silently no-ops
#    rather than truly emptying the result when nothing would remain,
#    so a scrub-then-inspect approach is NOT reliable here. Building
#    an explicit allowlist first (walking inbound's priority list,
#    checking each candidate against outbound's list via regex
#    containment, then against the real offer via
#    sdp_with_codecs_by_name()) and only calling the real scrub once
#    we already know the result is non-empty avoids that landmine
#    entirely -- also verified empirically this session. ──────────────
# (route[CHECK_RATE_LIMIT] retired here -- all 5 rate-limit scopes
# (global, register, domain, user, trunk) have been migrated off of
# it: global/register to compile-time constants generated by
# generate_sip_config.py, domain/user/trunk folded directly into
# subscriber_auth's second key / Entry B, resolved from data already
# in memory at the point each is checked. Confirmed zero remaining
# callers before removal.)

route[APPLY_MEDIA_PROFILE] {
    # Explicit design requirement: when a routing rule (of any engine --
    # prefix, regex, LCR, arithmetic, bridge, direct dispatcher) doesn't
    # specify its own media_profile_id override, outbound media
    # handling falls back to the DESTINATION TRUNK's own media_profile_
    # id, not straight through to "no outbound profile at all". Placed
    # here, once, rather than in each individual routing engine's own
    # query -- every one of this route's five call sites benefits
    # automatically. Only applies when target_setid is actually set (a
    # genuine trunk destination); a subscriber-destined call correctly
    # has no trunk to fall back to. Same dispatcher.attrs media_profile=
    # extraction already verified working in the earlier failover fix.
    if ($var(outbound_media_profile_id) == 0 && $var(target_setid) != $null && $var(target_setid) != "0" && $var(target_setid) != "") {
        $var(ampfb_attrs) = $sht(dispatcher_attrs=>$var(target_setid));
        if ($var(ampfb_attrs) != $null && $var(ampfb_attrs) =~ "media_profile=") {
            $var(outbound_media_profile_id) = $(var(ampfb_attrs){re.subst,/.*media_profile=([0-9]+).*/\1/}{s.int});
        }
    }

    $var(in_mode) = "transparent";
    $var(in_codec_order) = "";
    $var(in_policy) = "most_restrictive";
    $var(in_nat_mode) = "auto";
    $var(in_late_neg) = 1;
    $var(in_dtmf) = "rfc2833";
    if ($var(inbound_media_profile_id) > 0) {
        $var(imp_val) = $sht(media_profiles=>$var(inbound_media_profile_id));
        if ($var(imp_val) != $null && $var(imp_val) != "") {
            $var(in_mode) = $(var(imp_val){s.select,0,|});
            $var(in_codec_order) = $(var(imp_val){s.select,1,|});
            $var(in_policy) = $(var(imp_val){s.select,2,|});
            $var(in_nat_mode) = $(var(imp_val){s.select,3,|});
            $var(in_late_neg) = $(var(imp_val){s.select,4,|});
            $var(in_dtmf) = $(var(imp_val){s.select,5,|});
        }
    }
    # telephone-event (RFC 4733/2833) is an EVENT PAYLOAD negotiated
    # alongside the audio codec, not an audio codec itself -- stripped
    # from both lists here, once, so no downstream logic (proxy
    # compatibility, intersection, transcode-target, negotiated-codec
    # reporting) ever treats it as one. Its preservation for DTMF is
    # handled explicitly via dtmf_mode at scrub time instead -- an
    # admin's codec-order choices can no longer accidentally break
    # DTMF either way.
    if ($var(in_codec_order) != $null && $var(in_codec_order) != "") {
        $var(in_codec_order) = $(var(in_codec_order){re.subst,/telephone-event//g});
        $var(in_codec_order) = $(var(in_codec_order){re.subst,/,,+/,/g});
        $var(in_codec_order) = $(var(in_codec_order){re.subst,/^,//});
        $var(in_codec_order) = $(var(in_codec_order){re.subst,/,$//});
    }

    $var(out_mode) = "";
    $var(out_codec_order) = "";
    $var(out_nat_mode) = "auto";
    if ($var(outbound_media_profile_id) > 0) {
        $var(omp_val) = $sht(media_profiles=>$var(outbound_media_profile_id));
        if ($var(omp_val) != $null && $var(omp_val) != "") {
            $var(out_mode) = $(var(omp_val){s.select,0,|});
            $var(out_codec_order) = $(var(omp_val){s.select,1,|});
            $var(out_nat_mode) = $(var(omp_val){s.select,3,|});
        }
    }
    # Same event-payload normalization as the inbound list above --
    # matters most for the intersection check: an inbound list with
    # telephone-event intersected against an outbound list without it
    # would otherwise drop DTMF on pure list-membership accident.
    if ($var(out_codec_order) != $null && $var(out_codec_order) != "") {
        $var(out_codec_order) = $(var(out_codec_order){re.subst,/telephone-event//g});
        $var(out_codec_order) = $(var(out_codec_order){re.subst,/,,+/,/g});
        $var(out_codec_order) = $(var(out_codec_order){re.subst,/^,//});
        $var(out_codec_order) = $(var(out_codec_order){re.subst,/,$//});
    }
    # Combined NAT hint for route[RTPENGINE_OFFER] below -- covers
    # BOTH subscriber-originated/-destined and trunk-originated/
    # -destined calls uniformly, since inbound_media_profile_id/
    # outbound_media_profile_id are already resolved for both source
    # types by route[LOOKUP_PROFILE] above (this is the same
    # resolution the codec-compatibility system already relies on --
    # no new machinery needed, just reusing it). Either leg wanting
    # "force" wins, since NAT is a per-endpoint property and either
    # side of the call could be the one behind it. Matches the
    # existing "no outbound profile -> inbound's own settings apply
    # directly" fallback used for codec_order/media_mode just below --
    # when there's no outbound profile at all (a subscriber-destined
    # call has none), the inbound leg's own nat_mode simply applies.
    $var(effective_nat_mode) = $var(in_nat_mode);
    if ($var(out_nat_mode) == "force") { $var(effective_nat_mode) = "force"; }

    $var(in_mode_num) = 1;
    if ($var(in_mode) == "bypass") { $var(in_mode_num) = 0; }
    if ($var(in_mode) == "proxy") { $var(in_mode_num) = 2; }
    if ($var(in_mode) == "transcoding") { $var(in_mode_num) = 3; }

    $var(out_mode_num) = 1;
    if ($var(out_mode) == "bypass") { $var(out_mode_num) = 0; }
    if ($var(out_mode) == "proxy") { $var(out_mode_num) = 2; }
    if ($var(out_mode) == "transcoding") { $var(out_mode_num) = 3; }

    # Combination logic -- locked spec from design discussion.
    $var(effective_mode_num) = $var(in_mode_num);
    $var(consider_outbound_codecs) = 1;
    $var(rtpengine_extra_flags) = "";

    if ($var(in_mode_num) == 0) {
        # Bypass always wins absolutely -- no anchor exists, nothing to
        # apply a combination policy to in the first place.
        $var(effective_mode_num) = 0;
    } else if ($var(outbound_media_profile_id) == 0) {
        # No outbound profile resolved (user-destined call, or
        # genuinely unresolved) -- inbound's own settings apply
        # directly, nothing to combine against.
        $var(effective_mode_num) = $var(in_mode_num);
        $var(consider_outbound_codecs) = 0;
    } else if ($var(in_policy) == "least_restrictive") {
        $var(effective_mode_num) = $var(in_mode_num);
        if ($var(out_mode_num) < $var(effective_mode_num)) { $var(effective_mode_num) = $var(out_mode_num); }
    } else if ($var(in_policy) == "inbound_wins") {
        $var(effective_mode_num) = $var(in_mode_num);
        $var(consider_outbound_codecs) = 0;
    } else if ($var(in_policy) == "blend") {
        # Inbound alone decides anchor-vs-bypass and reject-vs-
        # transcode; outbound's codec_order still folds into the
        # compatibility check regardless (consider_outbound_codecs
        # stays 1).
        $var(effective_mode_num) = $var(in_mode_num);
    } else {
        # most_restrictive (also the default/fallback for an unknown
        # policy value, which should never happen given the DB CHECK
        # constraint, but fails safe toward MORE scrubbing rather than
        # less if it somehow did).
        $var(effective_mode_num) = $var(in_mode_num);
        if ($var(out_mode_num) > $var(effective_mode_num)) { $var(effective_mode_num) = $var(out_mode_num); }
    }

    $dlg_var(media_anchored) = "0";
    xlog("L_INFO", "$ci: MEDIA_DECISION: in_profile=$var(inbound_media_profile_id) in_mode=$var(in_mode) out_profile=$var(outbound_media_profile_id) out_mode=$var(out_mode) policy=$var(in_policy) effective_mode_num=$var(effective_mode_num) target_setid=$var(target_setid)\n");

    if ($var(effective_mode_num) == 0) {
        return;
    }

    if (!has_body("application/sdp")) {
        # Late negotiation (delayed offer, RFC 3261): no SDP in the
        # INVITE means the peer's offer arrives in the 2xx and the
        # caller's answer in the ACK. Previously this returned bare --
        # such calls could never anchor at all. Now: build and persist
        # re_flags (build-only, no offer possible yet) and mark the
        # dialog as awaiting the peer's offer; onreply handles the
        # 2xx-offer, the in-dialog ACK handler pairs the answer.
        # Codec scrubbing is genuinely undecidable pre-SDP (nothing to
        # evaluate against the allowlist yet), so late-offer dialogs
        # anchor transparent-style -- logged explicitly, not silently.
        $var(rteo_build_only) = "1";
        route(RTPENGINE_OFFER);
        $dlg_var(pending_peer_offer) = "1";
        if ($var(in_late_neg) == 0 && $var(effective_mode_num) >= 2 && $var(in_codec_order) != "") {
            # Late negotiation DISABLED on the inbound profile (proxy/
            # transcoding modes): enforce codec policy anyway by
            # building the allowlist purely from the profiles (inbound
            # codec_order filtered against outbound's, same
            # intersection the SDP-present path uses -- the SDP-
            # presence filter is genuinely impossible pre-SDP). The
            # reply handler scrubs the peer's 2xx offer against this
            # before it ever reaches the caller.
            $var(ln_allow) = "";
            $var(ln_idx) = 0;
            $var(ln_more) = 1;
            while ($var(ln_more) == 1) {
                $var(ln_cand) = $(var(in_codec_order){s.select,$var(ln_idx),,});
                if ($var(ln_cand) == "") {
                    $var(ln_more) = 0;
                } else {
                    $var(ln_ok) = 1;
                    if ($var(consider_outbound_codecs) == 1 && $var(out_codec_order) != "") {
                        $var(ln_pattern) = "(^|,)" + $var(ln_cand) + "(,|$)";
                        if (!($var(out_codec_order) =~ $var(ln_pattern))) { $var(ln_ok) = 0; }
                    }
                    if ($var(ln_ok) == 1) {
                        if ($var(ln_allow) == "") { $var(ln_allow) = $var(ln_cand); }
                        else { $var(ln_allow) = $var(ln_allow) + "," + $var(ln_cand); }
                    }
                    $var(ln_idx) = $var(ln_idx) + 1;
                }
            }
            if ($var(ln_allow) != "" && $var(in_dtmf) == "rfc2833") {
                # Same DTMF preservation as the SDP-present path --
                # telephone-event survives the 2xx-offer scrub by
                # configuration whenever RFC2833 DTMF is in use.
                $var(ln_allow) = $var(ln_allow) + ",telephone-event";
            }
            $dlg_var(media_scrub_list) = $var(ln_allow);
            xlog("L_INFO", "MEDIA_SUMMARY: callid=$ci offered=(none -- late negotiation, offer expected in 2xx) scrubbed=(policy enforced on 2xx offer: $var(ln_allow))\n");
        } else {
            $dlg_var(media_scrub_list) = "";
            xlog("L_INFO", "MEDIA_SUMMARY: callid=$ci offered=(none -- late negotiation, offer expected in 2xx) scrubbed=(none -- transparent-style anchor)\n");
        }
        return;
    }

    if ($var(effective_mode_num) < 2) {
        # Transparent -- anchor only, codecs pass through untouched.
        # Persisted empty so mid-call re-INVITE/UPDATE handling knows
        # this dialog's established policy is pass-through too.
        $dlg_var(media_scrub_list) = "";
        xlog("L_INFO", "MEDIA_SUMMARY: callid=$ci offered=(not tracked -- transparent mode) scrubbed=(none -- pass-through)\n");
        route(RTPENGINE_OFFER);
        return;
    }

    # Proxy or Transcoding -- build the real allowlist before touching
    # the SDP at all. Also tracks "offered" separately from the final
    # "allowlist" -- offered is every in_codec_order candidate actually
    # present in the caller's SDP, before outbound-compatibility
    # filtering; allowlist is what survives after that filter too.
    # Both logged via MEDIA_SUMMARY below for diagnosing exactly where
    # a codec dropped out (never offered at all, vs. offered but
    # incompatible with the outbound side).
    $var(allowlist) = "";
    $var(offered) = "";
    $var(idx) = 0;
    $var(more) = 1;
    while ($var(more) == 1) {
        $var(cand) = $(var(in_codec_order){s.select,$var(idx),,});
        if ($var(cand) == "") {
            $var(more) = 0;
        } else {
            if (sdp_with_codecs_by_name("$var(cand)")) {
                if ($var(offered) == "") {
                    $var(offered) = $var(cand);
                } else {
                    $var(offered) = $var(offered) + "," + $var(cand);
                }
                $var(cand_ok) = 1;
                if ($var(consider_outbound_codecs) == 1 && $var(out_codec_order) != "") {
                    $var(out_match_pattern) = "(^|,)" + $var(cand) + "(,|$)";
                    if (!($var(out_codec_order) =~ $var(out_match_pattern))) {
                        $var(cand_ok) = 0;
                    }
                }
                if ($var(cand_ok) == 1) {
                    if ($var(allowlist) == "") {
                        $var(allowlist) = $var(cand);
                    } else {
                        $var(allowlist) = $var(allowlist) + "," + $var(cand);
                    }
                }
            }
            $var(idx) = $var(idx) + 1;
        }
    }
    # Persisted for the answer-time negotiated-codec check in
    # onreply_route -- $var()s don't survive from this request's
    # processing into the later reply's own, separate processing,
    # $dlg_var() (dialog-scoped) does.
    $dlg_var(media_candidates) = $var(offered);

    if ($var(allowlist) != "") {
        # DTMF event payload preserved by configuration, not by list
        # membership: dtmf_mode=rfc2833 means telephone-event MUST
        # survive scrubbing for DTMF to work at all -- appended here
        # automatically (and persisted into media_scrub_list below, so
        # mid-call re-offers preserve it too). Appended only when a
        # real audio allowlist exists -- telephone-event alone can
        # never satisfy proxy-mode compatibility.
        if ($var(in_dtmf) == "rfc2833") {
            $var(allowlist) = $var(allowlist) + ",telephone-event";
        }
        # Confirmed non-empty -- safe to actually scrub now. Persisted
        # so mid-call re-INVITE/UPDATE offers get scrubbed against the
        # exact same allowlist established here at setup -- codec
        # policy holds for the whole dialog, not just the first offer.
        $dlg_var(media_scrub_list) = $var(allowlist);
        xlog("L_INFO", "MEDIA_SUMMARY: callid=$ci offered=$var(offered) scrubbed=$var(allowlist)\n");
        sdp_keep_codecs_by_name("$var(allowlist)");
        route(RTPENGINE_OFFER);
        return;
    }

    if ($var(effective_mode_num) == 2) {
        xlog("L_INFO", "MEDIA_SUMMARY: callid=$ci offered=$var(offered) scrubbed=(none -- rejected)\n");
        xlog("L_INFO", "$ci: no compatible codec between inbound/outbound media profiles (Proxy mode) -- rejecting\n");
        $var(rr_key) = "488_not_acceptable"; $var(rr_default) = "Not Acceptable Here"; route(RESP_REASON);
        sl_send_reply("488", "$var(rr_effective)");
        exit;
    }

    xlog("L_INFO", "MEDIA_SUMMARY: callid=$ci offered=$var(offered) scrubbed=(none -- forcing transcode)\n");
    # Transcoding: no natural match -- force to inbound's highest-
    # priority codec (first entry in its list); rtpengine transcodes
    # since nothing on the offer side matches naturally. The
    # codec-transcode extra flag lands in re_flags, which is persisted
    # by RTPENGINE_OFFER for mid-call reuse -- so a mid-call re-offer
    # keeps the same transcode target automatically. media_scrub_list
    # deliberately stays empty here: the original offer's codecs were
    # NOT scrubbed in this mode (nothing matched to keep), so mid-call
    # offers shouldn't be scrubbed either.
    $dlg_var(media_scrub_list) = "";
    $var(transcode_target) = $(var(in_codec_order){s.select,0,,});
    if ($var(transcode_target) != "") {
        $var(rtpengine_extra_flags) = "codec-transcode-" + $var(transcode_target);
    }
    route(RTPENGINE_OFFER);
}

route[RTPENGINE_OFFER] {
    $var(re_flags) = "replace-origin replace-session-connection";
    # Media security -- RTP Inject/Bleed mitigation (CVE-2025-53399).
    # strict-source + a learning mode makes rtpengine reject RTP
    # packets from any source other than the actual learned call
    # endpoint, closing the inject/bleed exposure that an open RTP
    # port range otherwise carries. The exact flag string is resolved
    # per-node from platform_nodes.rtpengine_media_security and emitted
    # as MEDIA_SECURITY_FLAGS by generate_sip_config.py. #!ifdef-
    # guarded so a config still compiles if generated by an older
    # generator that predates this define (staggered upgrade) -- it
    # just falls back to no mitigation until the fragment is
    # regenerated, rather than failing to load.
    #!ifdef MEDIA_SECURITY_FLAGS
    if (MEDIA_SECURITY_FLAGS != "") {
        $var(re_flags) = $var(re_flags) + " " + MEDIA_SECURITY_FLAGS;
    }
    #!endif
    if ($var(rtpengine_extra_flags) != "") {
        $var(re_flags) = $var(re_flags) + " " + $var(rtpengine_extra_flags);
    }
    # T.38 fax gateway -- confirmed genuinely supported by rtpengine
    # (built on libspandsp, the same library Asterisk/FreeSWITCH use),
    # via the same "T.38=..." NG-protocol flag rtpengine_offer() itself
    # accepts. Resolved from the trunk's Media Profile fax_mode (synced
    # into ds_attrs the same way dtmf/srtp already are). Passthrough
    # (the default) adds no flag at all -- zero behavior change, both
    # ends negotiate T.38/G.711 directly with no gateway involved.
    #
    # Scoped to outbound/trunk-sourced calls only: ds_attrs only ever
    # holds dispatcher's own per-trunk attrs, populated by
    # ds_select_dst() for the OUTBOUND leg. Inbound/subscriber-sourced
    # fax_mode is not wired here -- would need the same depth of
    # inbound/outbound Media Profile reconciliation the codec
    # compatibility system already has (LOOKUP_PROFILE's
    # inbound_media_profile_id/outbound_media_profile_id/
    # consider_outbound_codecs machinery), which is real, separate
    # scope, not folded in here.
    $var(trunk_fax_mode) = "";
    if ($var(attrs_raw) =~ "fax_mode=") {
        $var(trunk_fax_mode) = $(var(attrs_raw){re.subst,/.*fax_mode=([a-z0-9_]+).*/\1/});
    }
    if ($var(trunk_fax_mode) == "t38_gateway") {
        $var(re_flags) = $var(re_flags) + " T.38=decode";
    } else if ($var(trunk_fax_mode) == "g711_gateway") {
        $var(re_flags) = $var(re_flags) + " T.38=force";
    }
    # NAT handling -- resolved earlier in this same route
    # (route[APPLY_MEDIA_PROFILE], just above where this route is
    # called from) as $var(effective_nat_mode), combining BOTH the
    # inbound and outbound legs' Media Profiles -- covers
    # subscriber-originated/-destined calls too, not just trunk ones,
    # via the same inbound_media_profile_id/outbound_media_profile_id
    # resolution the codec-compatibility system already relies on.
    # Only "force" needs an explicit flag -- RTPEngine's own default
    # behavior already covers "auto" (infer from SDP/source), and
    # "off" is also the natural no-flag default, so both add nothing.
    # dtmf_mode/srtp_mode deliberately NOT wired here -- confirmed via
    # direct research that neither maps to a simple RTPEngine NG flag
    # the way nat_mode's "force" does (SRTP is governed by nuanced
    # SDES/DTLS option flags, not a single require/reject toggle;
    # dtmf_mode is an SDP-negotiation concern, not an RTPEngine flag
    # at all) -- left as a known, documented gap rather than a guessed
    # flag with no real RTPEngine instance available to validate it
    # against.
    if ($var(effective_nat_mode) == "force") {
        $var(re_flags) = $var(re_flags) + " force";
    }
    if ($var(should_record) == 1) {
        # Format confirmed directly from rtpengine's own maintainers
        # (not the JSON-looking {key:val,key2:val2} form seen in some
        # third-party examples, which is actually wrong): pipe-
        # separated key:value pairs, no braces, no commas. This same
        # string is what rtpengine-recording's output-pattern
        # %{key} substitution reads from, and what shows up verbatim
        # in the raw metadata file's own "generic metadata" section
        # even without that daemon involved at all.
        $var(re_flags) = $var(re_flags) + " record-call=yes metadata="
            + "callid:" + $ci
            + "|from_tag:" + $ft
            + "|from_user:" + $fU
            + "|to_user:" + $rU
            + "|node_id:" + $avp(cdr_node_id)
            + "|inbound_sip_profile_id:" + $dlg_var(inbound_sip_profile_id)
            + "|outbound_sip_profile_id:" + $dlg_var(outbound_sip_profile_id)
            + "|inbound_trunk_id:" + $dlg_var(inbound_trunk_id)
            + "|inbound_domain_id:" + $dlg_var(inbound_domain_id)
            + "|inbound_subscriber:" + $dlg_var(inbound_subscriber)
            + "|outbound_trunk_id:" + $dlg_var(outbound_trunk_id)
            + "|outbound_domain_id:" + $dlg_var(outbound_domain_id)
            + "|outbound_subscriber:" + $dlg_var(outbound_subscriber)
            + "|start_time:" + $Ts;
    }
    if ($var(rteo_build_only) == "1") {
        # Build-only: persist the fully-built flags for later use (the
        # dialog's first SDP hasn't arrived yet -- late negotiation),
        # without attempting an offer there's no body for.
        $dlg_var(re_flags) = $var(re_flags);
        return;
    }
    if (rtpengine_offer("$var(re_flags)")) {
        $dlg_var(media_anchored) = "1";
        # Persisted so a later in-dialog re-INVITE/UPDATE (route
        # [MID_CALL_MEDIA_UPDATE] below) can re-offer using the exact
        # same, already-established flags -- not re-run the mode-
        # combination/codec-compatibility/T.38 decision logic above,
        # which is specifically about the INITIAL negotiation and
        # shouldn't silently produce a different result mid-call.
        $dlg_var(re_flags) = $var(re_flags);
    } else {
        xlog("L_ERR", "$ci: rtpengine_offer failed\n");
    }
}

route[RELAY] {
    $dlg_var(relay_du) = $du;

    # User-Agent override -- explicit remove_hf()/append_hf() here
    # because the core user_agent_header global parameter (set once,
    # process-wide) does NOT touch an existing header on a message
    # being relayed/proxied through -- confirmed via live testing this
    # session -- it only applies to requests Kamailio builds from
    # scratch. Without this, the original sender's own User-Agent
    # (e.g. a trunk's PBX signature) passes straight through to
    # whatever this call is being relayed to, unchanged, regardless of
    # this node's own user_agent_header setting. #!ifdef'd since
    # PLATFORM_USER_AGENT is only emitted when the effective value is
    # non-empty -- an empty value correctly means "leave it as-is",
    # matching the catalog's own documented default.
#!ifdef PLATFORM_USER_AGENT
    if (is_present_hf("User-Agent")) {
        remove_hf("User-Agent");
        append_hf("User-Agent: " + PLATFORM_USER_AGENT + "\r\n");
    }
#!endif

    # Strip stale credential-response headers before relaying --
    # real, confirmed bug (live trace): Authorization/Proxy-
    # Authorization is always a response to THIS node's own challenge,
    # consumed and validated right here, at whichever point this
    # message was first authenticated. It has no meaning to -- and
    # must never reach -- the next hop, whether that's another
    # subscriber or an outbound trunk. uac_auth() (in MANAGE_FAILURE)
    # adds its own, correct Proxy-Authorization for the OUTBOUND
    # trunk's own separate challenge after this point when needed --
    # stripping here first prevents the inbound leg's stale header
    # from ever being relayed alongside or instead of it.
    if (is_present_hf("Authorization")) { remove_hf("Authorization"); }
    if (is_present_hf("Proxy-Authorization")) { remove_hf("Proxy-Authorization"); }

    # Tagged trace for dimensional Homer correlation (node/profile/
    # trunk/domain) -- confirmed via direct testing this session that
    # msg_apply_changes() is NOT actually required for these tagged
    # headers to reach the wire: t_relay() applies every pending lump
    # (both record_route()'s own and every append_hf() added earlier
    # in this file) to the real, forwarded message on its own,
    # regardless of whether msg_apply_changes() ever runs -- confirmed
    # live via a captured proxy test showing both Record-Route and a
    # tagged header present on the actual relayed message. This call
    # WAS previously here to make sip_trace()'s own separately-
    # captured Homer copy include the tagged headers too, but that is
    # a visibility nicety, not a protocol requirement, and it directly
    # conflicts with record_route() -- a known, hard Kamailio
    # limitation (confirmed via an identical, unresolved 2021 sr-users
    # report hitting the exact same error) that produced a genuine,
    # real failure on every call that reached this route: "cannot
    # apply msg changes after adding record-route header - it breaks
    # conditional 2nd header". Removed rather than reordered, since
    # record_route() runs long before this point and reordering isn't
    # possible. This is IN ADDITION to the existing trace_mode=1
    # automatic capture and other explicit sip_trace() calls elsewhere
    # in this file, which are unaffected by this change.
    sip_trace();
    xlog("L_INFO", "DIAG_RELAY: $ci pre-relay du=$du ru=$ru outbound_trunk_id=$var(outbound_trunk_real_id)\n");
    t_on_reply("DIAG_OUTBOUND_REPLY");
    if (!t_relay()) {
        $var(reject_reason) = "t_relay() failed at final relay stage";
        route(LOG_REJECTED);
        sl_reply_error();
    }
    exit;
}

onreply_route[DIAG_OUTBOUND_REPLY] {
    xlog("L_INFO", "DIAG_REPLY: $ci status=$rs cseq=$cs via=$hdr(Via) from=$si:$sp\n");
}

onreply_route {
    # Response-side vendor-header masking, symmetric to route[RELAY]'s
    # existing request-side User-Agent masking. Real gap found this
    # session: a carrier's own SBC identity (Sangoma SIPStation's
    # "NetBorder Session Controller") was leaking straight through on
    # every relayed response back to the original caller/PBX --
    # confirmed via a live trace showing it unmasked on 100 Trying, 407,
    # and 403 responses alike. Strips BOTH User-Agent and Server: some
    # carrier SBCs (NetBorder, confirmed live) put their vendor identity
    # in User-Agent even on responses, not just the more conventional
    # Server header, so both need stripping to reliably close this for
    # any far end. Applies uniformly to every reply, not just finals --
    # this is pure vendor-identity masking, never something the caller
    # functionally needs.
#!ifdef PLATFORM_SERVER_HEADER
    $var(had_vendor_hdr) = 0;
    if (is_present_hf("User-Agent")) { remove_hf("User-Agent"); $var(had_vendor_hdr) = 1; }
    if (is_present_hf("Server")) { remove_hf("Server"); $var(had_vendor_hdr) = 1; }
    if ($var(had_vendor_hdr) == 1) {
        append_hf("Server: " + PLATFORM_SERVER_HEADER + "\r\n");
    }
#!endif

    # Response-side identity-header rewrite, same reasoning and same
    # gap-class as the vendor-header masking directly above, but for
    # P-Asserted-Identity/Remote-Party-ID/Privacy specifically -- real
    # gap found via live trace this session: an upstream trunk's own
    # domain (e.g. "trunk1.uk.sipstation.com") was passing straight
    # through on replies, unmodified, all the way back to the original
    # subscriber -- revealing which specific upstream provider handled
    # the call. Deliberately REWRITE, not strip -- confirmed against
    # RFC 3325 itself, which states removal on this leg is discretionary
    # and its own stated preference leans toward keeping identity
    # information flowing ("SHOULD NOT be removed unless local privacy
    # policies prevent it, because removal may cause services based on
    # Asserted Identity to fail"). Preserves whatever real value the
    # asserted user-part carries for the receiving UA while masking the
    # topology-revealing domain -- same node's own __FQDN__ this
    # platform already uses for its own identity everywhere else.
    if (is_present_hf("P-Asserted-Identity")) {
        $var(ohdr_pai_orig) = $hdr(P-Asserted-Identity);
        $var(ohdr_pai_user) = $(hdr(P-Asserted-Identity){re.subst,/.*sip:([^@;>]+)@[^>;]*.*/\1/});
        remove_hf("P-Asserted-Identity");
    }
    if (is_present_hf("P-Asserted-Identity") == 0 && $var(ohdr_pai_user) != $null && $var(ohdr_pai_user) != "" && $var(ohdr_pai_user) != $var(ohdr_pai_orig)) {
        append_hf("P-Asserted-Identity: <sip:$var(ohdr_pai_user)@__FQDN__>\r\n");
    }
    if (is_present_hf("Remote-Party-ID")) {
        $var(ohdr_rpid_orig) = $hdr(Remote-Party-ID);
        $var(ohdr_rpid_user) = $(hdr(Remote-Party-ID){re.subst,/.*sip:([^@;>]+)@[^>;]*.*/\1/});
        remove_hf("Remote-Party-ID");
    }
    if (is_present_hf("Remote-Party-ID") == 0 && $var(ohdr_rpid_user) != $null && $var(ohdr_rpid_user) != "" && $var(ohdr_rpid_user) != $var(ohdr_rpid_orig)) {
        append_hf("Remote-Party-ID: <sip:$var(ohdr_rpid_user)@__FQDN__>;party=called;screen=yes;privacy=off\r\n");
    }
    # Privacy carries no topology/identity payload of its own -- pure
    # policy signaling (id/header/session/none) -- so no rewrite is
    # needed, just confirming nothing here strips it: an upstream
    # trunk's own Privacy header on a reply should pass through
    # unmodified, same as today.

    if ($rs =~ "2[0-9][0-9]") {
        # to_tag isn't assigned until the answering side generates it
        # in the final response -- captured here via dlg_var, same
        # reasoning as everything else that needs to survive to
        # BYE-time CDR generation. Not usable in the offer-time
        # recording metadata for the same reason: it genuinely doesn't
        # exist yet when rtpengine_offer() runs on the INVITE.
        $dlg_var(call_to_tag) = $tt;
        # Captured explicitly here, not read directly from $rs inside
        # cdr_extra -- confirmed from acc's own source
        # (cdr_on_end_confirmed passes params->req, the BYE request
        # itself, not a reply, as the CDR write's message context) that
        # $rs would not be reliably readable at that point for a call
        # that was answered and hung up normally. This is genuinely a
        # reply being processed right now, so $rs is trustworthy here.
        # The separate reply_status field in cdr_extra (below) covers
        # the OTHER path -- a call that never got this far and fails
        # via cdr_on_failed instead, confirmed via direct testing that
        # $rs IS reliable there (a real 486 test correctly produced
        # reply_status=486).
        $dlg_var(final_sip_code) = $rs;
    }
    if ($rs =~ "[12][0-9][0-9]") {
        if (has_body("application/sdp")) {
            # Negotiated-codec logging -- checks the answer SDP against
            # the candidate list persisted during the offer phase
            # (route[APPLY_MEDIA_PROFILE]'s $dlg_var(media_candidates)
            # -- $var()s don't survive from that request's processing
            # into this reply's own, separate processing). Scoped to
            # the final 2xx specifically, not every 1xx/2xx with SDP
            # (e.g. early media in a 183), since this is meant to show
            # the final negotiated codec, not every provisional one.
            if ($rs =~ "2[0-9][0-9]" && $dlg_var(media_anchored) == "1" && $dlg_var(media_candidates) != $null && $dlg_var(media_candidates) != "") {
                $var(candidates) = $dlg_var(media_candidates);
                $var(negotiated) = "(none of the offered candidates found in answer)";
                $var(idx) = 0;
                $var(more) = 1;
                while ($var(more) == 1) {
                    $var(cand) = $(var(candidates){s.select,$var(idx),,});
                    if ($var(cand) == "") {
                        $var(more) = 0;
                    } else {
                        if (sdp_with_codecs_by_name("$var(cand)")) {
                            $var(negotiated) = $var(cand);
                            $var(more) = 0;
                        }
                        $var(idx) = $var(idx) + 1;
                    }
                }
                xlog("L_INFO", "MEDIA_SUMMARY: callid=$ci negotiated=$var(negotiated)\n");
                $dlg_var(negotiated_codec) = $var(negotiated);
                xlog("L_INFO", "DIAG_CHECKPOINT: A (after negotiated_codec set)\n");
            }
            # Only if this dialog's media was actually anchored via
            # APPLY_MEDIA_PROFILE -- a Bypass-mode call never called
            # rtpengine_offer(), and calling answer() without a prior
            # matching offer() is asymmetric and unreliable (this is
            # exactly the class of bug found and fixed earlier this
            # session -- see the git history for the original
            # unconditional/unpaired rtpengine_answer() gap).
            #
            # Direction matters: if this dialog is awaiting a PEER
            # offer (late negotiation -- initial INVITE had no SDP --
            # or an offerless re-INVITE/UPDATE), this 2xx body is an
            # OFFER, not an answer: it goes through rtpengine_offer()
            # with the dialog's established flags, and for the late-
            # negotiation case this is where the dialog first anchors
            # at all. The caller's answer then arrives in the ACK,
            # paired by the in-dialog ACK handler. Running answer() on
            # an offer here (the previous unconditional behavior) was
            # a genuine offer/answer direction mismatch.
            xlog("L_INFO", "DIAG_CHECKPOINT: B (before pending_peer_offer check) pending_peer_offer=$dlg_var(pending_peer_offer) media_anchored=$dlg_var(media_anchored)\n");
            if ($dlg_var(pending_peer_offer) == "1" && $rs =~ "2[0-9][0-9]") {
                xlog("L_INFO", "DIAG_CHECKPOINT: C (entered pending_peer_offer branch)\n");
                if ($dlg_var(media_scrub_list) != $null && $dlg_var(media_scrub_list) != "" && !($rb =~ "m=image")) {
                    xlog("L_INFO", "DIAG_CHECKPOINT: D (before sdp_keep_codecs_by_name)\n");
                    sdp_keep_codecs_by_name("$dlg_var(media_scrub_list)");
                    xlog("L_INFO", "DIAG_CHECKPOINT: E (after sdp_keep_codecs_by_name)\n");
                }
                xlog("L_INFO", "DIAG_CHECKPOINT: F (before rtpengine_offer)\n");
                if (rtpengine_offer("$dlg_var(re_flags)")) {
                    xlog("L_INFO", "DIAG_CHECKPOINT: G (rtpengine_offer succeeded)\n");
                    $dlg_var(media_anchored) = "1";
                    if (has_body("application/sdp")) { subst_body('/\r\no=\S+/\r\no=-/'); }
                    xlog("L_INFO", "DIAG_CHECKPOINT: H (after subst_body in offer branch)\n");
                } else {
                    xlog("L_ERR", "$ci: rtpengine_offer on 2xx peer-offer failed (late negotiation / offerless reinvite)\n");
                }
            } else if ($dlg_var(media_anchored) == "1") {
                xlog("L_INFO", "DIAG_CHECKPOINT: I (before rtpengine_answer)\n");
                rtpengine_answer("replace-origin replace-session-connection");
                xlog("L_INFO", "DIAG_CHECKPOINT: J (rtpengine_answer returned)\n");
                if (has_body("application/sdp")) { subst_body('/\r\no=\S+/\r\no=-/'); }
                xlog("L_INFO", "DIAG_CHECKPOINT: K (after subst_body in answer branch)\n");
            }
            xlog("L_INFO", "DIAG_CHECKPOINT: L (end of onreply_route reached)\n");
        }
    }
}

# Captures Kamailio-initiated requests (dispatcher OPTIONS pings,
# uac REGISTER) that never pass through request_route -- see
# docs/ROUTING-ENGINE.md.
event_route[tm:local-request] {
    sip_trace();
    t_on_reply("LOCAL_REQUEST_REPLY");
}
onreply_route[LOCAL_REQUEST_REPLY] {
    sip_trace();
    # Outbound-REGISTER success -> log the RESOLVED trunk IP so the
    # firewall can whitelist it without independently resolving DNS.
    # $si is the actual IP that answered -- Kamailio already did the A/
    # SRV resolution to send the REGISTER, so this authoritatively
    # tracks hostname- and SRV-based trunks (and literal-IP ones),
    # staying correct through DNS failover/round-robin because it's
    # whatever Kamailio actually reached. Scoped to 2xx REGISTER replies
    # only: a challenge (401/407) or failure never whitelists anything.
    # The kamailio-fw-trunk-resolved watcher consumes this line and adds
    # $si to the trunk_trusted ipset with a timeout derived from the
    # registration expiry, so the entry auto-refreshes on each REGISTER
    # cycle and auto-expires if the trunk stops registering or its IP
    # moves. $hdr(Expires) or the Contact expires drives the lifetime;
    # fall back to a sane default when the reply carries neither.
    if (is_method("REGISTER") && $rs >= 200 && $rs < 300) {
        $var(reg_ttl) = $hdr(Expires);
        if ($var(reg_ttl) == "" || $var(reg_ttl) == $null) {
            $var(reg_ttl) = "3600";
        }
        # Expires: 0 in a 2xx reply means "you are NOT registered" (an
        # explicit deregistration confirmation), not a successful
        # binding -- never whitelist on that. Without this check, the
        # watcher's floor-clamp (min 300s) would still trust an IP that
        # just told us it holds no active registration for this trunk.
        if ($var(reg_ttl) != "0") {
            # trunk_ping_identity lookup moved ahead of the log line
            # (was previously a separate step after it) so trunk_name
            # is available to embed directly in the one RESOLVED-TRUNK
            # line the ipset-population watcher on the node actually
            # parses -- letting the watcher persist an ip->trunk_name
            # correlation alongside the ipset entry itself, rather than
            # the Manager re-resolving the FQDN separately (which could
            # disagree with what Kamailio's own DNS resolution actually
            # landed on at REGISTER time). $fU mirrors this REGISTER's
            # own From-header (built from uacreg's l_username, which is
            # contact_user -- the same value sync-routing.py keys into
            # trunk_ping_identity for exactly this lookup). Trunks
            # outside this scenario have no matching entry at all, so
            # $var(tpir_trunk_name) stays empty and the log line below
            # simply omits the trunk= field -- a no-op for them, same
            # as before.
            $var(tpir_trunk_name) = "";
            if ($fU != "") {
                sql_query("ca", "SELECT trunk_id, trunk_name, sip_profile_id, profile_id, media_profile_id "
                          "FROM trunk_ping_identity WHERE auth_user = '$(fU{s.escape.common})'", "tpir");
                if ($dbr(tpir=>rows) > 0) {
                    $var(tpir_value) = $dbr(tpir=>[0,0]) + "|" + $dbr(tpir=>[0,1]) + "|" + $dbr(tpir=>[0,2]) + "|"
                                     + $dbr(tpir=>[0,3]) + "|" + $dbr(tpir=>[0,4]);
                    $var(tpir_trunk_name) = $dbr(tpir=>[0,1]);
                    $sht(trunk_ip_identity=>$Ri:$Rp:$si) = $var(tpir_value);
                }
                sql_result_free("tpir");
            }
            xlog("L_INFO", "RESOLVED-TRUNK ip=$si expires=$var(reg_ttl) trunk=$var(tpir_trunk_name) via outbound REGISTER\n");
        }
    }
    # OPTIONS ping reply -- dispatcher's own keepalive, for trunks that
    # opted into DNS-based trust (trust_dns_resolved_ip + digest mode).
    # $fU carries this ping's own auth_user, set via the per-destination
    # ping_from override in the dispatcher attrs (confirmed via
    # dispatcher's own source: dest->attrs.ping_from) specifically so
    # this reply can be traced back to which trunk it belongs to,
    # rather than guessing at dispatcher's default From-header
    # construction. $si is the actual IP that answered -- same
    # authoritative "Kamailio already did the resolution to send this"
    # reasoning as the REGISTER case above. Event-driven, not a poll:
    # this fires naturally on every ping reply dispatcher already sends
    # on its own schedule (ds_ping_interval), no separate script needed.
    else if (is_method("OPTIONS") && $rs >= 200 && $rs < 300 && $fU != "") {
        sql_query("ca", "SELECT trunk_id, trunk_name, sip_profile_id, profile_id, media_profile_id "
                  "FROM trunk_ping_identity WHERE auth_user = '$(fU{s.escape.common})'", "tpi");
        if ($dbr(tpi=>rows) > 0) {
            $var(tpi_value) = $dbr(tpi=>[0,0]) + "|" + $dbr(tpi=>[0,1]) + "|" + $dbr(tpi=>[0,2]) + "|"
                             + $dbr(tpi=>[0,3]) + "|" + $dbr(tpi=>[0,4]);
            $var(tpi_trunk_name) = $dbr(tpi=>[0,1]);
            $sht(trunk_ip_identity=>$Ri:$Rp:$si) = $var(tpi_value);
            # No real Expires concept for an OPTIONS ping (unlike
            # REGISTER's own Expires header) -- 3600 is a fixed,
            # conservative literal, not read from anywhere. The
            # watcher's 5x multiplier turns this into an 18000s (5h)
            # ipset TTL either way, comfortably longer than any
            # realistic ds_ping_interval gap; a healthy trunk refreshes
            # this on every successful ping cycle regardless, so the
            # exact value here only matters for how long the entry
            # survives after the trunk actually stops responding.
            xlog("L_INFO", "RESOLVED-TRUNK ip=$si expires=3600 trunk=$var(tpi_trunk_name) via OPTIONS keepalive\n");
        }
        sql_result_free("tpi");
    }
}

# Topology hiding direction decision -- fires once per outgoing
# message. Compares $sndto against $dlg_var(topoh_caller_addr), set
# once in route[INVITE] right after dlg_manage() (both trunk- and
# subscriber-origin paths -- see that assignment's own comment for
# why caller-address-based, not callee-address-based). A message
# headed back toward the caller uses the caller/source side's
# "inbound" (traffic-originating-from-this-entity) preference;
# anything else -- toward the callee, OR toward any one of several
# parallel-forked callee contacts -- uses the callee/destination
# side's "outbound" (toward-this-entity) preference. Real bug found
# and fixed live this session: the original $sndto comparison used a
# direct $var() assignment from a double-quoted string
# ("$sndto(ip):$sndto(port)") -- confirmed via live testing that this
# assigns the LITERAL string, not the interpolated value (unlike
# xlog's format-string argument, which does interpolate) -- so this
# comparison was silently always false since the day it was written.
event_route[topoh:msg-outgoing] {
    $var(topoh_dest) = $sndto(ip) + ":" + $sndto(port);
    if ($var(topoh_dest) == $dlg_var(topoh_caller_addr)) {
        if ($dlg_var(topoh_mask_toward_caller) == "0") {
            drop;
        }
    } else {
        if ($dlg_var(topoh_mask_toward_callee) == "0") {
            drop;
        }
    }
}

failure_route[MANAGE_FAILURE] {
    $var(diag_is_canceled) = t_is_canceled();
    xlog("L_INFO", "DIAG_FAILURE_ROUTE: $ci status=$rs reason=[$rr] is_canceled=$var(diag_is_canceled) trunk_auth_retry_count=$dlg_var(trunk_auth_retry_count)\n");
    if ($var(diag_is_canceled)) {
        xlog("L_INFO", "DIAG_FAILURE_ROUTE: $ci t_is_canceled()=true, exiting early\n");
        exit;
    }

    if ($dlg_var(trunk_auth_retry_count) == $null) { $dlg_var(trunk_auth_retry_count) = "0"; }
    if (t_check_status("401|407") && $avp(active_trunk_setid) != $null
        && $dlg_var(trunk_auth_retry_count) < 2) {
        $var(trunk_auth_retry_count_next) = $(dlg_var(trunk_auth_retry_count){s.int}) + 1;
        $dlg_var(trunk_auth_retry_count) = $var(trunk_auth_retry_count_next);
        # active_trunk_setid is NOT trunk.id -- it's SETID_OFFSET(1000)
        # + trunk.id for an individual trunk (see sync-routing.py's
        # trunk_setid_by_id) -- so the real trunk.id has to be
        # recovered from the dispatcher row's own attrs string (its
        # duid= field) before credentials can be looked up correctly.
        # Real bug found and fixed this session: the previous query
        # here was `JOIN dispatcher d ON 1=1` -- a cartesian join that
        # never actually filtered credentials by which trunk was being
        # challenged at all, so with more than one auth-enabled trunk
        # it could send the wrong trunk's password to whichever trunk
        # issued the 401/407.
        $var(cred_trunk_id) = "";
        $var(rd_attrs) = $sht(dispatcher_attrs=>$avp(active_trunk_setid));
        if ($var(rd_attrs) != $null && $var(rd_attrs) =~ "duid=") {
            $var(cred_trunk_id) = $(var(rd_attrs){re.subst,/.*duid=([0-9]+).*/\1/}{s.int});
        }
        if ($var(cred_trunk_id) != "") {
            $var(rc_val) = $sht(trunk_credentials=>trunk-$var(cred_trunk_id));
            if ($var(rc_val) != $null && $var(rc_val) != "") {
                $avp(cred_user) = $(var(rc_val){s.select,0,|});
                $avp(cred_passwd) = $(var(rc_val){s.select,1,|});
                $var(rc_trust_provider_realm) = $(var(rc_val){s.select,3,|});
                if ($var(rc_trust_provider_realm) == "0") {
                    # Trust provider realm explicitly turned off for
                    # this trunk -- admin wants strict validation, so
                    # require an exact match against our configured
                    # value instead. Confirmed via direct testing: this
                    # correctly makes uac_auth() fail when the
                    # provider's challenge doesn't match, which is the
                    # intended behavior here.
                    $avp(cred_realm) = $(var(rc_val){s.select,2,|});
                }
                # Else (default, trust_provider_realm=1): cred_realm
                # deliberately left unset -- a real, confirmed
                # production bug, fixed this session: pre-setting it
                # from our own configured value requires an exact
                # match against whatever realm string the provider's
                # challenge actually contains, and providers commonly
                # send something unrelated to what we have configured.
                # Confirmed via direct testing against the real uac
                # module: leaving this unset lets uac_auth() correctly
                # trust and use whatever realm the challenge itself
                # specifies, no pre-configured match required.
                if ($dlg_var(relay_du) != $null && $dlg_var(relay_du) != "") {
                    $du = $dlg_var(relay_du);
                }
                uac_auth();
                # Re-arm for this retry's own t_relay() -- without this,
                # a trunk that challenges a second time (stale=true
                # nonce rotation is a normal, common provider pattern,
                # confirmed live from this specific provider sending
                # two rapid, consecutive stale challenges) has no armed
                # failure_route left to catch it, and the second 407/
                # 401 falls all the way through to the ORIGINAL caller
                # instead of being absorbed here. The dlg_var gate above
                # caps this at 2 retries (3 total attempts) per dialog,
                # so re-arming here can never itself become a loop.
                t_on_failure("MANAGE_FAILURE");
                t_relay();
                exit;
            }
        }
    }

    # Genuine failure from here down (the 401/407 auth retry above
    # exits on success) -- release any anchored media now rather than
    # relying solely on rtpengine's own internal timeout to eventually
    # reclaim it. MUST stay after the auth-retry block: a 407 from a
    # digest-auth trunk is a normal, expected step of every single
    # call to it, and the retry re-sends the same transaction with the
    # same already-rewritten SDP -- the rtpengine session has to
    # survive it, and the eventual 200 OK's rtpengine_answer() is
    # gated on media_anchored staying "1". Running this teardown
    # before that retry (as it originally did) destroyed the session
    # and wiped the flag on every digest-trunk call: confirmed via a
    # real CDR contradiction (re_flags populated proves offer
    # succeeded; media_anchored=0 proves something reset it) plus a
    # packet capture showing the 200 OK's answer SDP relayed to the
    # caller with the provider's own c= line unmodified -- a genuine
    # media-path defect, not just wrong reporting. For the 5xx/408
    # failover branches below, teardown-then-fresh-offer is correct:
    # they re-call APPLY_MEDIA_PROFILE for the new destination.
    if ($dlg_var(media_anchored) == "1") {
        rtpengine_delete();
        $dlg_var(media_anchored) = "0";
    }

    # Call forwarding: busy/no-answer -- scoped to subscriber-
    # destined calls only ($dlg_var(outbound_subscriber) is only set
    # when routing to a subscriber, never for trunk-sourced calls),
    # checked before the trunk-oriented 5xx/408 branch below so a
    # subscriber's own no-answer timeout isn't caught by that
    # unrelated dispatcher-failover logic first. Domain gate already
    # confirmed on (no_answer_forward_active was only set if so) for
    # the no-answer case; busy still needs its own gate check since
    # it doesn't depend on the ring-timeout setup at all.
    if ($dlg_var(outbound_subscriber) != $null) {
        $var(fwd_subscriber_user) = $(dlg_var(outbound_subscriber){s.select,0,@});
        $var(fwd_subscriber_domain) = $(dlg_var(outbound_subscriber){s.select,1,@});
        $var(fwd_type) = "";
        $var(sfm_key) = $var(fwd_subscriber_user) + "@" + $var(fwd_subscriber_domain);
        $var(sfm_val) = $sht(subscriber_forwarding_meta=>$var(sfm_key));

        if (t_check_status("486|600")) {
            $var(fwd_gate) = 0;
            if ($var(sfm_val) != $null && $var(sfm_val) != "") {
                $var(fwd_gate) = $(var(sfm_val){s.select,12,|});
            }
            if ($var(fwd_gate) == 1) { $var(fwd_type) = "busy"; }
        } else if (t_check_status("408") && $dlg_var(no_answer_forward_active) == "1") {
            $var(fwd_type) = "no_answer";
        }

        if ($var(fwd_type) != "" && $var(sfm_val) != $null && $var(sfm_val) != "") {
            # Consolidated htable lookup (item 15 optimization) --
            # busy uses fields 13-17, no_answer uses fields 18-22
            # (no_answer has no separate domain-level gate of its own,
            # per the original design -- its own ring-timeout setup
            # already gates whether this branch is even reached).
            # Explicit if/else with literal indices per type, not a
            # dynamic {s.select,$var(x),|} expression.
            $var(bsf_enabled) = "0";
            if ($var(fwd_type) == "busy") {
                $var(bsf_enabled) = $(var(sfm_val){s.select,13,|});
                $var(fwd_target_user) = $(var(sfm_val){s.select,14,|});
                $var(fwd_target_domain) = $(var(sfm_val){s.select,15,|});
                $var(fwd_target_ext) = $(var(sfm_val){s.select,16,|});
                $var(fwd_mode) = $(var(sfm_val){s.select,17,|});
            } else {
                $var(bsf_enabled) = $(var(sfm_val){s.select,18,|});
                $var(fwd_target_user) = $(var(sfm_val){s.select,19,|});
                $var(fwd_target_domain) = $(var(sfm_val){s.select,20,|});
                $var(fwd_target_ext) = $(var(sfm_val){s.select,21,|});
                $var(fwd_mode) = $(var(sfm_val){s.select,22,|});
            }
            if ($var(bsf_enabled) == 1) {
                if ($var(fwd_target_ext) != "" && $var(fwd_target_ext) != "$null") {
                    $var(fwd_uri) = "sip:" + $var(fwd_target_ext) + "@" + $var(fwd_subscriber_domain);
                } else {
                    $var(fwd_uri) = "sip:" + $var(fwd_target_user) + "@" + $var(fwd_target_domain);
                }

                if ($var(fwd_mode) == "redirect") {
                    append_to_reply("Contact: <" + $var(fwd_uri) + ">\r\n");
                    $var(rr_key) = "302_call_forwarded"; $var(rr_default) = "Moved Temporarily"; route(RESP_REASON);
                    t_reply("302", "$var(rr_effective)");
                } else {
                    # Diversion header (RFC 5806) -- identifies who this
                    # call was diverted from and why, for the benefit of
                    # whatever answers it (voicemail systems, call
                    # centers, and some carriers use this for routing/
                    # display purposes). reason values are RFC 5806's
                    # own exact tokens, confirmed against the RFC's
                    # grammar directly -- NOT the same strings as this
                    # platform's own internal fwd_type ("busy"/
                    # "no_answer"), so mapped explicitly rather than
                    # passed through as-is.
                    $var(diversion_reason) = "unknown";
                    if ($var(fwd_type) == "busy") { $var(diversion_reason) = "user-busy"; }
                    else if ($var(fwd_type) == "no_answer") { $var(diversion_reason) = "no-answer"; }
                    if ($(var(sfm_val){s.select,23,|}) == 1) {
                        append_hf("Diversion: <sip:$var(fwd_subscriber_user)@$var(fwd_subscriber_domain)>;reason=$var(diversion_reason);counter=1\r\n");
                    }

                    $ru = $var(fwd_uri);
                    append_branch();
                    t_relay();
                }
                exit;
            }
        }
    }

    # Trunk resilience -- some carriers use 3xx for failover/maintenance
    # signaling. get_redirects() extracts the contacts from the 3xx
    # response and appends them as new branches, but does NOT forward
    # them itself -- t_relay() here is required, confirmed via this
    # module's own real usage examples (a bare get_redirects() with no
    # following t_relay() is a documented no-op).
    if (t_check_status("3[0-9][0-9]")) {
        if (get_redirects("2:1")) {
            t_relay();
            exit;
        }
    }

    # LCR live failover -- the actual reason to use the real lcr
    # module over the existing sync-time cheapest-pick mechanism
    # (lcr_group): next_gw() tries the next gateway in cost order,
    # live, per failed call -- not resolved once at sync time.
    # Checked before the dispatcher-oriented branch below since this
    # path never went through dispatcher at all.
    if (t_check_status("5[0-9][0-9]|408") && $dlg_var(lcr_active) == "1") {
        if (next_gw()) {
            # Same gap, same fix as the dispatcher-failover branch
            # below: without this, LCR failing over to the next
            # gateway in cost order silently kept the FIRST (now-
            # failed) gateway's media profile. lcr_gw itself carries
            # no media_profile column -- next_gw() sets $avp(lcr_gwtag)
            # to the selected gateway's own tag, which sync-routing.py
            # sets to the trunk's name (matching dispatcher.description,
            # also the trunk's name) -- reaches the same attrs string
            # the dispatcher case reads, just matched by name instead
            # of destination URI since that's what's available here.
            $var(outbound_media_profile_id) = 0;
            sql_query("ca", "SELECT attrs FROM dispatcher WHERE description = '$(avp(lcr_gwtag){s.escape.common})' LIMIT 1", "fmpl");
            if ($dbr(fmpl=>rows) > 0) {
                $var(fmpl_attrs) = $dbr(fmpl=>[0,0]);
                if ($var(fmpl_attrs) =~ "media_profile=") {
                    $var(outbound_media_profile_id) = $(var(fmpl_attrs){re.subst,/.*media_profile=([0-9]+).*/\1/}{s.int});
                }
            }
            sql_result_free("fmpl");
            route(APPLY_MEDIA_PROFILE);
            t_on_failure("MANAGE_FAILURE");
            route(RELAY);
            exit;
        }
    }

    if (t_check_status("5[0-9][0-9]|408")) {
        if (ds_next_dst()) {
            # Real gap found and fixed this session: without this,
            # a dispatcher failover to a different trunk in the same
            # set silently kept whatever media profile was resolved
            # for the FIRST (now-failed) trunk -- media_profile_id is
            # a per-trunk field, so a genuinely different trunk here
            # could need different codecs/mode entirely. $du is the
            # exact destination URI ds_next_dst() just selected --
            # matched directly against dispatcher's own destination
            # column, robust regardless of whether active_trunk_setid
            # itself tracks the failover target (unlike the existing
            # 401/407 retry pattern above, which relies on the
            # destination not having changed at all).
            $var(outbound_media_profile_id) = 0;
            sql_query("ca", "SELECT attrs FROM dispatcher WHERE destination = '$(du{s.escape.common})' LIMIT 1", "fmp");
            if ($dbr(fmp=>rows) > 0) {
                $var(fmp_attrs) = $dbr(fmp=>[0,0]);
                if ($var(fmp_attrs) =~ "media_profile=") {
                    $var(outbound_media_profile_id) = $(var(fmp_attrs){re.subst,/.*media_profile=([0-9]+).*/\1/}{s.int});
                }
            }
            sql_result_free("fmp");
            route(APPLY_MEDIA_PROFILE);
            t_on_failure("MANAGE_FAILURE");
            route(RELAY);
            exit;
        }
    }
}

event_route[xhttp:request] {
    xhttp_reply("200", "OK", "text/plain", "Kamailio xhttp stub\n");
}
